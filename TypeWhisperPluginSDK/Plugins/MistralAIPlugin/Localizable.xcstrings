    "Marks who is speaking, for recordings with several people. Transcripts then start each speaker's part with a label.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kennzeichnet, wer spricht, für Aufnahmen mit mehreren Personen. Transkripte beginnen dann jeden Abschnitt mit dem Namen des Sprechers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica quién habla, para grabaciones con varias personas. Las transcripciones empiezan entonces cada intervención con una etiqueta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数人の録音で、誰が話しているかを示します。文字起こしでは各話者の部分の先頭にラベルが付きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记谁在说话，适用于多人录音。转录稿会在每位说话人的内容前加上标签。"
          }
        }
      }
    },
    "Medium": {
      "localizations": {
