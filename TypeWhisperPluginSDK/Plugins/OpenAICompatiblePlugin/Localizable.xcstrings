    "Choose Ollama to discover installed models through the server's native /api/tags endpoint. Generic servers only use the OpenAI-compatible /v1/models endpoint.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Ollama, um installierte Modelle über den nativen /api/tags-Endpunkt des Servers zu finden. Allgemeine Server nutzen nur den OpenAI-kompatiblen /v1/models-Endpunkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Ollama para descubrir los modelos instalados mediante el endpoint nativo /api/tags del servidor. Los servidores genéricos solo usan el endpoint /v1/models compatible con OpenAI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollamaを選ぶと、サーバー固有の/api/tagsエンドポイントからインストール済みのモデルを取得します。汎用サーバーでは、OpenAI互換の/v1/modelsエンドポイントのみを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Ollama to discover installed models through the server's native /api/tags endpoint. Generic servers only use the OpenAI-compatible /v1/models endpoint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Ollama 可通过服务器原生的 /api/tags 接口发现已安装的模型。通用服务器仅使用 OpenAI 兼容的 /v1/models 接口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Ollama 可透過伺服器原生的 /api/tags 介面發現已安裝的模型。通用伺服器僅使用 OpenAI 相容的 /v1/models 介面。"
          }
        }
      }
    },
    "The server URL is invalid.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL del servidor no es válida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
