          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Hugging Face 令牌"
          }
        }
      }
    },
    "Save Hugging Face token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging-Face-Token speichern"
          }
        },
        "es": {
