    "premium.window.access.deleteConfirmationMessage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden das Konto und die verknüpfte Berechtigung entfernt. Lokale Einträge und private Cloud-Dateien werden nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes the account and entitlement link. Local entries and private cloud files are not deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina la cuenta y el vínculo con el acceso. Las entradas locales y los archivos privados en la nube no se eliminan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントとアクセス権のリンクが削除されます。ローカル項目とプライベートクラウドファイルは削除されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会移除账户及其权益关联。本地条目和专用云端文件不会被删除。"
          }
        }
      }
    },
