    "llama.cpp %@ (%@) is downloaded from GitHub with the first model and runs as a local server that only this Mac can reach.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "llama.cpp %1$@ (%2$@) wird mit dem ersten Modell von GitHub geladen und läuft als lokaler Server, den nur dieser Mac erreicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "llama.cpp %1$@ (%2$@) se descarga de GitHub con el primer modelo y se ejecuta como un servidor local al que solo puede acceder este Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "llama.cpp %1$@（%2$@）は最初のモデルと一緒にGitHubからダウンロードされ、このMacからのみアクセスできるローカルサーバーとして動作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "llama.cpp %1$@（%2$@）会随第一个模型从 GitHub 下载，并作为只有此 Mac 能访问的本地服务器运行。"
          }
        }
      }
    },
