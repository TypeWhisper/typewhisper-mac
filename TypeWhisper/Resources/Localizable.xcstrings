    },
    "Stopping in %@. Keep talking to continue." : {
      "comment" : "Indicator countdown before a toggle dictation stops after silence. %@ is a localized duration such as “2 seconds”.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt in %@. Sprich weiter, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene en %@. Sigue hablando para continuar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@後に停止します。続けるには話し続けてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@后停止。继续说话即可继续录音。"
          }
        }
      }
    },
    "No sound from the microphone. Is it muted?" : {
      "comment" : "Indicator warning while a dictation records only digital silence, e.g. from a muted or dead microphone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Ton vom Mikrofon. Ist es stummgeschaltet?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No llega sonido del micrófono. ¿Está silenciado?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクから音が届いていません。ミュートになっていませんか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风没有声音。是否已静音？"
          }
        }
      }
    },
    "Not available in this edition because TypeWhisper cannot keep Enter from reaching the app. Dictations are inserted without pressing Enter." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No disponible en esta edición porque TypeWhisper no puede evitar que Intro llegue a la app. Los dictados se insertan sin presionar Intro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper が Enter キーをアプリに届かないようにできないため、このエディションでは利用できません。ディクテーションは Enter キーを押さずに挿入されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本不可用，因为 TypeWhisper 无法阻止 Enter 键传递到应用。听写内容会直接插入，不会按下 Enter 键。"
          }
        }
      }
    },
    "Recording stopped, transcribing" : {
