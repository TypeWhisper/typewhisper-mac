        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选工作流已不存在。"
          }
        }
      }
    },
    "The Sign in with Apple response could not be verified." : {
      "comment" : "Error message when the Apple Sign In response could not be verified.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
