{
  "language": "en",
  "rules": [
    { "phrase": "question mark", "replacement": "?", "category": "punctuation" },
    { "phrase": "exclamation mark", "replacement": "!", "category": "punctuation" },
    { "phrase": "exclamation point", "replacement": "!", "category": "punctuation" },
    { "phrase": "colon", "replacement": ":", "category": "punctuation" },
    { "phrase": "semicolon", "replacement": ";", "category": "punctuation" },
    { "phrase": "open parenthesis", "replacement": "(", "category": "brackets" },
    { "phrase": "close parenthesis", "replacement": ")", "category": "brackets" },
    { "phrase": "open bracket", "replacement": "(", "category": "brackets" },
    { "phrase": "close bracket", "replacement": ")", "category": "brackets" },
    { "phrase": "open square bracket", "replacement": "[", "category": "brackets" },
    { "phrase": "close square bracket", "replacement": "]", "category": "brackets" },
    { "phrase": "open quote", "replacement": "\"", "category": "quotes", "spacing": "opening" },
    { "phrase": "open quotes", "replacement": "\"", "category": "quotes", "spacing": "opening" },
    { "phrase": "close quote", "replacement": "\"", "category": "quotes", "spacing": "closing" },
    { "phrase": "close quotes", "replacement": "\"", "category": "quotes", "spacing": "closing" },
    { "phrase": "end quote", "replacement": "\"", "category": "quotes", "spacing": "closing" },
    { "phrase": "hashtag", "replacement": "#", "category": "structural", "spacing": "opening" },
    { "phrase": "hash sign", "replacement": "#", "category": "structural", "spacing": "opening" },
    { "phrase": "number sign", "replacement": "#", "category": "structural", "spacing": "opening" },
    { "phrase": "comma", "replacement": ",", "category": "punctuation" },
    { "phrase": "period", "replacement": ".", "category": "punctuation" },
    { "phrase": "full stop", "replacement": ".", "category": "punctuation" }
  ],
  "verificationScenarios": [
    { "spoken": "hello comma world", "expected": "hello, world" },
    { "spoken": "how are you question mark", "expected": "how are you?" },
    { "spoken": "hello open parenthesis test close parenthesis", "expected": "hello (test)" },
    { "spoken": "warning exclamation mark", "expected": "warning!" },
    { "spoken": "warning exclamation point", "expected": "warning!" },
    { "spoken": "see open square bracket note close square bracket", "expected": "see [note]" },
    { "spoken": "she said open quote hello close quote period", "expected": "she said \"hello\"." },
    { "spoken": "follow hashtag typewhisper", "expected": "follow #typewhisper" },
    { "spoken": "title colon example", "expected": "title: example" }
  ]
}
