    "This model architecture is not supported by this plugin. Open the settings of a compatible plugin to import it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Modellarchitektur wird von diesem Plugin nicht unterstützt. Öffne zum Importieren die Einstellungen eines kompatiblen Plugins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin no admite esta arquitectura de modelo. Abre los ajustes de un plugin compatible para importarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインはこのモデルアーキテクチャに対応していません。対応するプラグインの設定を開いてインポートしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此插件不支持该模型架构。请打开兼容插件的设置进行导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此外掛不支援該模型架構。請開啟相容外掛的設定進行匯入。"
          }
        }
      }
    },
