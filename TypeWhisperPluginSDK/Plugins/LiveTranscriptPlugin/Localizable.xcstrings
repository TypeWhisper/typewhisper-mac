            "value": "幅"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽度"
          }
        }
      }
    },
    "Window size": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño de la ventana"
          }
        },
        "ja": {
