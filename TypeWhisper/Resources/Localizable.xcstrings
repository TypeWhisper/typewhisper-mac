            "value" : "El término %lld está vacío o no es texto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用語%lldが空か、テキストではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %lld 个词条为空或不是文本。"
          }
        }
      }
    },
    "The term “%@” appears more than once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Begriff „%@“ kommt mehrfach vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El término “%@” aparece más de una vez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用語「%@」が複数回含まれています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "词条“%@”出现了多次。"
          }
        }
      }
    },
    "Correction %lld needs an original and a replacement text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korrektur %lld braucht einen Original- und einen Ersatztext."
