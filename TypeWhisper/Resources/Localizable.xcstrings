      }
    },
    "Example: EN <-> DE translation with formatting preserved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: フォーマットを保持した英語⇔ドイツ語翻訳"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: EN <-> DE 翻译 带 格式化 已保留."
          }
        }
      }
    },
    "Example: extract JSON payloads or action items from meeting notes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: 議事録からJSONペイロードやアクションアイテムを抽出する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: 提取 JSON payloads 或 操作 项目 从 会议 笔记."
          }
        }
      }
    },
    "Example: make rough notes sound concise and clear.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: 大まかなメモを簡潔で明確な文章にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: 制作 粗糙 笔记 声音 concise 与 清除."
          }
        }
      }
    },
    "Example: summarize bugs for Slack in a strict bullet format.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: Slack用にバグを厳密な箇条書き形式で要約する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: summarize bugs 为 Slack 在 a 严格 项目符号 格式."
          }
        }
      }
    },
    "Example: turn raw notes into meeting notes or a table.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: 未整理のメモを議事録や表に変換する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: 转 raw 笔记 到 会议 笔记 或 a 表格."
          }
        }
      }
    },
    "Example: write a friendly short reply to an incoming message.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: 受信したメッセージに対する親しみやすい短い返信を作成する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: 写入 a 友好 短 回复 到 an incoming 消息."
          }
        }
      }
    },
    "Examples: Slack -> English with Auto Enter, github.com -> code prompt, Mail -> German with translation.": {
      "localizations": {
        "ja": {
