    },
    "Add a term in Dictionary to enable Vocabulary Boosting for Parakeet. Term packs now use precise matching to keep everyday words intact." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge im Wörterbuch einen Begriff hinzu, um Vocabulary Boosting für Parakeet zu aktivieren. Begriffspakete nutzen jetzt präzise Zuordnung, damit alltägliche Wörter unverändert bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega un término en Diccionario para activar Vocabulary Boosting en Parakeet. Los paquetes de términos ahora usan coincidencias precisas para no alterar las palabras cotidianas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辞書に用語を追加すると、ParakeetのVocabulary Boostingを有効にできます。用語パックは精密な照合を使い、一般的な単語の誤変換を防ぎます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在词典中添加词条，即可为 Parakeet 启用 Vocabulary Boosting。术语包现采用精确匹配，避免误改日常用词。"
          }
        }
      }
    },
    "More control over meeting recordings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Kontrolle über Meeting-Aufnahmen"
