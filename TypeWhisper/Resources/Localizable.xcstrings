          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interfaz de automatización avanzada para herramientas locales. Desactivada de forma predeterminada y vinculada solo a 127.0.0.1."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルツール向けの高度な自動化インターフェースです。初期状態では無効で、127.0.0.1 のみにバインドされます。"
