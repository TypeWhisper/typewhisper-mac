      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging-Face-Token"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face 令牌"
          }
        }
      }
    },
    "Invalid Hugging Face Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger Hugging-Face-Token"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效的 Hugging Face 令牌"
          }
        }
      }
    },
    "Load": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载"
          }
        }
      }
    },
    "LOCAL · BATCH": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LOKAL · BATCH"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 · 批量"
          }
        }
      }
    },
    "No automatic language detection, streaming, timestamps, diarization, translation, or dictionary boosting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine automatische Spracherkennung, kein Streaming, keine Zeitstempel, Diarisierung, Übersetzung oder Wörterbuchverstärkung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持自动语言检测、流式传输、时间戳、说话人分离、翻译或词典增强。"
          }
        }
      }
    },
    "Model weights are downloaded from a pinned Apache-2.0 GGUF revision. CrispASR and the VAD model are MIT-licensed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modellgewichte werden aus einer festgeschriebenen Apache-2.0-GGUF-Revision geladen. CrispASR und das VAD-Modell stehen unter der MIT-Lizenz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型权重从固定的 Apache-2.0 GGUF 版本下载。CrispASR 和 VAD 模型采用 MIT 许可。"
          }
        }
      }
    },
    "Not Downloaded": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht heruntergeladen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未下载"
          }
        }
      }
    },
    "Optional. Increases download rate limits and may speed up the model download. The token is stored securely in Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Erhöht die Download-Limits und kann den Modelldownload beschleunigen. Der Token wird sicher im Schlüsselbund gespeichert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。提高下载速率限制并可能加速模型下载。令牌安全存储在钥匙串中。"
          }
        }
      }
    },
    "Preparing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird vorbereitet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备中"
          }
        }
      }
    },
    "Starting CrispASR with Metal and warming up the model. Dictation is ready when this finishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CrispASR wird mit Metal gestartet und das Modell wird aufgewärmt. Nach Abschluss ist die Diktierfunktion bereit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用 Metal 启动 CrispASR 并预热模型。完成后即可开始听写。"
          }
        }
      }
    },
    "Ready": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就绪"
          }
        }
      }
    },
    "Running Cohere locally with Metal…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cohere läuft lokal mit Metal …"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在本地使用 Metal 运行 Cohere..."
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "Remove downloaded model?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladenes Modell entfernen?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除已下载的模型？"
          }
        }
      }
    },
    "Remove Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell entfernen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除模型"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "The model stays resident while loaded. Metal is warmed up before the provider becomes ready, keeping the first transcription responsive.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell bleibt geladen im Arbeitsspeicher. Metal wird aufgewärmt, bevor der Provider bereit ist, damit die erste Transkription schnell reagiert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型加载后将常驻内存。Metal 在提供程序就绪前完成预热，确保首次转录响应迅速。"
          }
        }
      }
    },
    "Unload": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entladen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载"
          }
        }
      }
    },
    "Valid Hugging Face Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gültiger Hugging-Face-Token"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效的 Hugging Face 令牌"
          }
        }
      }
    },
    "Validating token…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token wird geprüft …"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证令牌..."
          }
        }
      }
    },
    "VAD model license": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VAD-Modelllizenz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VAD 模型许可"
          }
        }
      }
    },
    "Voice activity detection runs before every transcription to suppress silence and low-noise hallucinations.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor jeder Transkription läuft eine Sprachaktivitätserkennung, um Halluzinationen bei Stille und leisem Rauschen zu unterdrücken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次转录前运行语音活动检测，以抑制静音和低噪声幻听。"
          }
        }
      }
    },
