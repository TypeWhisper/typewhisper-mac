    "Reset Defaults" : {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardwerte wiederherstellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer valores predeterminados"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复默认设置"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期設定に戻す"
          }
        }
      }
    },
    "One word per line. Commas and semicolons are also accepted." : {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wort pro Zeile. Kommas und Semikolons werden ebenfalls akzeptiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palabra por línea. También se aceptan comas y puntos y comas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个词，也可使用逗号或分号分隔。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1行に1語ずつ入力してください。カンマやセミコロンでも区切れます。"
          }
        }
      }
    },
    "“um”, “ah” and “eh” are only removed from English text because they are real words in other languages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„um“, „ah“ und „eh“ werden nur aus englischem Text entfernt, weil sie in anderen Sprachen echte Wörter sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“um”, “ah” y “eh” solo se eliminan del texto en inglés porque son palabras reales en otros idiomas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「um」「ah」「eh」は他の言語では普通の単語なので、英語のテキストからのみ削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“um”、“ah” 和 “eh” 只会从英文文本中删除，因为它们在其他语言中是真实的词。"
          }
        }
      }
    },
    "Collapse stuttered words" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestotterte Wörter zusammenfassen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unir palabras tartamudeadas"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どもりで繰り返された単語をまとめる"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合并口吃重复的词"
          }
        }
      }
    },
    "Shortens a word repeated three or more times in a row, like “I I I”, to a single word." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kürzt ein Wort, das drei- oder mehrmals hintereinander vorkommt, etwa „ich ich ich“, auf ein einzelnes Wort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce a una sola palabra una palabra repetida tres o más veces seguidas, como “yo yo yo”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「I I I」のように3回以上続けて繰り返された単語を1つにまとめます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将连续重复三次或以上的词（例如 “I I I”）缩减为一个。"
          }
        }
      }
    },
