    "Validating token...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token wird geprüft..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Validando el token..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンの検証中..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证令牌..."
          }
        }
      }
    },
    "Local speech-to-text by Salesforce, powered by MLX on Apple Silicon. Transcribes English, German, French, Spanish, Italian, Portuguese and Dutch with punctuation. Needs a Mac with 32 GB of memory or more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Spracherkennung von Salesforce mit MLX auf Apple Silicon. Erkennt Englisch, Deutsch, Französisch, Spanisch, Italienisch, Portugiesisch und Niederländisch mit Satzzeichen. Benötigt einen Mac mit mindestens 32 GB Arbeitsspeicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voz a texto local de Salesforce, con MLX en Apple Silicon. Transcribe inglés, alemán, francés, español, italiano, portugués y neerlandés con puntuación. Requiere un Mac con 32 GB de memoria o más."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon上のMLXで動作するSalesforceのローカル音声認識です。英語、ドイツ語、フランス語、スペイン語、イタリア語、ポルトガル語、オランダ語を句読点付きで書き起こします。32 GB以上のメモリを搭載したMacが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Salesforce 提供的本地语音转文字，在 Apple Silicon 上通过 MLX 运行。可转写英语、德语、法语、西班牙语、意大利语、葡萄牙语和荷兰语，并带标点。需要内存为 32 GB 或以上的 Mac。"
          }
        }
      }
    },
    "Uses about 16 GB of memory while transcribing. Supports dictionary terms, no translation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegt beim Transkribieren etwa 16 GB Arbeitsspeicher. Unterstützt Wörterbuchbegriffe, keine Übersetzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa unos 16 GB de memoria al transcribir. Admite términos del diccionario, sin traducción."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き起こし中は約16 GBのメモリを使用します。辞書の用語に対応し、翻訳には対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写时约占用 16 GB 内存。支持词典术语，不支持翻译。"
          }
        }
      }
    },
    "This Mac has %lld GB of memory. SOV-Transcribe needs %lld GB or more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat %1$lld GB Arbeitsspeicher. SOV-Transcribe benötigt mindestens %2$lld GB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac tiene %1$lld GB de memoria. SOV-Transcribe necesita %2$lld GB o más."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのメモリは%1$lld GBです。SOV-Transcribeには%2$lld GB以上が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的内存为 %1$lld GB。SOV-Transcribe 需要 %2$lld GB 或以上。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
