require "digest"

# Mac App Store edition screenshots.
#
# Captures the App Store edition (APPSTORE build of TypeWhisperAppStore.xcodeproj)
# in screenshot mode, using the deterministic fixtures and window handling of
# the regular screenshot lane. Raw window captures are written to
# fastlane/screenshots/appstore/<language>/<state>.png. TypeWhisper Studio renders
# them into the store images in fastlane/screenshots/appstore/store/<language>/.

APPSTORE_SCREENSHOT_DERIVED_DATA = File.join(REPOSITORY_ROOT, "build", "appstore-screenshots")
APPSTORE_SCREENSHOT_PRODUCT = "TypeWhisper App Store Dev"
APPSTORE_SCREENSHOT_APP_PATH = File.join(
  APPSTORE_SCREENSHOT_DERIVED_DATA, "Build", "Products", "Debug", "#{APPSTORE_SCREENSHOT_PRODUCT}.app"
)
APPSTORE_SCREENSHOT_BUNDLE_ID = "com.typewhisper.typewhisper-app.screenshots"
APPSTORE_SCREENSHOT_OUTPUT = File.join(SCREENSHOT_OUTPUT, "appstore")
# Settings states that exist in the App Store edition. The license page is
# replaced by the Premium page there.
APPSTORE_SCREENSHOT_STATES = %w[
  home
  indicator
  recording
  workflows
  dictionary
  history
  statistics
  integrations-available
  hotkeys
  snippets
  file-transcription
  premium
].freeze

# Store screenshots in listing order (App Store Connect allows ten). home repeats
# the indicator background, recording shows Apple Speech as not ready, premium
# has no StoreKit prices in screenshot mode and hotkeys has no shortcuts, so
# they are left out. The app is not localized into French, Italian and Spanish;
# those store locales show the en-US screenshots.
APPSTORE_STORE_SCREENSHOT_STATES = %w[
  indicator
  history
  file-transcription
  workflows
  dictionary
  snippets
  integrations-available
  statistics
].freeze
APPSTORE_STORE_SCREENSHOT_LOCALES = %w[en-US de-DE].freeze
APPSTORE_COMPOSED_SCREENSHOT_OUTPUT = File.join(APPSTORE_SCREENSHOT_OUTPUT, "store")

def appstore_screenshot_states(value)
  requested = value.to_s.split(",").map(&:strip).reject(&:empty?)
  return APPSTORE_SCREENSHOT_STATES if requested.empty?

  unsupported = requested - APPSTORE_SCREENSHOT_STATES
  UI.user_error!("Unsupported App Store screenshot states: #{unsupported.join(', ')}") unless unsupported.empty?
  requested
end

def build_appstore_screenshot_app!
  sh(Shellwords.escape(File.join(REPOSITORY_ROOT, "scripts", "appstore", "generate_project.sh")))
  sh(Shellwords.join([
    "xcodebuild",
    "-project", File.join(REPOSITORY_ROOT, "TypeWhisperAppStore.xcodeproj"),
    "-scheme", "TypeWhisperAppStore",
    "-configuration", "Debug",
    "-derivedDataPath", APPSTORE_SCREENSHOT_DERIVED_DATA,
    "-destination", "platform=macOS,arch=#{screenshot_hardware_architecture}",
    "-skipPackagePluginValidation",
    "-skipMacroValidation",
    "CODE_SIGN_IDENTITY=-",
    "CODE_SIGN_STYLE=Manual",
    "CODE_SIGNING_REQUIRED=YES",
    "CODE_SIGNING_ALLOWED=YES",
    "CODE_SIGN_ENTITLEMENTS=",
    # Screenshot runs write a readiness marker into a temporary folder.
    "ENABLE_APP_SANDBOX=NO",
    "PROVISIONING_PROFILE_SPECIFIER=",
    "COMPILER_INDEX_STORE_ENABLE=NO",
    "build",
  ]))

  UI.user_error!("Missing screenshot app: #{APPSTORE_SCREENSHOT_APP_PATH}") unless File.directory?(APPSTORE_SCREENSHOT_APP_PATH)
  info_plist = File.join(APPSTORE_SCREENSHOT_APP_PATH, "Contents", "Info.plist")
  sh(
    "/usr/libexec/PlistBuddy -c #{Shellwords.escape("Set :CFBundleIdentifier #{APPSTORE_SCREENSHOT_BUNDLE_ID}")} #{Shellwords.escape(info_plist)}",
    log: false
  )
  sh(
    "/usr/bin/codesign --force --sign - --preserve-metadata=entitlements,requirements,flags #{Shellwords.escape(APPSTORE_SCREENSHOT_APP_PATH)}",
    log: false
  )
end

def reset_appstore_screenshot_defaults!
  system("/usr/bin/defaults", "delete", APPSTORE_SCREENSHOT_BUNDLE_ID, out: File::NULL, err: File::NULL)
end

def capture_appstore_screenshot!(language, state, destination)
  executable = File.join(APPSTORE_SCREENSHOT_APP_PATH, "Contents", "MacOS", APPSTORE_SCREENSHOT_PRODUCT)
  reset_appstore_screenshot_defaults!

  Dir.mktmpdir("typewhisper-appstore-screenshot") do |run_directory|
    ready_file = File.join(run_directory, "window-ready.txt")
    log_file = File.join(run_directory, "application.log")
    home_directory = File.join(run_directory, "home")
    FileUtils.mkdir_p(home_directory)

    environment = {
      "CFFIXED_USER_HOME" => home_directory,
      "NSUnbufferedIO" => "YES",
    }
    log = File.open(log_file, "w")
    process_id = Process.spawn(
      environment,
      executable,
      *screenshot_launch_arguments(language, state, "free", ready_file),
      chdir: REPOSITORY_ROOT,
      out: log,
      err: log
    )
    log.close

    begin
      window_id = wait_for_screenshot_window!(ready_file, process_id, log_file)
      # -o leaves out the window shadow; the store stills draw their own.
      sh("/usr/sbin/screencapture -x -o -l #{window_id} #{Shellwords.escape(destination)}", log: false)
      unless File.file?(destination) && File.size(destination) > 100_000
        UI.user_error!("Screenshot capture did not produce a valid PNG: #{destination}")
      end
    ensure
      stop_screenshot_app(process_id)
      reset_appstore_screenshot_defaults!
      FileUtils.rm_rf(File.join(Dir.tmpdir, "TypeWhisper-Screenshots-#{process_id}"))
    end
  end
end

# Localized store text of the macOS version. Name, subtitle and privacy URL are
# app-level fields shared with the iOS app and stay in the iOS repository.
# release_notes.txt is required for updates and must not exist for the first
# macOS version, which has no "What's New" text.
APPSTORE_APP_IDENTIFIER = "com.typewhisper.typewhisper-app"
APPSTORE_APP_ID = "6759319267"
APPSTORE_METADATA_PATH = File.join(FASTLANE_DIRECTORY, "appstore-metadata")
APPSTORE_STORE_LOCALES = %w[en-US de-DE fr-FR it es-ES].freeze
APPSTORE_INITIAL_MAC_VERSION = "1.8.0"
APPSTORE_VERSION_FIELDS = {
  "description" => { attribute: :description, limit: 4_000 },
  # App Store Connect counts keywords in UTF-8 bytes.
  "keywords" => { attribute: :keywords, byte_limit: 100 },
  "promotional_text" => { attribute: :promotional_text, limit: 170 },
  "marketing_url" => { attribute: :marketing_url },
  "support_url" => { attribute: :support_url },
  "release_notes" => { attribute: :whats_new, limit: 4_000, release_notes: true },
}.freeze
# Same list as Spaceship's get_edit_app_store_version.
APPSTORE_EDITABLE_VERSION_STATES = %w[
  PREPARE_FOR_SUBMISSION
  DEVELOPER_REJECTED
  REJECTED
  METADATA_REJECTED
  WAITING_FOR_REVIEW
  INVALID_BINARY
].freeze
# Apple accepts screenshot changes only before submission or after a rejection.
APPSTORE_SCREENSHOT_EDITABLE_VERSION_STATES = (APPSTORE_EDITABLE_VERSION_STATES - %w[WAITING_FOR_REVIEW]).freeze
APPSTORE_SCREENSHOT_PROCESSING_TIMEOUT = 600

def appstore_metadata_value(locale, field, version_string)
  path = File.join(APPSTORE_METADATA_PATH, locale, "#{field}.txt")
  if APPSTORE_VERSION_FIELDS.dig(field, :release_notes) && version_string == APPSTORE_INITIAL_MAC_VERSION
    UI.user_error!("#{path} must not exist for the initial macOS version") if File.exist?(path)
    return nil
  end

  UI.user_error!("Missing metadata file #{path}") unless File.file?(path)
  File.read(path).strip
end

def appstore_review_notes
  File.read(File.join(APPSTORE_METADATA_PATH, "review_information", "notes.txt")).strip
end

# Attributes of one version localization, keyed by App Store Connect attribute.
def appstore_localization_attributes(locale, version_string)
  APPSTORE_VERSION_FIELDS.each_with_object({}) do |(field, spec), attributes|
    value = appstore_metadata_value(locale, field, version_string)
    attributes[spec[:attribute].to_s] = value unless value.nil?
  end
end

def validate_appstore_metadata!(version_string)
  APPSTORE_STORE_LOCALES.each do |locale|
    APPSTORE_VERSION_FIELDS.each do |field, spec|
      value = appstore_metadata_value(locale, field, version_string)
      next if value.nil?

      UI.user_error!("#{locale}/#{field}.txt is empty") if value.empty?
      if spec[:limit] && value.length > spec[:limit]
        UI.user_error!("#{locale}/#{field}.txt has #{value.length} characters (limit #{spec[:limit]})")
      end
      if spec[:byte_limit] && value.bytesize > spec[:byte_limit]
        UI.user_error!("#{locale}/#{field}.txt has #{value.bytesize} bytes (limit #{spec[:byte_limit]})")
      end
    end
    %w[name subtitle privacy_url].each do |field|
      path = File.join(APPSTORE_METADATA_PATH, locale, "#{field}.txt")
      UI.user_error!("#{path} must not exist: it is shared with the iOS app") if File.exist?(path)
    end
  end
  notes = appstore_review_notes
  UI.user_error!("Review notes have #{notes.bytesize} bytes (limit 4000)") if notes.bytesize > 4_000
end

def appstore_api_key!
  api_key_path = ENV["ASC_API_KEY_PATH"].to_s
  UI.user_error!("Set ASC_API_KEY_PATH to the App Store Connect API key JSON") if api_key_path.empty?
  api_key = JSON.parse(File.read(File.expand_path(api_key_path)))
  app_store_connect_api_key(
    key_id: api_key.fetch("key_id"),
    issuer_id: api_key["issuer_id"],
    key_content: api_key.fetch("key"),
    duration: 1_200,
    in_house: api_key.fetch("in_house", false),
    set_spaceship_token: true
  )
end

def mac_store_version!(version_string)
  app = Spaceship::ConnectAPI::App.find(APPSTORE_APP_IDENTIFIER)
  UI.user_error!("App #{APPSTORE_APP_IDENTIFIER} was not found") unless app
  UI.user_error!("Unexpected App Store app ID #{app.id}") unless app.id.to_s == APPSTORE_APP_ID

  version = app.get_app_store_versions(filter: { platform: "MAC_OS" })
    .find { |candidate| candidate.version_string == version_string }
  UI.user_error!("macOS App Store version #{version_string} was not found") unless version
  version
end

def editable_mac_store_version!(version_string, states: APPSTORE_EDITABLE_VERSION_STATES)
  version = mac_store_version!(version_string)
  state = version.app_version_state || version.app_store_state
  unless states.include?(state)
    UI.user_error!("macOS App Store version #{version_string} is not editable (state: #{state || 'unknown'})")
  end
  version
end

# Writes only the localized text fields and the review notes. deliver would also
# reset the demo-account flag, the release type and review attachments.
def upload_mac_store_metadata!(version)
  localizations = version.get_app_store_version_localizations.to_h { |entry| [entry.locale, entry] }
  APPSTORE_STORE_LOCALES.each do |locale|
    attributes = appstore_localization_attributes(locale, version.version_string)
    localization = localizations[locale]
    unless localization
      # Create the locale first; only update maps the attribute names to the API's camelCase.
      UI.message("Creating #{locale}")
      localization = version.create_app_store_version_localization(attributes: { locale: locale })
    end
    UI.message("Updating #{locale}")
    localization.update(attributes: attributes)
  end

  review_detail = version.fetch_app_store_review_detail
  UI.user_error!("No App Review information exists for this version yet; add the contact details in App Store Connect first") unless review_detail
  review_detail.update(attributes: { "notes" => appstore_review_notes })
end

def verify_mac_store_metadata!(version)
  localizations = version.get_app_store_version_localizations.to_h { |entry| [entry.locale, entry] }
  APPSTORE_STORE_LOCALES.each do |locale|
    localization = localizations[locale]
    UI.user_error!("Missing remote version locale #{locale}") unless localization
    appstore_localization_attributes(locale, version.version_string).each do |attribute, expected|
      actual = localization.public_send(attribute).to_s.strip
      UI.user_error!("#{locale} #{attribute} differs in App Store Connect") unless actual == expected
    end
  end
  notes = version.fetch_app_store_review_detail&.notes.to_s.strip
  UI.user_error!("Review notes differ in App Store Connect") unless notes == appstore_review_notes
  UI.success("Verified macOS #{version.version_string} store text in #{APPSTORE_STORE_LOCALES.count} locales and the review notes")
end

# Store images are rendered from the raw captures by TypeWhisper Studio
# (`npm run render:mac-stills`), which adds the headline and backdrop shared with
# the iOS and Android listings. Check that every locale has exactly the expected
# opaque 2880 x 1800 images before anything in App Store Connect is replaced.
def validate_mac_store_screenshots!
  APPSTORE_STORE_SCREENSHOT_LOCALES.each do |locale|
    directory = File.join(APPSTORE_COMPOSED_SCREENSHOT_OUTPUT, locale)
    expected = APPSTORE_STORE_SCREENSHOT_STATES.each_with_index.map { |state, index| format("%02d-%s.png", index + 1, state) }
    actual = composed_mac_store_screenshots(locale).map { |path| File.basename(path) }
    unless actual == expected
      UI.user_error!("#{directory} must contain #{expected.join(', ')} rendered by TypeWhisper Studio; found #{actual.empty? ? 'nothing' : actual.join(', ')}")
    end
    composed_mac_store_screenshots(locale).each do |path|
      # A capture rerun without a new Studio render would otherwise upload the old images.
      raw = File.join(APPSTORE_SCREENSHOT_OUTPUT, locale, File.basename(path).sub(/\A\d{2}-/, ""))
      if File.file?(raw) && File.mtime(raw) > File.mtime(path)
        UI.user_error!("#{path} is older than its capture #{raw}; render the store images again with TypeWhisper Studio")
      end
      properties = sh(Shellwords.join(["/usr/bin/sips", "-g", "pixelWidth", "-g", "pixelHeight", "-g", "hasAlpha", path]), log: false)
      width = properties[/pixelWidth: (\d+)/, 1].to_i
      height = properties[/pixelHeight: (\d+)/, 1].to_i
      has_alpha = properties[/hasAlpha: (\w+)/, 1]
      UI.user_error!("#{path} is #{width} x #{height}; expected 2880 x 1800") unless width == 2880 && height == 1800
      UI.user_error!("#{path} has an alpha channel; App Store screenshots must be opaque") unless has_alpha == "no"
    end
  end
end

def composed_mac_store_screenshots(locale)
  Dir[File.join(APPSTORE_COMPOSED_SCREENSHOT_OUTPUT, locale, "*.png")].sort
end

# Replaces the desktop screenshot set of each locale with the composed images.
def upload_mac_store_screenshots!(version)
  localizations = version.get_app_store_version_localizations.to_h { |entry| [entry.locale, entry] }
  display_type = Spaceship::ConnectAPI::AppScreenshotSet::DisplayType::APP_DESKTOP
  missing = APPSTORE_STORE_SCREENSHOT_LOCALES - localizations.keys
  UI.user_error!("Missing remote version locales #{missing.join(', ')}; upload the store text first") unless missing.empty?

  APPSTORE_STORE_SCREENSHOT_LOCALES.each do |locale|
    localization = localizations[locale]
    localization.get_app_screenshot_sets
      .select { |set| set.screenshot_display_type == display_type }
      .each(&:delete!)
    set = localization.create_app_screenshot_set(attributes: { screenshotDisplayType: display_type })
    composed_mac_store_screenshots(locale).each do |path|
      UI.message("Uploading #{locale} #{File.basename(path)}")
      # Processing is awaited with a deadline in verify_mac_store_screenshots!.
      set.upload_screenshot(path: path, wait_for_processing: false)
    end
  end
end

def verify_mac_store_screenshots!(version)
  localizations = version.get_app_store_version_localizations.to_h { |entry| [entry.locale, entry] }
  display_type = Spaceship::ConnectAPI::AppScreenshotSet::DisplayType::APP_DESKTOP
  APPSTORE_STORE_SCREENSHOT_LOCALES.each do |locale|
    deadline = Time.now + APPSTORE_SCREENSHOT_PROCESSING_TIMEOUT
    expected = composed_mac_store_screenshots(locale).map { |path| [File.basename(path), Digest::MD5.file(path).hexdigest] }
    unless expected.count == APPSTORE_STORE_SCREENSHOT_STATES.count
      UI.user_error!("Expected #{APPSTORE_STORE_SCREENSHOT_STATES.count} composed #{locale} screenshots, found #{expected.count}; run mac appstore_screenshots_upload")
    end
    actual = nil
    loop do
      set = localizations[locale]&.get_app_screenshot_sets&.find { |candidate| candidate.screenshot_display_type == display_type }
      UI.user_error!("#{locale} has no desktop screenshots in App Store Connect") unless set
      actual = set.app_screenshots.to_a
      failed = actual.select(&:error?)
      UI.user_error!("#{locale}: processing failed for #{failed.map(&:file_name).join(', ')}") unless failed.empty?
      break if actual.count == expected.count && actual.all?(&:complete?)

      pending = expected.count - actual.count(&:complete?)
      UI.user_error!("#{locale}: #{pending} screenshots are still processing after #{APPSTORE_SCREENSHOT_PROCESSING_TIMEOUT} seconds") if Time.now > deadline
      UI.message("Waiting for #{pending} #{locale} screenshots to finish processing")
      sleep(5)
    end
    # source_file_checksum is the MD5 of the uploaded file.
    unless actual.map { |screenshot| [screenshot.file_name, screenshot.source_file_checksum] } == expected
      UI.user_error!("#{locale} screenshots differ in App Store Connect: #{actual.map(&:file_name).join(', ')}")
    end
  end
  UI.success("Verified #{APPSTORE_STORE_SCREENSHOT_STATES.count} macOS screenshots in #{APPSTORE_STORE_SCREENSHOT_LOCALES.join(', ')}")
end

platform :mac do
  desc "Upload the localized macOS store text and review notes, then verify them (version:<version>)"
  lane :appstore_metadata_upload do |options|
    version_string = options[:version].to_s
    UI.user_error!("Pass version:<version>") if version_string.empty?
    validate_appstore_metadata!(version_string)
    appstore_api_key!
    upload_mac_store_metadata!(editable_mac_store_version!(version_string))
    verify_mac_store_metadata!(mac_store_version!(version_string))
  end

  desc "Compare the macOS store text and review notes in App Store Connect with the repository (version:<version>)"
  lane :appstore_metadata_verify do |options|
    version_string = options[:version].to_s
    UI.user_error!("Pass version:<version>") if version_string.empty?
    validate_appstore_metadata!(version_string)
    appstore_api_key!
    verify_mac_store_metadata!(mac_store_version!(version_string))
  end

  desc "Capture the Mac App Store edition in screenshot mode (raw window images)"
  lane :appstore_screenshots do |options|
    languages = selected_screenshot_languages(options[:languages])
    states = appstore_screenshot_states(options[:states])
    build_appstore_screenshot_app! unless options[:skip_build]
    languages.each do |language|
      directory = File.join(APPSTORE_SCREENSHOT_OUTPUT, language)
      FileUtils.mkdir_p(directory)
      states.each do |state|
        UI.message("Capturing #{language} #{state}")
        capture_appstore_screenshot!(language, state, File.join(directory, "#{state}.png"))
      end
    end
  end

  desc "Replace the macOS screenshots with the rendered store images and verify them (version:<version>)"
  lane :appstore_screenshots_upload do |options|
    version_string = options[:version].to_s
    UI.user_error!("Pass version:<version>") if version_string.empty?
    validate_mac_store_screenshots!
    appstore_api_key!
    upload_mac_store_screenshots!(
      editable_mac_store_version!(version_string, states: APPSTORE_SCREENSHOT_EDITABLE_VERSION_STATES)
    )
    verify_mac_store_screenshots!(mac_store_version!(version_string))
  end

  desc "Compare the macOS screenshots in App Store Connect with the composed images (version:<version>)"
  lane :appstore_screenshots_verify do |options|
    version_string = options[:version].to_s
    UI.user_error!("Pass version:<version>") if version_string.empty?
    appstore_api_key!
    verify_mac_store_screenshots!(mac_store_version!(version_string))
  end
end
