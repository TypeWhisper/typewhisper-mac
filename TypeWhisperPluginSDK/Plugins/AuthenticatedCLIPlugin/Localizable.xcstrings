{
  "sourceLanguage": "en",
  "strings": {
    "Choose executable for %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Programm für %@ auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir el ejecutable de %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@の実行ファイルを選択"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为 %@ 选择可执行文件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"為 %@ 選擇可執行檔案"}}}},
    "Use automatic detection for %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatische Erkennung für %@ verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar la detección automática para %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@に自動検出を使用"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为 %@ 使用自动检测"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"為 %@ 使用自動偵測"}}}},
