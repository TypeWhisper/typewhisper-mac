    "Select at least one workflow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mindestens einen Workflow aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona al menos un flujo de trabajo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つ以上のワークフローを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少选择一个工作流。"
          }
        }
      }
    },
    "Selected workflows": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Workflows"
