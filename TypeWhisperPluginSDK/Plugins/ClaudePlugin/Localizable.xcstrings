    "Controls how much thinking time the model spends before answering.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla cuánto tiempo de razonamiento dedica el modelo antes de responder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが回答前にどのくらい考える時間を取るかを制御します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert, wie viel Denkzeit sich das Modell vor der Antwort nimmt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制模型在回答前花费多少思考时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制模型在回答前花費多少思考時間。"
          }
        }
