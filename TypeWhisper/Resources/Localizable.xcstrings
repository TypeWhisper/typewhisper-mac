        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ抽出は、最小文字数とクールダウンなどの条件を満たしたすべての適切な文字起こしに対して実行されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
