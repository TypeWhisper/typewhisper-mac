        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La corrección %lld necesita un texto original y uno de reemplazo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正%lldには、元のテキストと置換テキストが必要です。"
