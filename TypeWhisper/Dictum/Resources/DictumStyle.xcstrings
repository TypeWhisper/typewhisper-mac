    "polish.light": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Removes fillers and repeats, keeps your words"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"去掉口头禅和重复，其余保留原话"}}}},
    "polish.standard": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Also fixes self-corrections, paragraphs, and lists"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"再处理改口、分段和列表"}}}},
    "polish.rewrite": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rewrites in your style"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按风格设置重新组织措辞"}}}},
    "polish.sample": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You said: Um, Thursday at three really doesn't work for me, uh, let's make it four, if four works we can meet in the third-floor conference room, please let everyone know."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你说：嗯，那个，我周四下午三点确实不太行，呃，改到四点吧，四点可以的话我们就在三楼会议室，麻烦大家相互转告一下。"}}}},
    "polish.sample.light": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Writes: Thursday at three really doesn't work for me. Let's make it four. If four works, we can meet in the third-floor conference room. Please let everyone know."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"写出：我周四下午三点确实不太行，改到四点吧，四点可以的话我们就在三楼会议室，麻烦大家相互转告一下。"}}}},
    "polish.sample.standard": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Writes: Thursday at three doesn't work for me. Let's make it four. If four works, we can meet in the third-floor conference room. Please let everyone know."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"写出：我周四下午三点不太方便，改到四点吧。如果四点可以，我们就在三楼会议室，麻烦大家相互转告一下。"}}}},
    "polish.sample.rewrite": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Writes: Could we move Thursday's meeting from three to four? If that works, let's use the third-floor conference room. Please pass the word along."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"写出：周四下午三点不方便，提议改到四点。如果时间合适，就在三楼会议室见。请大家相互转告。"}}}},
    "preview.spoken": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Um, let's move Friday's release to next Tuesday, uh, testing still has two issues, thanks everyone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"嗯那个，周五的发布推迟到下周二吧，呃，测试那边还有两个问题没解决，大家辛苦了"}}}},
    "preview.casual.warm": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Let's move Friday's release to next Tuesday. Testing still has two issues. Thanks, everyone!"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"周五的发布推迟到下周二吧，测试那边还有两个问题没解决，大家辛苦啦。"}}}},
    "preview.casual.direct": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Move Friday's release to next Tuesday. Testing still has two issues. Thanks, everyone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"周五的发布推迟到下周二，测试还有两个问题没解决。辛苦大家。"}}}},
    "preview.casual.upbeat": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Let's move Friday's release to next Tuesday. Testing still has two issues. Thanks for all your work!"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"周五的发布推迟到下周二吧，测试还有两个问题没解决。大家辛苦啦！"}}}},
    "preview.balanced.warm": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friday's release will move to next Tuesday. Testing still has two unresolved issues. Thank you, everyone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"周五的发布推迟到下周二，测试还有两个问题没有解决。大家辛苦了。"}}}},
    "preview.balanced.direct": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friday's release is postponed to next Tuesday because testing has two unresolved issues. Thanks, everyone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"周五的发布推迟到下周二，测试还有两个问题没有解决。感谢大家。"}}}},
    "preview.balanced.upbeat": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"We're moving Friday's release to next Tuesday, with two testing issues still to resolve. Thank you for your hard work!"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"周五的发布推迟到下周二，测试还有两个问题没有解决。感谢大家的辛苦付出！"}}}},
    "preview.formal.warm": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The release scheduled for Friday will be postponed until next Tuesday, as two issues remain unresolved in testing.\n\nThank you all for your efforts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原定周五的发布将推迟至下周二，因为测试环节仍有两个问题尚未解决。\n\n感谢大家的辛苦付出。"}}}},
    "preview.formal.direct": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friday's release is postponed until next Tuesday due to two unresolved testing issues.\n\nThank you for your work."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原定周五的发布推迟至下周二，原因是测试环节仍有两个未解决的问题。\n\n感谢大家的工作。"}}}},
    "preview.formal.upbeat": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The release scheduled for Friday will move to next Tuesday, as two testing issues remain to be resolved.\n\nMany thanks to everyone for your dedication."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原定周五的发布将推迟至下周二，测试环节仍有两个问题需要解决。\n\n衷心感谢大家的辛苦付出。"}}}}
  }
}
