{
  "sourceLanguage" : "en",
  "strings" : {
    "API Key" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "API-Schlüssel" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "APIキー" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "API 密钥" } }
      }
    },
    "Audio is sent to Microsoft Azure for transcription. API keys are stored securely in the Keychain." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Audio wird zur Transkription an Microsoft Azure gesendet. API-Schlüssel werden sicher im Schlüsselbund gespeichert." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声は文字起こしのためMicrosoft Azureに送信されます。APIキーはキーチェーンに安全に保存されます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音频会发送到 Microsoft Azure 进行转录。API 密钥安全存储在钥匙串中。" } }
      }
    },
    "Azure Speech connection" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Azure-Speech-Verbindung" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Azure Speech接続" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Azure Speech 连接" } }
      }
    },
    "Clean" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bereinigt" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "クリーン" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清理" } }
      }
    },
    "Endpoint or resource name" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Endpunkt oder Ressourcenname" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "エンドポイントまたはリソース名" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "端点或资源名称" } }
      }
    },
    "Enter the endpoint shown for your Azure Speech resource, or only its resource name." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gib den für deine Azure-Speech-Ressource angezeigten Endpunkt oder nur den Ressourcennamen ein." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Azure Speechリソースに表示されるエンドポイント、またはリソース名のみを入力してください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入 Azure Speech 资源显示的端点，或仅输入资源名称。" } }
      }
    },
    "MAI Transcribe is not available in the Azure region %@. Use a Speech resource in one of these regions: %@." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "MAI Transcribe ist in der Azure-Region %@ nicht verfügbar. Verwende eine Speech-Ressource in einer dieser Regionen: %@." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "MAI Transcribe は Azure リージョン %@ では利用できません。次のいずれかのリージョンの Speech リソースを使用してください: %@。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "MAI Transcribe 在 Azure 区域 %@ 中不可用。请使用以下区域之一的 Speech 资源：%@。" } }
      }
    },
    "Model" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Modell" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "モデル" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模型" } }
      }
    },
