    "calendarMeeting.settings.detectAdHoc" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrufe ohne Kalendertermin erkennen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detect calls without a calendar event"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar llamadas sin evento en el calendario"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーにない通話を検出"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测没有日历事件的通话"
          }
        }
      }
    },
    "calendarMeeting.settings.detectAdHocHelp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt auch Mikrofonaktivität von Zoom, Teams und Kontur Talk sowie Browser-Meetings wie Google Meet, auch in Hintergrund-Tabs. Kalenderzugriff ist optional. Der gewählte Startmodus und die ausgewählten Anbieter gelten auch für diese Anrufe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also detect Zoom, Teams and Kontur Talk microphone activity and browser meetings such as Google Meet, even in background tabs. Calendar access is optional. The selected start mode and providers apply to these calls too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta también la actividad del micrófono de Zoom, Teams y Kontur Talk, y las reuniones en el navegador como Google Meet, incluso en pestañas en segundo plano. El acceso al calendario es opcional. El modo de inicio y los proveedores seleccionados también se aplican a estas llamadas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom、Teams、Kontur Talkのマイク使用、およびバックグラウンドのタブを含むGoogle Meetなどのブラウザでのミーティングも検出します。カレンダーへのアクセスは任意です。選択した開始モードとサービスはこれらの通話にも適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时检测 Zoom、Teams 和 Kontur Talk 的麦克风活动，以及 Google Meet 等浏览器会议，包括后台标签页。无需授予日历访问权限。所选的启动模式和服务也适用于这些通话。"
          }
        }
      }
    },
    "calendarMeeting.settings.autoStopNotificationsOptional" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Mitteilungen bleibt „Aufnahme fortsetzen“ in der Aufnahmeanzeige verfügbar. Sie wird während des Countdowns auch dann eingeblendet, wenn sie sonst ausgeblendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without notifications, Continue recording remains available in the recording indicator, which is shown during the countdown even if normally hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin notificaciones, “Seguir grabando” sigue disponible en el indicador de grabación, que se muestra durante la cuenta atrás aunque normalmente esté oculto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知がなくても、録音インジケーターの「録音を続ける」を使用できます。通常は非表示でも、カウントダウン中は表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使没有通知，仍可在录音指示器中选择“继续录音”。即使平时隐藏，指示器也会在倒计时期间显示。"
          }
        }
      }
    },
    "calendarMeeting.settings.adHocAutoStopHelp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Anrufen ohne Kalendertermin beginnt der Stopp-Countdown erst nach 90 Sekunden ohne Meeting-Audio. Kurze Unterbrechungen beenden die Aufnahme dadurch nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calls without a calendar event allow 90 seconds without meeting audio before the stop countdown begins, so brief interruptions do not end the recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En las llamadas sin evento en el calendario se permiten 90 segundos sin audio de la reunión antes de que empiece la cuenta atrás para detener la grabación, así las interrupciones breves no la terminan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーにない通話では、ミーティング音声が90秒間使用されなくなってから停止カウントダウンが始まるため、短い中断で録音が終了することはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于没有日历事件的通话，连续 90 秒未检测到会议音频活动后，才会开始停止录音的倒计时，避免短暂中断导致录音结束。"
          }
        }
      }
    },
