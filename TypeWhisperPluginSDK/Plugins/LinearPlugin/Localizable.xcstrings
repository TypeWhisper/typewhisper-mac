{
  "sourceLanguage": "en",
  "strings": {
    "API Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        }
      }
    },
    "API keys are stored securely in the Keychain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel werden sicher im Schlüsselbund gespeichert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーはセキュアにキーチェーンに保存されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥安全存储在钥匙串中"
          }
        }
      }
    },
    "Copy Instruction": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anweisung kopieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指示をコピー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制指令"
          }
        }
      }
    },
    "Create a Custom Workflow, paste this into Instruction, and set Action Target to \"Create Linear Issue\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen eigenen Workflow, füge dies in Anweisung ein und setze das Action-Ziel auf \"Create Linear Issue\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のワークフローを作成し、これを指示に追加し、アクションの目標を\"Create Linear Issue\"に設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建自定义工作流，将其粘贴到指令中，并将操作目标设置为「创建 Linear Issue」。"
          }
        }
      }
    },
    "Create a personal API key at linear.app/settings/api": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen persönlichen API-Schlüssel unter linear.app/settings/api"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "linear.app/settings/apiで独自のAPIキーを作成してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 linear.app/settings/api 创建个人 API 密钥"
          }
        }
      }
    },
