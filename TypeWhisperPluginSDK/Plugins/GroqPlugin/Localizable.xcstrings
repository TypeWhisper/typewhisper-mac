{
  "sourceLanguage": "en",
  "strings": {
    "Send dictionary terms": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörterbuchbegriffe senden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書の用語を送信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送词典术语"
          }
        }
      }
    },
    "Turn this off to retry without dictionary context if words or passages are missing. This does not change dictionary corrections after transcription.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere diese Option, um bei fehlenden Wörtern oder Abschnitten einen neuen Versuch ohne Wörterbuchkontext zu starten. Wörterbuchkorrekturen nach der Transkription bleiben unverändert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語や文章が欠けている場合は、これをオフにして辞書の文脈なしで再試行してください。文字起こし後の辞書による修正には影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果缺少单词或段落，请关闭此选项，在不使用词典上下文的情况下重试。这不会改变转写后的词典纠正。"
          }
        }
      }
    },
    "API Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        }
      }
    },
    "API keys are stored securely in the Keychain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel werden sicher im Schlüsselbund gespeichert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーはキーチェーンに安全に保存されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥安全存储在钥匙串中"
          }
        }
      }
    },
    "Invalid API Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger API-Schlüssel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なAPIキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效的 API 密钥"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        },
        "ja": {
