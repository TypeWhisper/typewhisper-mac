          }
        }
      }
    },
    "Verbatim preserves fillers, repetitions, and self-corrections. Smart cleans up and formats the text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wortgetreu behält Füllwörter, Wiederholungen und Selbstkorrekturen bei. Smart bereinigt und formatiert den Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Literal conserva las muletillas, las repeticiones y las autocorrecciones. Inteligente limpia el texto y le da formato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "逐語モードは、フィラー、繰り返し、言い直しをそのまま残します。スマートモードはテキストを整理し、読みやすく整えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐字模式保留语气词、重复内容和说话时的改口。智能模式会整理文本并调整格式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐字模式保留語氣詞、重複內容和說話時的改口。智慧模式會整理文字並調整格式。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
