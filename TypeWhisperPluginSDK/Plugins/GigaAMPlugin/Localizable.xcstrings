{
  "sourceLanguage": "en",
  "strings": {
    "Auto-unload model is set to Immediate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Modell automatisch entladen“ steht auf „Sofort“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Liberar el modelo automáticamente” está en “Inmediato”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モデルを自動でアンロード」が「すぐに」に設定されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动卸载模型”已设为“立即”。"
          }
        }
      }
    },
    "Download & Load": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden & Aktivieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar y cargar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み & 有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并加载"
          }
        }
      }
    },
    "Download and load %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ laden und aktivieren"
