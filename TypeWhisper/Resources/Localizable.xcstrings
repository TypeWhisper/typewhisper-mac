    "premium.window.learning.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper merkt sich nur eindeutige Änderungen und überspringt unsichere Bearbeitungen."
