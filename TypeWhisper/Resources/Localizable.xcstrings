    },
    "Payment is charged to your Apple Account. Cancel at least 24 hours before the end of the current period in your App Store account settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pago se carga a tu cuenta de Apple. Cancela al menos 24 horas antes del final del periodo actual en los ajustes de tu cuenta de App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お支払いは Apple アカウントに請求されます。現在の期間が終了する少なくとも24時間前までに、App Store のアカウント設定でキャンセルしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "费用将从你的 Apple 账户中扣除。请至少在当前周期结束前 24 小时，在 App Store 账户设置中取消。"
          }
        }
      }
    },
    "Retries failed dictations with a second engine and can race it when the primary engine is slow." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reintenta los dictados fallidos con un segundo motor y puede ejecutarlo en paralelo cuando el motor principal es lento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失敗したディクテーションを2つ目のエンジンで再試行し、メインエンジンが遅い場合は並行実行できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用第二个引擎重试失败的听写，并可在主引擎较慢时并行运行它。"
          }
        }
      }
    },
    "Record scheduled meetings automatically, retry failed dictations with a second engine, and keep your dictionary and snippets in sync." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba automáticamente las reuniones programadas, reintenta los dictados fallidos con un segundo motor y mantén sincronizados tu diccionario y tus fragmentos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定されたミーティングを自動で録音し、失敗した音声入力を別のエンジンで再試行し、辞書とスニペットを同期します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动录制已安排的会议，用第二个引擎重试失败的听写，并同步你的词典和片段。"
          }
        }
      }
    },
