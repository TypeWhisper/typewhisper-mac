      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Modelle wurden aus Microsoft Foundry aktualisiert." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Microsoft Foundryからモデルを更新しました。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已从 Microsoft Foundry 刷新模型。" } }
      }
    },
    "Refresh models" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Modelle aktualisieren" } },
