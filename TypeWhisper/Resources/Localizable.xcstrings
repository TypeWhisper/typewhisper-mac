    "history.retranscribe.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe this recording again with another engine, model, language or Workflow, then compare. The current text stays unchanged until you choose “Use this result”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkribiere diese Aufnahme noch einmal mit einer anderen Engine, einem anderen Modell, einer anderen Sprache oder einem Workflow und vergleiche. Der aktuelle Text bleibt unverändert, bis du „Ergebnis übernehmen“ wählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a transcribir esta grabación con otro motor, modelo, idioma o flujo de trabajo y compara. El texto actual no cambia hasta que elijas “Usar este resultado”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この録音を別のエンジン、モデル、言語、またはワークフローでもう一度文字起こしして比較します。「この結果を使用」を選ぶまで、現在のテキストは変わりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用其他引擎、模型、语言或工作流重新转录此录音，然后比较结果。在你选择“使用此结果”之前，当前文本保持不变。"
          }
        }
      }
    },
