    },
    "Could not reach the Ollama server. Check that it is running and the URL is correct.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ollama-Server ist nicht erreichbar. Prüfe, ob er läuft und die URL stimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder al servidor de Ollama. Comprueba que esté en ejecución y que la URL sea correcta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollamaサーバーに接続できませんでした。サーバーが起動していることと、URLが正しいことを確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the Ollama server. Check that it is running and the URL is correct."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 Ollama 服务器。请确认其正在运行且 URL 正确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到 Ollama 伺服器。請確認其正在執行且 URL 正確。"
          }
        }
      }
    },
    "The server rejected the request (unauthorized). Check the API key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó la solicitud (no autorizada). Revisa la clave de API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
