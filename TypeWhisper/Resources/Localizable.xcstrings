    "history.retranscribe.localVersions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Results stay on this Mac until you delete them or the History entry expires. Search, exports and sync always use the current text. Additional runs do not count as new dictations and do not change your statistics."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ergebnisse bleiben auf diesem Mac, bis du sie löschst oder der Verlaufseintrag abläuft. Suche, Exporte und Sync verwenden immer den aktuellen Text. Weitere Läufe zählen nicht als neue Diktate und ändern deine Statistik nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados se quedan en este Mac hasta que los elimines o caduque la entrada del historial. La búsqueda, las exportaciones y la sincronización siempre usan el texto actual. Las ejecuciones adicionales no cuentan como dictados nuevos y no cambian tus estadísticas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果は、削除するか履歴の項目の保存期間が過ぎるまでこのMacに残ります。検索、書き出し、同期では常に現在のテキストが使われます。追加の実行は新しい音声入力として数えられず、統計も変わりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结果会保留在这台 Mac 上，直到你将其删除或历史记录条目过期。搜索、导出和同步始终使用当前文本。额外运行不会计为新的听写，也不会更改你的统计数据。"
          }
        }
      }
    },
