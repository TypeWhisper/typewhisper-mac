    "Still discards accidental ultra-short taps, but keeps more very short or quiet recordings instead of classifying them as no speech." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue descartando las pulsaciones ultracortas accidentales, pero conserva más grabaciones muy cortas o silenciosas en lugar de clasificarlas como sin voz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誤操作による極端に短いタップは引き続き破棄しますが、ごく短い録音や小さな音声を無音として分類せず、より多く保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍然会丢弃意外的超短按键录音，但会保留更多极短或音量很低的录音，而不是将其归类为无语音。"
          }
        }
      }
    },
