    "Connect Discord to claim your %@ supporter status in the community server.": {
      "comment": "A description of the Discord connection process for claiming a supporter tier. The argument is the string “Bronze”, the string “Silver” or the string “Gold”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Discord, um deinen %1$@-Supporter-Status im Community-Server zu beanspruchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Discordに接続して、コミュニティサーバーで%@のサポーターステータスを認証します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Discord 以在社区服务器中声明你的 %@ 支持者身份。"
