{
  "sourceLanguage": "en",
  "strings": {
    "Add metadata (date, app, language, tags) to each note.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadaten (Datum, App, Sprache, Tags) zu jeder Notiz hinzufügen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各メモにメタデータ（日付、アプリ、言語、タグ）を追加します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向每条笔记添加元数据（日期、应用、语言、标签）。"
          }
        }
      }
    },
    "Append all transcriptions to a single daily file instead of creating individual notes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Transkriptionen an eine einzelne Tagesdatei anhängen, statt einzelne Notizen zu erstellen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのテキストを1日のファイルに追加し、個別のメモを作成しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有转录内容追加到单个每日文件中，而不是创建单独的笔记。"
          }
        }
      }
    },
    "Append format:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhangsformat:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追記形式:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追加格式："
          }
        }
      }
    },
    "Auto-Export": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Export"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動エクスポート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动导出"
          }
        }
      }
    },
    "Automatically save every transcription to Obsidian.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Transkription automatisch in Obsidian speichern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各テキストを自動的にObsidianに保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动将每次转录保存到 Obsidian。"
          }
        }
      }
    },
    "Browse...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen ..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览..."
          }
        }
      }
    },
    "Copy Instruction": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anweisung kopieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指示をコピー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制指令"
          }
        }
      }
    },
    "Create a Custom Workflow, paste this into Instruction, and set Action Target to \"Save to Obsidian\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen eigenen Workflow, füge dies in Anweisung ein und setze das Action-Ziel auf \"Save to Obsidian\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のワークフローを作成し、これを指示に追加し、アクションの目標を「Obsidianに保存」に設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建自定义工作流，将其粘贴到指令中，并将操作目标设置为「保存到 Obsidian」。"
          }
        }
      }
    },
    "Bullet list": {
      "localizations": {
        "de": {
          "stringUnit": {
