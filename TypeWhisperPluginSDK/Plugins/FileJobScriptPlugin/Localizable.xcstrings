          }
        }
      }
    },
    "Add Script": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skript hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir script"
          }
        },
        "ja": {
          "stringUnit": {
