        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载 %@"
          }
        }
      }
    },
    "Remove Hugging Face token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging-Face-Token entfernen"
