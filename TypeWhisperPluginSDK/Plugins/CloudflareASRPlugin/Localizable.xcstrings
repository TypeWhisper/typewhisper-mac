    "Service token credentials for Cloudflare Access. Stored in macOS Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten für das Service-Token von Cloudflare Access. Sie werden im macOS-Schlüsselbund gespeichert."
