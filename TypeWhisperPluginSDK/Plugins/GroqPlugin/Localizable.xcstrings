    "Send dictionary terms": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörterbuchbegriffe senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar los términos del diccionario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書の用語を送信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送词典术语"
          }
        }
      }
    },
    "Off by default because dictionary terms can make Groq skip parts of a dictation. Dictionary corrections after transcription apply either way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus, weil Groq mit Wörterbuchbegriffen Teile eines Diktats auslassen kann. Wörterbuchkorrekturen nach der Transkription gelten in jedem Fall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado de forma predeterminada porque los términos del diccionario pueden hacer que Groq omita partes de un dictado. Las correcciones del diccionario después de la transcripción se aplican en cualquier caso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書の用語を送信するとGroqが口述の一部を省略することがあるため、既定ではオフです。文字起こし後の辞書による修正は常に適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，因为发送词典术语可能导致 Groq 漏掉部分听写内容。转写后的词典纠正始终生效。"
          }
        }
      }
    },
    "API Key": {
      "localizations": {
        "de": {
