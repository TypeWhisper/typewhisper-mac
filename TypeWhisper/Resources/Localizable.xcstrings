    "Remove %@? This will delete the downloaded model files and disable %@." : {
      "comment" : "A confirmation message that asks the user to confirm the deletion of a downloaded model. The first argument is the name of the model. The second argument is the name of the plugin.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar %1$@? Se eliminarán los archivos del modelo descargados y se desactivará %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@を削除しますか？ダウンロード済みのモデルファイルが削除され、%2$@が無効になります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ entfernen? Dadurch werden die heruntergeladenen Modelldateien gelöscht und %2$@ deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove %1$@? This will delete the downloaded model files and disable %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要移除 %@ 吗？这将删除已下载的模型文件并停用 %@。"
          }
        }
      }
    },
    "Remove %@? This will delete the downloaded model files. %@ will stay installed and enabled." : {
      "comment" : "A confirmation message for removing a downloaded model. The first argument is the name of the model. The second argument is the name of the plugin.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar %1$@? Se eliminarán los archivos del modelo descargados. %2$@ seguirá instalado y activado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@を削除しますか？ダウンロード済みのモデルファイルが削除されます。%2$@はインストール済みかつ有効のままです。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ entfernen? Dadurch werden die heruntergeladenen Modelldateien gelöscht. %2$@ bleibt installiert und aktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove %1$@? This will delete the downloaded model files. %2$@ will stay installed and enabled."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要移除 %@ 吗？这将删除已下载的模型文件。%@ 将保持安装并启用。"
          }
        }
      }
    },
    "Remove %@? This will delete the incompatible plugin bundle, its stored data, and its credentials." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar %@? Se eliminarán el paquete de plugin incompatible, sus datos guardados y sus credenciales."
          }
