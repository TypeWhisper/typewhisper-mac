    "All credentials are stored securely in the macOS Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zugangsdaten werden sicher im macOS-Schlüsselbund gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las credenciales se guardan de forma segura en el llavero de macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての認証情報はmacOSキーチェーンに安全に保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有凭据都安全存储在 macOS 钥匙串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有憑證都安全儲存在 macOS 鑰匙圈中。"
          }
        }
      }
    },
