{
  "sourceLanguage": "en",
  "strings": {
    "Anthropic account via Claude Code": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Anthropic-Konto über Claude Code"}},"ja":{"stringUnit":{"state":"translated","value":"Claude Code経由のAnthropicアカウント"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过 Claude Code 使用 Anthropic 账户"}}}},
    "Authenticated Provider CLIs": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Authentifizierte Anbieter-CLIs"}},"ja":{"stringUnit":{"state":"translated","value":"認証済みプロバイダーCLI"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已认证的提供商 CLI"}}}},
    "Available models": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verfügbare Modelle"}},"ja":{"stringUnit":{"state":"translated","value":"利用可能なモデル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可用模型"}}}},
    "Best-effort integration": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Best-Effort-Integration"}},"ja":{"stringUnit":{"state":"translated","value":"ベストエフォート統合"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尽力而为的集成"}}}},
    "Check again": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erneut prüfen"}},"ja":{"stringUnit":{"state":"translated","value":"再確認"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检查"}}}},
    "Check failed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Prüfung fehlgeschlagen"}},"ja":{"stringUnit":{"state":"translated","value":"確認に失敗"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查失败"}}}},
    "Checking…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird geprüft…"}},"ja":{"stringUnit":{"state":"translated","value":"確認中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查…"}}}},
    "Choose": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Auswählen"}},"ja":{"stringUnit":{"state":"translated","value":"選択"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择"}}}},
    "Choose CLI executable": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"CLI-Programm auswählen"}},"ja":{"stringUnit":{"state":"translated","value":"CLI実行ファイルを選択"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择 CLI 可执行文件"}}}},
    "Choose…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Auswählen…"}},"ja":{"stringUnit":{"state":"translated","value":"選択…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择…"}}}},
    "CLI default": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"CLI-Standard"}},"ja":{"stringUnit":{"state":"translated","value":"CLIのデフォルト"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CLI 默认值"}}}},
    "CLI documentation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"CLI-Dokumentation"}},"ja":{"stringUnit":{"state":"translated","value":"CLIドキュメント"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CLI 文档"}}}},
    "Currently free": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Derzeit kostenlos"}},"ja":{"stringUnit":{"state":"translated","value":"現在無料"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前免费"}}}},
    "Default effort": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Standard-Effort"}},"ja":{"stringUnit":{"state":"translated","value":"デフォルトのエフォート"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认推理强度"}}}},
    "Executable": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Programm"}},"ja":{"stringUnit":{"state":"translated","value":"実行ファイル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可执行文件"}}}},
    "Free for a limited time": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeitlich begrenzt kostenlos"}},"ja":{"stringUnit":{"state":"translated","value":"期間限定で無料"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"限时免费"}}}},
    "High": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Hoch"}},"ja":{"stringUnit":{"state":"translated","value":"高"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"高"}}}},
    "Incompatible": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht kompatibel"}},"ja":{"stringUnit":{"state":"translated","value":"互換性なし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不兼容"}}}},
    "Installed and authenticated.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Installiert und angemeldet."}},"ja":{"stringUnit":{"state":"translated","value":"インストール済みで認証されています。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装并已登录。"}}}},
    "Low": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Niedrig"}},"ja":{"stringUnit":{"state":"translated","value":"低"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"低"}}}},
    "Max": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maximum"}},"ja":{"stringUnit":{"state":"translated","value":"最大"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最大"}}}},
    "Medium": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mittel"}},"ja":{"stringUnit":{"state":"translated","value":"中"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"中"}}}},
    "Minimal": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Minimal"}},"ja":{"stringUnit":{"state":"translated","value":"最小"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最小"}}}},
    "Models and model-specific effort levels are loaded from the signed-in Codex CLI and refreshed automatically.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Modelle und modellspezifische Effort-Stufen werden aus der angemeldeten Codex-CLI geladen und automatisch aktualisiert."}},"ja":{"stringUnit":{"state":"translated","value":"モデルとモデル固有のエフォートレベルは、サインイン済みのCodex CLIから読み込まれ、自動的に更新されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"模型及各模型对应的推理强度级别会从已登录的 Codex CLI 加载，并自动刷新。"}}}},
    "Models are loaded from the signed-in Antigravity CLI. Effort can be set to Low, Medium, or High.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Modelle werden aus der angemeldeten Antigravity-CLI geladen. Effort kann auf Niedrig, Mittel oder Hoch gesetzt werden."}},"ja":{"stringUnit":{"state":"translated","value":"モデルはサインイン済みのAntigravity CLIから読み込まれます。エフォートは低、中、高に設定できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"模型从已登录的 Antigravity CLI 加载。推理强度可设为低、中或高。"}}}},
    "Free models are loaded dynamically from OpenCode Zen. Offers can change or end at any time.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kostenlose Modelle werden dynamisch aus OpenCode Zen geladen. Angebote können sich jederzeit ändern oder enden."}},"ja":{"stringUnit":{"state":"translated","value":"無料モデルはOpenCode Zenから動的に読み込まれます。提供内容はいつでも変更または終了する場合があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"免费模型从 OpenCode Zen 动态加载。优惠可能随时变更或结束。"}}}},
    "Not installed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht installiert"}},"ja":{"stringUnit":{"state":"translated","value":"未インストール"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未安装"}}}},
    "Not live-tested": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht live getestet"}},"ja":{"stringUnit":{"state":"translated","value":"ライブテスト未実施"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未经实际测试"}}}},
    "Only the workflow instruction and transcript text are sent. Each request runs non-interactively in a temporary folder with tools, sessions, project rules, and update checks disabled where the CLI supports it.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gesendet werden nur die Workflow-Anweisung und der Transkripttext. Jede Anfrage läuft nicht interaktiv in einem temporären Ordner; Tools, Sitzungen, Projektregeln und Update-Prüfungen werden deaktiviert, soweit die CLI dies unterstützt."}},"ja":{"stringUnit":{"state":"translated","value":"送信されるのはワークフローの指示と文字起こしテキストだけです。各リクエストは一時フォルダで非対話的に実行され、CLIが対応している場合はツール、セッション、プロジェクトルール、更新確認が無効になります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅发送工作流指令和转录文本。每个请求都会在临时文件夹中以非交互方式运行；在 CLI 支持的情况下，会禁用工具、会话、项目规则和更新检查。"}}}},
    "OpenAI account via Codex": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"OpenAI-Konto über Codex"}},"ja":{"stringUnit":{"state":"translated","value":"Codex経由のOpenAIアカウント"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过 Codex 使用 OpenAI 账户"}}}},
    "Free OpenCode Zen models via your existing login": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kostenlose OpenCode-Zen-Modelle über deine bestehende Anmeldung"}},"ja":{"stringUnit":{"state":"translated","value":"既存のログインによる無料OpenCode Zenモデル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过你现有的登录使用免费的 OpenCode Zen 模型"}}}},
    "Ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereit"}},"ja":{"stringUnit":{"state":"translated","value":"準備完了"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"就绪"}}}},
    "Review Zen privacy and pricing": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zen-Datenschutz und Preise prüfen"}},"ja":{"stringUnit":{"state":"translated","value":"Zenのプライバシーと料金を確認"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看 Zen 隐私政策和价格"}}}},
    "Setup guide": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einrichtungsanleitung"}},"ja":{"stringUnit":{"state":"translated","value":"セットアップガイド"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置指南"}}}},
    "Sign-in required": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Anmeldung erforderlich"}},"ja":{"stringUnit":{"state":"translated","value":"サインインが必要"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要登录"}}}},
    "Some free OpenCode Zen models may use prompts and completions for training. Do not send personal or confidential data unless the selected model's terms allow it.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einige kostenlose OpenCode-Zen-Modelle dürfen Prompts und Antworten zum Training verwenden. Sende keine persönlichen oder vertraulichen Daten, sofern die Bedingungen des gewählten Modells dies nicht erlauben."}},"ja":{"stringUnit":{"state":"translated","value":"一部の無料OpenCode Zenモデルでは、プロンプトと回答が学習に使用される場合があります。選択したモデルの条件で許可されていない限り、個人情報や機密情報を送信しないでください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分免费的 OpenCode Zen 模型可能会使用提示词和生成内容进行训练。除非所选模型的条款允许，否则请勿发送个人或机密数据。"}}}},
    "The Antigravity model list could not be refreshed. The last cached list remains available.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Antigravity-Modellliste konnte nicht aktualisiert werden. Die zuletzt gespeicherte Liste bleibt verfügbar."}},"ja":{"stringUnit":{"state":"translated","value":"Antigravityのモデル一覧を更新できませんでした。最後に保存された一覧は引き続き使用できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法刷新 Antigravity 模型列表。上次缓存的列表仍可使用。"}}}},
    "The Codex model list could not be refreshed. The last cached list remains available.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Codex-Modellliste konnte nicht aktualisiert werden. Die zuletzt gespeicherte Liste bleibt verfügbar."}},"ja":{"stringUnit":{"state":"translated","value":"Codexのモデル一覧を更新できませんでした。最後に保存された一覧は引き続き使用できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法刷新 Codex 模型列表。上次缓存的列表仍可使用。"}}}},
    "The OpenCode Zen model list could not be refreshed. The last cached list remains available.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die OpenCode-Zen-Modellliste konnte nicht aktualisiert werden. Die zuletzt gespeicherte Liste bleibt verfügbar."}},"ja":{"stringUnit":{"state":"translated","value":"OpenCode Zenのモデル一覧を更新できませんでした。最後に保存された一覧は引き続き使用できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法刷新 OpenCode Zen 模型列表。上次缓存的列表仍可使用。"}}}},
    "Support follows the documented Antigravity headless CLI contract. No signed-in installation was available for a live test.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Unterstützung folgt dem dokumentierten Headless-CLI-Vertrag von Antigravity. Für einen Live-Test war keine angemeldete Installation verfügbar."}},"ja":{"stringUnit":{"state":"translated","value":"サポートは文書化されたAntigravityヘッドレスCLIの仕様に準拠しています。ライブテストに使用できるサインイン済みの環境はありませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此支持基于 Antigravity 文档中的无头 CLI 约定。目前没有已登录的安装可用于实际测试。"}}}},
    "The CLI is installed, but no signed-in account was detected.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die CLI ist installiert, aber es wurde kein angemeldetes Konto erkannt."}},"ja":{"stringUnit":{"state":"translated","value":"CLIはインストールされていますが、サインイン済みアカウントが見つかりません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CLI 已安装，但未检测到已登录的账户。"}}}},
    "The CLI was not found in common installation locations.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die CLI wurde an den üblichen Installationsorten nicht gefunden."}},"ja":{"stringUnit":{"state":"translated","value":"一般的なインストール先にCLIが見つかりません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在常见安装位置未找到该 CLI。"}}}},
    "Ultracode": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ultracode"}},"ja":{"stringUnit":{"state":"translated","value":"ウルトラコード"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Ultracode"}}}},
    "Use automatic detection": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatische Erkennung verwenden"}},"ja":{"stringUnit":{"state":"translated","value":"自動検出を使用"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用自动检测"}}}},
    "Use the accounts already signed in to supported provider CLIs. No separate API key is stored in TypeWhisper.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verwende die Konten, mit denen du bereits in unterstützten Anbieter-CLIs angemeldet bist. TypeWhisper speichert keinen separaten API-Key."}},"ja":{"stringUnit":{"state":"translated","value":"対応するプロバイダーCLIですでにサインインしているアカウントを使用します。TypeWhisperに別のAPIキーは保存されません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用已在受支持的提供商 CLI 中登录的账户。TypeWhisper 不会另外存储 API 密钥。"}}}},
    "Version": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Version"}},"ja":{"stringUnit":{"state":"translated","value":"バージョン"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"版本"}}}},
    "XHigh": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sehr hoch"}},"ja":{"stringUnit":{"state":"translated","value":"非常に高"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"极高"}}}}
  },
  "version": "1.0"
}
