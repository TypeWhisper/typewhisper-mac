          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Valid API Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
