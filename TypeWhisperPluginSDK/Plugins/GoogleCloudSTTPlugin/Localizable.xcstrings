            "state": "translated",
            "value": "Guardar credenciales"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報を保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存凭据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存憑證"
          }
        }
      }
    },
    "Service Account JSON": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienstkonto-JSON"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON de la cuenta de servicio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスアカウントJSON"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
