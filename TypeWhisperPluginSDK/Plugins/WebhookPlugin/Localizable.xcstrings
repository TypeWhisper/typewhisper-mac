      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Webhooks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhookなし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无 Webhook"
          }
        }
      }
    },
    "No workflows configured.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Workflows konfiguriert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークフローが設定されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置工作流。"
          }
        }
      }
    },
    "No longer available": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht mehr verfügbar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できなくなりました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再可用"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Select at least one workflow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mindestens einen Workflow aus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つ以上のワークフローを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少选择一个工作流。"
          }
        }
      }
    },
    "Selected workflows": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Workflows"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したワークフロー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选定的工作流"
          }
        }
      }
    },
    "Send webhook for": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook senden für"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhookの送信対象"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送 Webhook 至"
          }
        }
      }
    },
    "The webhook is sent after every transcription, including transcriptions without a workflow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Webhook wird nach jeder Transkription gesendet, auch wenn kein Workflow verwendet wird."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークフローを使用しない場合も含め、すべての文字起こし後にWebhookを送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次转录后都会发送 Webhook，包括没有工作流的转录。"
          }
        }
      }
    },
    "The webhook is sent only for the selected workflows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Webhook wird nur für die ausgewählten Workflows gesendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したワークフローに対してのみWebhookを送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对选定的工作流发送 Webhook。"
          }
        }
      }
    },
