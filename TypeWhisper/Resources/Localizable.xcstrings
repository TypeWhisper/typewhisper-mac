    "calendarMeeting.settings.calendarsHelp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Termine aus ausgewählten Kalendern werden berücksichtigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only meetings from selected calendars are considered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se tienen en cuenta las reuniones de los calendarios seleccionados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したカレンダーの予定だけが対象になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅考虑所选日历中的会议。"
          }
        }
      }
    },
    "calendarMeeting.settings.confirmSoloEvents" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Terminen ohne weitere Teilnehmer vor der Aufnahme fragen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask before recording events without other attendees"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguntar antes de grabar eventos sin otros asistentes"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他の参加者がいない予定は録音前に確認する"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音前询问没有其他参与者的日历事件"
          }
        }
      }
    },
    "calendarMeeting.settings.confirmSoloEventsHelp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Termine, zu denen niemand sonst eingeladen ist, etwa private Termine mit Anruf-Link. TypeWhisper erinnert dich stattdessen und nimmt erst nach deiner Bestätigung auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to events nobody else is invited to, such as private appointments with a call link. TypeWhisper reminds you instead and records only after you confirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a eventos a los que no hay nadie más invitado, como citas privadas con un enlace de llamada. TypeWhisper te avisa en su lugar y solo graba después de que lo confirmes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話リンク付きのプライベートな予定など、ほかに誰も招待されていない予定が対象です。自動では録音せずに通知し、確認後にのみ録音します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于没有邀请其他人的日历事件，例如带通话链接的私人日程。TypeWhisper 会改为提醒你，并在你确认后才开始录音。"
          }
        }
      }
    },
    "calendarMeeting.settings.providersHelp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Meeting-Apps, für die TypeWhisper Termine erkennen darf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the meeting apps TypeWhisper may recognize from calendar events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige las apps de reuniones que TypeWhisper puede reconocer en los eventos del calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダー予定から認識するミーティングアプリを選択します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 TypeWhisper 可从日历事件中识别的会议应用。"
          }
        }
      }
    },
