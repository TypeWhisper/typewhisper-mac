    "Cloud Folder Sync is available with a Commercial license. Sync dictionaries and snippets through your own iCloud Drive, Dropbox, OneDrive, Syncthing, or custom folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud-Ordner-Sync ist mit einer kommerziellen Lizenz verfügbar. Synchronisiere Wörterbücher und Snippets über dein eigenes iCloud Drive, Dropbox, OneDrive, Syncthing oder einen benutzerdefinierten Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización con carpeta en la nube está disponible con una licencia comercial. Sincroniza diccionarios y fragmentos a través de tu propio iCloud Drive, Dropbox, OneDrive, Syncthing o una carpeta personalizada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドフォルダ同期は商用ライセンスが必要です。独自のiCloud Drive、Dropbox、OneDrive、Syncthing、またはカスタムフォルダを通じて辞書やスニペットを同期できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云文件夹同步功能需要商业许可证。可通过你自己的 iCloud Drive、Dropbox、OneDrive、Syncthing 或自定义文件夹同步词典和快捷短语。"
          }
        }
      }
    },
