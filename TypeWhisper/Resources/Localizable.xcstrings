    "Your App Store subscription is not canceled automatically. After Lifetime is active, cancel the subscription to avoid another renewal." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu suscripción de App Store no se cancela automáticamente. Cuando el acceso vitalicio esté activo, cancela la suscripción para evitar otra renovación."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store のサブスクリプションは自動ではキャンセルされません。買い切りが有効になったら、次回の更新を避けるためにサブスクリプションをキャンセルしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 App Store 订阅不会自动取消。终身访问生效后，请取消订阅以避免再次续订。"
          }
        }
      }
    },
    "App Store purchases are currently unavailable." : {
