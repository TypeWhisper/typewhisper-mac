            "value": "自定义"
          }
        }
      }
    },
    "Generation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Generierung"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成"
          }
        }
      }
    },
    "Load": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载"
          }
        }
      }
    },
    "Precise": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präzise"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严谨"
          }
        }
      }
    },
    "Provider Default": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anbieterstandard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供商默认"
          }
        }
      }
    },
    "Temperature": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatur"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度"
          }
        }
      }
    },
    "Uses the model's built-in default temperature.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die integrierte Standardtemperatur des Modells."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用模型内置的默认温度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルに組み込まれたデフォルトの温度を使用します。"
          }
        }
      }
    },
    "Download & Load": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden & Aktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み & 有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并加载"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Delete cached model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischengespeichertes Modell löschen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされたモデルを削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除缓存的模型"
          }
        }
      }
    },
    "Download timed out while fetching the model from Hugging Face. Please retry. Adding an optional HuggingFace token in this plugin can also increase download rate limits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des Modells von Hugging Face hat zu lange gedauert. Bitte erneut versuchen. Ein optionaler HuggingFace-Token in diesem Plugin kann die Download-Rate-Limits erhöhen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Faceからのモデルのダウンロードがタイムアウトしました。再試行してください。このプラグインでHuggingFaceトークンを追加すると、ダウンロードのレート制限が緩和される場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Hugging Face 下载模型超时。请重试。在此插件中添加可选的 HuggingFace 令牌也可以提高下载速率限制。"
          }
        }
      }
    },
    "Downloading %1$@ stalled at %2$@ because no additional bytes were received for five minutes. Try again. If the issue persists, delete the cached model and download it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download von %1$@ ist bei %2$@ stehen geblieben, da fünf Minuten lang keine weiteren Bytes empfangen wurden. Versuche es erneut. Wenn das Problem bestehen bleibt, lösche das zwischengespeicherte Modell und lade es erneut herunter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のダウンロードは %2$@ で停止し、5 分間新しいバイトを受信しませんでした。もう一度お試しください。問題が続く場合は、キャッシュされたモデルを削除して再度ダウンロードしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载 %1$@ 在 %2$@ 处停滞，因为五分钟内未收到更多字节。请重试。如果问题仍然存在，请删除缓存模型并重新下载。"
          }
        }
      }
    },
    "Preparing %1$@ timed out after 15 minutes (last download progress: %2$@). The downloaded model was kept; try loading it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorbereitung von %1$@ hat nach 15 Minuten das Zeitlimit erreicht (letzter Downloadfortschritt: %2$@). Das heruntergeladene Modell wurde beibehalten; versuche erneut, es zu laden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の準備は 15 分後にタイムアウトしました（最後のダウンロード進捗: %2$@）。ダウンロード済みモデルは保持されています。もう一度読み込んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备 %1$@ 在 15 分钟后超时（上次下载进度：%2$@）。已保留下载的模型，请尝试重新加载。"
          }
        }
      }
    },
    "The downloaded model cache appears incomplete or incompatible. Delete the cached model and download it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der heruntergeladene Modellcache scheint unvollständig oder inkompatibel zu sein. Lösche das zwischengespeicherte Modell und lade es erneut herunter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたモデルキャッシュが不完全か互換性がないようです。キャッシュされたモデルを削除して、もう一度ダウンロードしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载的模型缓存似乎不完整或不兼容。请删除缓存的模型并重新下载。"
          }
        }
      }
    },
    "HuggingFace Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HuggingFace Token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HuggingFace トークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HuggingFace 令牌"
          }
        }
      }
    },
    "Load a local model in Integrations before using it for prompts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade zuerst ein lokales Modell in den Integrationen, bevor du es für Prompts verwendest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトで使用する前に、統合でローカルモデルを読み込んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在用于提示词之前，请先在集成中加载本地模型。"
          }
        }
      }
    },
    "Local LLM on Apple Silicon with Gemma 4, Qwen3.5, and LFM2.5 models. No API key required.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales LLM auf Apple Silicon mit Gemma-4-, Qwen3.5- und LFM2.5-Modellen. Kein API-Schlüssel erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon上でGemma 4、Qwen3.5、LFM2.5モデルを使うローカルLLM。APIキー不要。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Silicon 上运行 Gemma 4、Qwen3.5 和 LFM2.5 模型的本地 LLM。无需 API 密钥。"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "Invalid HuggingFace Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger HuggingFace-Token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なHuggingFaceトークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效的 HuggingFace 令牌"
          }
        }
      }
    },
    "Experimental": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性"
          }
        }
      }
    },
    "Experimental. You can try it at your own risk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell. Du kannst es auf eigene Gefahr ausprobieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的です。ご自身の責任で試してみてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性功能。您可以自行尝试，风险自负。"
          }
        }
      }
    },
    "Experimental. Uses less memory than Gemma 4 but translates and restructures text less reliably.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell. Braucht weniger Arbeitsspeicher als Gemma 4, übersetzt und strukturiert Text aber weniger zuverlässig."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的。Gemma 4よりメモリ使用量は少ないものの、翻訳やテキストの再構成の精度は下がります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性。比 Gemma 4 占用更少内存，但翻译和重组文本的可靠性较低。"
          }
        }
      }
    },
    "Experimental. Reasons before answering, so results take several seconds. LFM Open License: commercial use is free only below USD 10M annual revenue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell. Denkt vor der Antwort nach, daher dauern Ergebnisse einige Sekunden. LFM Open License: Kommerzielle Nutzung ist nur unter 10 Mio. USD Jahresumsatz kostenlos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的。回答前に推論するため、結果が出るまで数秒かかります。LFM Open License：商用利用が無料なのは年間売上1,000万米ドル未満の場合のみです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性。模型会先推理再回答，因此结果需要几秒钟。LFM Open License：仅年收入低于 1000 万美元时可免费商用。"
          }
        }
      }
    },
    "Valid HuggingFace Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gültiger HuggingFace-Token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なHuggingFaceトークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效的 HuggingFace 令牌"
          }
        }
      }
    },
    "Validating token...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token wird geprüft..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンの検証中..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证令牌..."
          }
        }
      }
    },
    "Optional. Increases download rate limits. Free at huggingface.co/settings/tokens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Erhöht Download-Rate-Limits. Kostenlos unter huggingface.co/settings/tokens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション。ダウンロードレート制限を高めます。huggingface.co/settings/tokensで無料で取得可能です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。提高下载速率限制。在 huggingface.co/settings/tokens 免费获取。"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Gemma 4 E2B/E4B 4-bit models are recommended. Smaller models need less memory but follow instructions less reliably. Larger variants may fail depending on hardware.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 4 E2B/E4B 4-bit Modelle sind empfohlen. Kleinere Modelle brauchen weniger Arbeitsspeicher, befolgen Anweisungen aber weniger zuverlässig. Größere Varianten können je nach Hardware fehlschlagen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 4 E2B/E4B 4-bitモデルが推奨されます。小さいモデルは必要なメモリが少ない一方、指示に従う精度が下がります。大きいバリアントはハードウェアによっては失敗する場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐使用 Gemma 4 E2B/E4B 4-bit 模型。较小的模型占用内存更少，但遵循指令的可靠性较低。较大的变体可能因硬件而无法运行。"
          }
        }
      }
    },
    "Try anyway": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem versuchen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それでも試す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍要尝试"
          }
        }
      }
    },
    "Unload": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载"
          }
        }
      }
    },
    "Loads on demand": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird bei Bedarf geladen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要時に読み込み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需加载"
          }
        }
      }
    },
    "Auto-unload model is set to Immediate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Modell automatisch entladen“ steht auf „Sofort“."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モデルを自動でアンロード」が「すぐに」に設定されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动卸载模型”已设为“立即”。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
