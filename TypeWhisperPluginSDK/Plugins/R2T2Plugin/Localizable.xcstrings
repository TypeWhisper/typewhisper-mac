{
  "sourceLanguage": "en",
  "strings": {
    "audiocpp_server with a confucius4_r2t2 model in streaming mode.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "confucius4_r2t2モデルをストリーミングモードで実行するaudiocpp_server。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server mit einem confucius4_r2t2-Modell im Streaming-Modus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 confucius4_r2t2 模型（流式模式）的 audiocpp_server。"
          }
        }
      }
    },
    "Audio is streamed as 16 kHz PCM only to the audio.cpp server configured here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は16 kHz PCM形式で、ここで設定したaudio.cppサーバーにのみストリーミング送信されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird als 16-kHz-PCM nur an den hier eingestellten audio.cpp-Server gestreamt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频以 16 kHz PCM 流式传输，仅发送到此处配置的 audio.cpp 服务器。"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済み"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接"
          }
        }
      }
    },
    "Model ID": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルID"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell-ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型 ID"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Server URL": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーURL"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server-URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器 URL"
          }
        }
      }
    },
    "Test Connection": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続をテスト"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung testen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试连接"
          }
        }
      }
    },
    "The \"id\" of the model entry in the server config.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー設定内のモデル項目の「id」。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die \"id\" des Modelleintrags in der Server-Konfiguration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器配置中模型条目的 \"id\"。"
          }
        }
      }
    },
    "%@ (recommended)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (推奨)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (empfohlen)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（推荐）"
          }
        }
      }
    },
    "audiocpp_server %@ is running on 127.0.0.1:%@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@は127.0.0.1:%@で実行中です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ läuft auf 127.0.0.1:%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ 正在 127.0.0.1:%@ 上运行。"
          }
        }
      }
    },
    "audiocpp_server %@ starts with the first dictation and restarts if it stops.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@は最初の音声入力時に起動し、停止した場合は再起動します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ startet mit dem ersten Diktat und wird neu gestartet, falls er beendet wird."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ 会在第一次听写时启动，停止后会自动重启。"
          }
        }
      }
    },
    "Built-in": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵"
          }
        },
        "de": {
