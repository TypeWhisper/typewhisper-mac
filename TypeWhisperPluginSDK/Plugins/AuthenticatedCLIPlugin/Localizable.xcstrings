    "Best-effort integration": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Best-Effort-Integration"}},"es":{"stringUnit":{"state":"translated","value":"Integración sin garantías"}},"ja":{"stringUnit":{"state":"translated","value":"ベストエフォート統合"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尽力而为的集成"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"盡力而為的整合"}}}},
    "Check again": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erneut prüfen"}},"es":{"stringUnit":{"state":"translated","value":"Volver a comprobar"}},"ja":{"stringUnit":{"state":"translated","value":"再確認"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检查"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新檢查"}}}},
    "Check failed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Prüfung fehlgeschlagen"}},"es":{"stringUnit":{"state":"translated","value":"Error en la comprobación"}},"ja":{"stringUnit":{"state":"translated","value":"確認に失敗"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查失败"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查失敗"}}}},
    "Checking…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird geprüft…"}},"es":{"stringUnit":{"state":"translated","value":"Comprobando…"}},"ja":{"stringUnit":{"state":"translated","value":"確認中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在檢查…"}}}},
    "Choose": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir"}},"ja":{"stringUnit":{"state":"translated","value":"選択"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇"}}}},
    "Choose CLI executable": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"CLI-Programm auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir el ejecutable de la CLI"}},"ja":{"stringUnit":{"state":"translated","value":"CLI実行ファイルを選択"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择 CLI 可执行文件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇 CLI 可執行檔案"}}}},
    "Choose…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Auswählen…"}},"es":{"stringUnit":{"state":"translated","value":"Elegir…"}},"ja":{"stringUnit":{"state":"translated","value":"選択…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇…"}}}},
    "CLI default": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"CLI-Standard"}},"es":{"stringUnit":{"state":"translated","value":"Predeterminado de la CLI"}},"ja":{"stringUnit":{"state":"translated","value":"CLIのデフォルト"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CLI 默认值"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"CLI 預設值"}}}},
    "CLI documentation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"CLI-Dokumentation"}},"es":{"stringUnit":{"state":"translated","value":"Documentación de la CLI"}},"ja":{"stringUnit":{"state":"translated","value":"CLIドキュメント"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CLI 文档"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"CLI 文件"}}}},
    "Currently free": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Derzeit kostenlos"}},"es":{"stringUnit":{"state":"translated","value":"Gratis por ahora"}},"ja":{"stringUnit":{"state":"translated","value":"現在無料"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前免费"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前免費"}}}},
    "Default effort": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Standard-Effort"}},"es":{"stringUnit":{"state":"translated","value":"Esfuerzo predeterminado"}},"ja":{"stringUnit":{"state":"translated","value":"デフォルトのエフォート"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认推理强度"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"預設推理強度"}}}},
    "Executable": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Programm"}},"es":{"stringUnit":{"state":"translated","value":"Ejecutable"}},"ja":{"stringUnit":{"state":"translated","value":"実行ファイル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可执行文件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可執行檔案"}}}},
    "Free for a limited time": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeitlich begrenzt kostenlos"}},"es":{"stringUnit":{"state":"translated","value":"Gratis por tiempo limitado"}},"ja":{"stringUnit":{"state":"translated","value":"期間限定で無料"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"限时免费"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"限時免費"}}}},
    "High": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Hoch"}},"es":{"stringUnit":{"state":"translated","value":"Alto"}},"ja":{"stringUnit":{"state":"translated","value":"高"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"高"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"高"}}}},
    "Incompatible": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht kompatibel"}},"es":{"stringUnit":{"state":"translated","value":"Incompatible"}},"ja":{"stringUnit":{"state":"translated","value":"互換性なし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不兼容"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"不相容"}}}},
    "Installed and authenticated.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Installiert und angemeldet."}},"es":{"stringUnit":{"state":"translated","value":"Instalada y con sesión iniciada."}},"ja":{"stringUnit":{"state":"translated","value":"インストール済みで認証されています。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装并已登录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已安裝並已登入。"}}}},
    "Low": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Niedrig"}},"es":{"stringUnit":{"state":"translated","value":"Bajo"}},"ja":{"stringUnit":{"state":"translated","value":"低"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"低"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"低"}}}},
    "Max": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maximum"}},"es":{"stringUnit":{"state":"translated","value":"Máximo"}},"ja":{"stringUnit":{"state":"translated","value":"最大"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最大"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最大"}}}},
    "Medium": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mittel"}},"es":{"stringUnit":{"state":"translated","value":"Medio"}},"ja":{"stringUnit":{"state":"translated","value":"中"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"中"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"中"}}}},
    "Minimal": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Minimal"}},"es":{"stringUnit":{"state":"translated","value":"Mínimo"}},"ja":{"stringUnit":{"state":"translated","value":"最小"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最小"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最小"}}}},
    "Models and model-specific effort levels are loaded from the signed-in Codex CLI and refreshed automatically.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Modelle und modellspezifische Effort-Stufen werden aus der angemeldeten Codex-CLI geladen und automatisch aktualisiert."}},"es":{"stringUnit":{"state":"translated","value":"Los modelos y los niveles de esfuerzo de cada modelo se cargan desde la CLI de Codex con la sesión iniciada y se actualizan automáticamente."}},"ja":{"stringUnit":{"state":"translated","value":"モデルとモデル固有のエフォートレベルは、サインイン済みのCodex CLIから読み込まれ、自動的に更新されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"模型及各模型对应的推理强度级别会从已登录的 Codex CLI 加载，并自动刷新。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"模型及各模型對應的推理強度級別會從已登入的 Codex CLI 載入，並自動重新整理。"}}}},
    "Models are loaded from the signed-in Antigravity CLI. Effort can be set to Low, Medium, or High.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Modelle werden aus der angemeldeten Antigravity-CLI geladen. Effort kann auf Niedrig, Mittel oder Hoch gesetzt werden."}},"es":{"stringUnit":{"state":"translated","value":"Los modelos se cargan desde la CLI de Antigravity con la sesión iniciada. El esfuerzo se puede ajustar en Bajo, Medio o Alto."}},"ja":{"stringUnit":{"state":"translated","value":"モデルはサインイン済みのAntigravity CLIから読み込まれます。エフォートは低、中、高に設定できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"模型从已登录的 Antigravity CLI 加载。推理强度可设为低、中或高。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"模型從已登入的 Antigravity CLI 載入。推理強度可設為低、中或高。"}}}},
    "Free models are loaded dynamically from OpenCode Zen. Offers can change or end at any time.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kostenlose Modelle werden dynamisch aus OpenCode Zen geladen. Angebote können sich jederzeit ändern oder enden."}},"es":{"stringUnit":{"state":"translated","value":"Los modelos gratuitos se cargan dinámicamente desde OpenCode Zen. Las ofertas pueden cambiar o terminar en cualquier momento."}},"ja":{"stringUnit":{"state":"translated","value":"無料モデルはOpenCode Zenから動的に読み込まれます。提供内容はいつでも変更または終了する場合があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"免费模型从 OpenCode Zen 动态加载。优惠可能随时变更或结束。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"免費模型從 OpenCode Zen 動態載入。優惠可能隨時變更或結束。"}}}},
    "Not installed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht installiert"}},"es":{"stringUnit":{"state":"translated","value":"No instalada"}},"ja":{"stringUnit":{"state":"translated","value":"未インストール"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未安装"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未安裝"}}}},
    "Not live-tested": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht live getestet"}},"es":{"stringUnit":{"state":"translated","value":"Sin probar en vivo"}},"ja":{"stringUnit":{"state":"translated","value":"ライブテスト未実施"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未经实际测试"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未經實際測試"}}}},
    "Only the workflow instruction and transcript text are sent. Each request runs non-interactively in a temporary folder with tools, sessions, project rules, and update checks disabled where the CLI supports it.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gesendet werden nur die Workflow-Anweisung und der Transkripttext. Jede Anfrage läuft nicht interaktiv in einem temporären Ordner; Tools, Sitzungen, Projektregeln und Update-Prüfungen werden deaktiviert, soweit die CLI dies unterstützt."}},"es":{"stringUnit":{"state":"translated","value":"Solo se envían la instrucción del flujo de trabajo y el texto de la transcripción. Cada solicitud se ejecuta de forma no interactiva en una carpeta temporal, con las herramientas, las sesiones, las reglas del proyecto y las comprobaciones de actualizaciones desactivadas cuando la CLI lo permite."}},"ja":{"stringUnit":{"state":"translated","value":"送信されるのはワークフローの指示と文字起こしテキストだけです。各リクエストは一時フォルダで非対話的に実行され、CLIが対応している場合はツール、セッション、プロジェクトルール、更新確認が無効になります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅发送工作流指令和转录文本。每个请求都会在临时文件夹中以非交互方式运行；在 CLI 支持的情况下，会禁用工具、会话、项目规则和更新检查。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"僅傳送工作流程指令和轉錄文字。每個請求都會在臨時資料夾中以非互動方式執行；在 CLI 支援的情況下，會停用工具、會話、專案規則和更新檢查。"}}}},
    "OpenAI account via Codex": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"OpenAI-Konto über Codex"}},"es":{"stringUnit":{"state":"translated","value":"Cuenta de OpenAI mediante Codex"}},"ja":{"stringUnit":{"state":"translated","value":"Codex経由のOpenAIアカウント"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过 Codex 使用 OpenAI 账户"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"透過 Codex 使用 OpenAI 帳戶"}}}},
    "Free OpenCode Zen models via your existing login": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kostenlose OpenCode-Zen-Modelle über deine bestehende Anmeldung"}},"es":{"stringUnit":{"state":"translated","value":"Modelos gratuitos de OpenCode Zen con tu sesión actual"}},"ja":{"stringUnit":{"state":"translated","value":"既存のログインによる無料OpenCode Zenモデル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过你现有的登录使用免费的 OpenCode Zen 模型"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"透過你現有的登入使用免費的 OpenCode Zen 模型"}}}},
    "Ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereit"}},"es":{"stringUnit":{"state":"translated","value":"Lista"}},"ja":{"stringUnit":{"state":"translated","value":"準備完了"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"就绪"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"就緒"}}}},
    "Review Zen privacy and pricing": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zen-Datenschutz und Preise prüfen"}},"es":{"stringUnit":{"state":"translated","value":"Revisar la privacidad y los precios de Zen"}},"ja":{"stringUnit":{"state":"translated","value":"Zenのプライバシーと料金を確認"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看 Zen 隐私政策和价格"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢視 Zen 隱私政策和價格"}}}},
    "Setup guide": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einrichtungsanleitung"}},"es":{"stringUnit":{"state":"translated","value":"Guía de configuración"}},"ja":{"stringUnit":{"state":"translated","value":"セットアップガイド"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置指南"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"設定指南"}}}},
    "Sign-in required": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Anmeldung erforderlich"}},"es":{"stringUnit":{"state":"translated","value":"Se necesita iniciar sesión"}},"ja":{"stringUnit":{"state":"translated","value":"サインインが必要"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要登录"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要登入"}}}},
    "Some free OpenCode Zen models may use prompts and completions for training. Do not send personal or confidential data unless the selected model's terms allow it.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einige kostenlose OpenCode-Zen-Modelle dürfen Prompts und Antworten zum Training verwenden. Sende keine persönlichen oder vertraulichen Daten, sofern die Bedingungen des gewählten Modells dies nicht erlauben."}},"es":{"stringUnit":{"state":"translated","value":"Algunos modelos gratuitos de OpenCode Zen pueden usar los prompts y las respuestas para entrenamiento. No envíes datos personales o confidenciales a menos que las condiciones del modelo seleccionado lo permitan."}},"ja":{"stringUnit":{"state":"translated","value":"一部の無料OpenCode Zenモデルでは、プロンプトと回答が学習に使用される場合があります。選択したモデルの条件で許可されていない限り、個人情報や機密情報を送信しないでください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分免费的 OpenCode Zen 模型可能会使用提示词和生成内容进行训练。除非所选模型的条款允许，否则请勿发送个人或机密数据。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"部分免費的 OpenCode Zen 模型可能會使用提示詞和生成內容進行訓練。除非所選模型的條款允許，否則請勿傳送個人或機密資料。"}}}},
    "The Antigravity model list could not be refreshed. The last cached list remains available.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Antigravity-Modellliste konnte nicht aktualisiert werden. Die zuletzt gespeicherte Liste bleibt verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo actualizar la lista de modelos de Antigravity. La última lista guardada sigue disponible."}},"ja":{"stringUnit":{"state":"translated","value":"Antigravityのモデル一覧を更新できませんでした。最後に保存された一覧は引き続き使用できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法刷新 Antigravity 模型列表。上次缓存的列表仍可使用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法重新整理 Antigravity 模型清單。上次快取的清單仍可使用。"}}}},
    "The Codex model list could not be refreshed. The last cached list remains available.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Codex-Modellliste konnte nicht aktualisiert werden. Die zuletzt gespeicherte Liste bleibt verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo actualizar la lista de modelos de Codex. La última lista guardada sigue disponible."}},"ja":{"stringUnit":{"state":"translated","value":"Codexのモデル一覧を更新できませんでした。最後に保存された一覧は引き続き使用できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法刷新 Codex 模型列表。上次缓存的列表仍可使用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法重新整理 Codex 模型清單。上次快取的清單仍可使用。"}}}},
    "The OpenCode Zen model list could not be refreshed. The last cached list remains available.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die OpenCode-Zen-Modellliste konnte nicht aktualisiert werden. Die zuletzt gespeicherte Liste bleibt verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo actualizar la lista de modelos de OpenCode Zen. La última lista guardada sigue disponible."}},"ja":{"stringUnit":{"state":"translated","value":"OpenCode Zenのモデル一覧を更新できませんでした。最後に保存された一覧は引き続き使用できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法刷新 OpenCode Zen 模型列表。上次缓存的列表仍可使用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法重新整理 OpenCode Zen 模型清單。上次快取的清單仍可使用。"}}}},
    "Support follows the documented Antigravity headless CLI contract. No signed-in installation was available for a live test.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Unterstützung folgt dem dokumentierten Headless-CLI-Vertrag von Antigravity. Für einen Live-Test war keine angemeldete Installation verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"La compatibilidad sigue el contrato documentado de la CLI sin interfaz de Antigravity. No había ninguna instalación con sesión iniciada disponible para probarla en vivo."}},"ja":{"stringUnit":{"state":"translated","value":"サポートは文書化されたAntigravityヘッドレスCLIの仕様に準拠しています。ライブテストに使用できるサインイン済みの環境はありませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此支持基于 Antigravity 文档中的无头 CLI 约定。目前没有已登录的安装可用于实际测试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此支援基於 Antigravity 文件中的無頭 CLI 約定。目前沒有已登入的安裝可用於實際測試。"}}}},
    "The CLI is installed, but no signed-in account was detected.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die CLI ist installiert, aber es wurde kein angemeldetes Konto erkannt."}},"es":{"stringUnit":{"state":"translated","value":"La CLI está instalada, pero no se detectó ninguna cuenta con sesión iniciada."}},"ja":{"stringUnit":{"state":"translated","value":"CLIはインストールされていますが、サインイン済みアカウントが見つかりません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CLI 已安装，但未检测到已登录的账户。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"CLI 已安裝，但未偵測到已登入的帳戶。"}}}},
    "The CLI was not found in common installation locations.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die CLI wurde an den üblichen Installationsorten nicht gefunden."}},"es":{"stringUnit":{"state":"translated","value":"No se encontró la CLI en las ubicaciones de instalación habituales."}},"ja":{"stringUnit":{"state":"translated","value":"一般的なインストール先にCLIが見つかりません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在常见安装位置未找到该 CLI。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在常見安裝位置未找到該 CLI。"}}}},
    "Ultracode": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ultracode"}},"es":{"stringUnit":{"state":"translated","value":"Ultracode"}},"ja":{"stringUnit":{"state":"translated","value":"ウルトラコード"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Ultracode"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Ultracode"}}}},
    "Use automatic detection": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatische Erkennung verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar la detección automática"}},"ja":{"stringUnit":{"state":"translated","value":"自動検出を使用"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用自动检测"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用自動偵測"}}}},
    "Use the accounts already signed in to supported provider CLIs. No separate API key is stored in TypeWhisper.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verwende die Konten, mit denen du bereits in unterstützten Anbieter-CLIs angemeldet bist. TypeWhisper speichert keinen separaten API-Key."}},"es":{"stringUnit":{"state":"translated","value":"Usa las cuentas con las que ya iniciaste sesión en las CLI de proveedores compatibles. TypeWhisper no guarda ninguna clave de API aparte."}},"ja":{"stringUnit":{"state":"translated","value":"対応するプロバイダーCLIですでにサインインしているアカウントを使用します。TypeWhisperに別のAPIキーは保存されません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用已在受支持的提供商 CLI 中登录的账户。TypeWhisper 不会另外存储 API 密钥。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用已在受支援的供應商 CLI 中登入的帳戶。TypeWhisper 不會另外儲存 API 金鑰。"}}}},
