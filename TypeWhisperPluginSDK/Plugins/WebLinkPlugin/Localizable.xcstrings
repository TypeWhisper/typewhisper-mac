  "strings": {
    "Cancel": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Cancelar"}},"ja":{"stringUnit":{"state":"translated","value":"キャンセル"}},"de":{"stringUnit":{"state":"translated","value":"Abbrechen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"取消"}}}},
    "Check again": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Volver a comprobar"}},"ja":{"stringUnit":{"state":"translated","value":"再確認"}},"de":{"stringUnit":{"state":"translated","value":"Erneut prüfen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检查"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新檢查"}}}},
    "Download audio from a supported web link and pass it to TypeWhisper's regular file-transcription queue.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Descarga el audio de un enlace web compatible y lo envía a la cola normal de transcripción de archivos de TypeWhisper."}},"ja":{"stringUnit":{"state":"translated","value":"対応するWebリンクから音声をダウンロードし、TypeWhisperの通常のファイル文字起こし待ちの一覧に追加します。"}},"de":{"stringUnit":{"state":"translated","value":"Lädt Audio aus einem unterstützten Weblink und übergibt es an die normale Dateitranskriptions-Warteschlange von TypeWhisper."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从受支持的网页链接下载音频，并将其添加到 TypeWhisper 的常规文件转录队列。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"從受支援的網頁連結下載音訊，並將其新增到 TypeWhisper 的常規檔案轉錄佇列。"}}}},
    "Download complete": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Descarga completada"}},"ja":{"stringUnit":{"state":"translated","value":"ダウンロード完了"}},"de":{"stringUnit":{"state":"translated","value":"Download abgeschlossen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载完成"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下載完成"}}}},
    "Downloading media…": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Descargando el contenido…"}},"ja":{"stringUnit":{"state":"translated","value":"メディアをダウンロード中…"}},"de":{"stringUnit":{"state":"translated","value":"Medium wird heruntergeladen…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在下载媒体…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在下載媒體…"}}}},
    "Helper tools": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Herramientas auxiliares"}},"ja":{"stringUnit":{"state":"translated","value":"補助ツール"}},"de":{"stringUnit":{"state":"translated","value":"Hilfsprogramme"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"辅助工具"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"輔助工具"}}}},
    "Homebrew found at %@.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Se encontró Homebrew en %@."}},"ja":{"stringUnit":{"state":"translated","value":"%@にHomebrewが見つかりました。"}},"de":{"stringUnit":{"state":"translated","value":"Homebrew wurde unter %@ gefunden."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 %@ 找到 Homebrew。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在 %@ 找到 Homebrew。"}}}},
    "Homebrew was not found. Install the helper tools manually or install Homebrew first.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"No se encontró Homebrew. Instala las herramientas auxiliares manualmente o instala Homebrew primero."}},"ja":{"stringUnit":{"state":"translated","value":"Homebrewが見つかりません。補助ツールを手動でインストールするか、先にHomebrewをインストールしてください。"}},"de":{"stringUnit":{"state":"translated","value":"Homebrew wurde nicht gefunden. Installiere die Hilfsprogramme manuell oder zuerst Homebrew."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未找到 Homebrew。请手动安装辅助工具，或先安装 Homebrew。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未找到 Homebrew。請手動安裝輔助工具，或先安裝 Homebrew。"}}}},
    "Homebrew was not found. Install yt-dlp and ffmpeg manually, then check again.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"No se encontró Homebrew. Instala yt-dlp y ffmpeg manualmente y vuelve a comprobarlo."}},"ja":{"stringUnit":{"state":"translated","value":"Homebrewが見つかりません。yt-dlpとffmpegを手動でインストールしてから、再確認してください。"}},"de":{"stringUnit":{"state":"translated","value":"Homebrew wurde nicht gefunden. Installiere yt-dlp und ffmpeg manuell und prüfe danach erneut."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未找到 Homebrew。请手动安装 yt-dlp 和 ffmpeg，然后重新检查。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未找到 Homebrew。請手動安裝 yt-dlp 和 ffmpeg，然後重新檢查。"}}}},
    "Homebrew will download and install: %@": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Homebrew descargará e instalará: %@"}},"ja":{"stringUnit":{"state":"translated","value":"Homebrewが次をダウンロードしてインストールします：%@"}},"de":{"stringUnit":{"state":"translated","value":"Homebrew lädt Folgendes herunter und installiert es: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Homebrew 将下载并安装：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Homebrew 將下載並安裝：%@"}}}},
    "Homebrew could not install the helper tools.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Homebrew no pudo instalar las herramientas auxiliares."}},"ja":{"stringUnit":{"state":"translated","value":"Homebrewで補助ツールをインストールできませんでした。"}},"de":{"stringUnit":{"state":"translated","value":"Homebrew konnte die Hilfsprogramme nicht installieren."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Homebrew 无法安装辅助工具。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Homebrew 無法安裝輔助工具。"}}}},
    "Install helper tools?": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"¿Instalar las herramientas auxiliares?"}},"ja":{"stringUnit":{"state":"translated","value":"補助ツールをインストールしますか？"}},"de":{"stringUnit":{"state":"translated","value":"Hilfsprogramme installieren?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装辅助工具？"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安裝輔助工具？"}}}},
    "Install missing tools with Homebrew": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Instalar las herramientas que faltan con Homebrew"}},"ja":{"stringUnit":{"state":"translated","value":"不足しているツールをHomebrewでインストール"}},"de":{"stringUnit":{"state":"translated","value":"Fehlende Programme mit Homebrew installieren"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 Homebrew 安装缺少的工具"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用 Homebrew 安裝缺少的工具"}}}},
    "Install with Homebrew": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Instalar con Homebrew"}},"ja":{"stringUnit":{"state":"translated","value":"Homebrewでインストール"}},"de":{"stringUnit":{"state":"translated","value":"Mit Homebrew installieren"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 Homebrew 安装"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用 Homebrew 安裝"}}}},
    "Missing helper tools: %@. Open the add-on settings to install them.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Faltan herramientas auxiliares: %@. Abre los ajustes del complemento para instalarlas."}},"ja":{"stringUnit":{"state":"translated","value":"不足している補助ツール: %@。プラグイン設定を開いてインストールしてください。"}},"de":{"stringUnit":{"state":"translated","value":"Fehlende Hilfsprogramme: %@. Öffne die Add-on-Einstellungen, um sie zu installieren."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缺少辅助工具：%@。请打开此附加组件的设置进行安装。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"缺少輔助工具：%@。請開啟此附加元件的設定進行安裝。"}}}},
    "No helper tool is downloaded without confirmation. Homebrew verifies and manages the installed packages.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"No se descarga ninguna herramienta auxiliar sin confirmación. Homebrew verifica y gestiona los paquetes instalados."}},"ja":{"stringUnit":{"state":"translated","value":"確認なしで補助ツールをダウンロードすることはありません。Homebrewがインストール済みパッケージを検証・管理します。"}},"de":{"stringUnit":{"state":"translated","value":"Kein Hilfsprogramm wird ohne Bestätigung heruntergeladen. Homebrew prüft und verwaltet die installierten Pakete."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未经确认不会下载任何辅助工具。Homebrew 会验证并管理已安装的软件包。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未經確認不會下載任何輔助工具。Homebrew 會驗證並管理已安裝的軟體包。"}}}},
    "Installed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Installiert"}},"es":{"stringUnit":{"state":"translated","value":"Instalados"}},"ja":{"stringUnit":{"state":"translated","value":"インストール済み"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已安裝"}}}},
    "Not installed": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"No instalado"}},"ja":{"stringUnit":{"state":"translated","value":"未インストール"}},"de":{"stringUnit":{"state":"translated","value":"Nicht installiert"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未安装"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未安裝"}}}},
    "Open Homebrew setup": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Abrir la configuración de Homebrew"}},"ja":{"stringUnit":{"state":"translated","value":"Homebrewのセットアップを開く"}},"de":{"stringUnit":{"state":"translated","value":"Homebrew-Einrichtung öffnen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 Homebrew 设置"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟 Homebrew 設定"}}}},
    "Ready": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Listo"}},"ja":{"stringUnit":{"state":"translated","value":"準備完了"}},"de":{"stringUnit":{"state":"translated","value":"Bereit"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"就绪"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"就緒"}}}},
    "The download did not produce a supported audio or video file.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"La descarga no generó ningún archivo de audio o video compatible."}},"ja":{"stringUnit":{"state":"translated","value":"ダウンロード結果に、対応する音声・動画ファイルがありませんでした。"}},"de":{"stringUnit":{"state":"translated","value":"Der Download hat keine unterstützte Audio- oder Videodatei erzeugt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载未生成受支持的音频或视频文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下載未生成受支援的音訊或影片檔案。"}}}},
    "The link must be a valid HTTP or HTTPS URL.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"El enlace debe ser una URL HTTP o HTTPS válida."}},"ja":{"stringUnit":{"state":"translated","value":"有効なHTTPまたはHTTPSのURLを入力してください。"}},"de":{"stringUnit":{"state":"translated","value":"Der Link muss eine gültige HTTP- oder HTTPS-URL sein."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"链接必须是有效的 HTTP 或 HTTPS URL。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連結必須是有效的 HTTP 或 HTTPS URL。"}}}},
    "The media download failed.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Error al descargar el contenido."}},"ja":{"stringUnit":{"state":"translated","value":"メディアのダウンロードに失敗しました。"}},"de":{"stringUnit":{"state":"translated","value":"Der Medien-Download ist fehlgeschlagen."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"媒体下载失败。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"媒體下載失敗。"}}}},
    "The Web Link add-on is not active.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"El complemento Enlace web no está activo."}},"ja":{"stringUnit":{"state":"translated","value":"Web Linkプラグインが有効になっていません。"}},"de":{"stringUnit":{"state":"translated","value":"Das Weblink-Add-on ist nicht aktiv."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Web Link 附加组件未启用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Web Link 附加元件未啟用。"}}}},
    "Transcribe Web Link…": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Transcribir enlace web…"}},"ja":{"stringUnit":{"state":"translated","value":"Webリンクを文字起こし…"}},"de":{"stringUnit":{"state":"translated","value":"Weblink transkribieren…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转录网页链接…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"轉錄網頁連結…"}}}},
    "Web Link": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Enlace web"}},"ja":{"stringUnit":{"state":"translated","value":"Webリンク"}},"de":{"stringUnit":{"state":"translated","value":"Weblink"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网页链接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"網頁連結"}}}},
    "Web Link Transcription": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Transcripción de enlaces web"}},"ja":{"stringUnit":{"state":"translated","value":"Webリンクの文字起こし"}},"de":{"stringUnit":{"state":"translated","value":"Weblink-Transkription"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网页链接转录"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"網頁連結轉錄"}}}},
    "Web Link Transcription Settings…": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Ajustes de transcripción de enlaces web…"}},"ja":{"stringUnit":{"state":"translated","value":"Web Link Transcriptionの設定…"}},"de":{"stringUnit":{"state":"translated","value":"Weblink-Transkriptionseinstellungen…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网页链接转录设置…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"網頁連結轉錄設定…"}}}},
    "Add Link": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Agregar enlace"}},"ja":{"stringUnit":{"state":"translated","value":"リンクを追加"}},"de":{"stringUnit":{"state":"translated","value":"Link hinzufügen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加链接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增連結"}}}},
    "Open add-on settings…": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Abrir los ajustes del complemento…"}},"ja":{"stringUnit":{"state":"translated","value":"プラグイン設定を開く…"}},"de":{"stringUnit":{"state":"translated","value":"Add-on-Einstellungen öffnen…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开附加组件设置…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟附加元件設定…"}}}},
    "Paste a supported video or audio link. The add-on downloads its audio and adds it to TypeWhisper's transcription queue.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Pega un enlace de video o audio compatible. El complemento descarga su audio y lo agrega a la cola de transcripción de TypeWhisper."}},"ja":{"stringUnit":{"state":"translated","value":"対応する動画・音声のリンクを貼り付けてください。プラグインが音声をダウンロードし、TypeWhisperの文字起こし待ちの一覧に追加します。"}},"de":{"stringUnit":{"state":"translated","value":"Füge einen unterstützten Video- oder Audio-Link ein. Das Add-on lädt die Audiospur herunter und fügt sie der Transkriptionswarteschlange von TypeWhisper hinzu."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"粘贴受支持的视频或音频链接。附加组件会下载其音轨并添加到 TypeWhisper 的转录队列。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"貼上受支援的影片或音訊連結。附加元件會下載其音軌並新增到 TypeWhisper 的轉錄佇列。"}}}},
    "Paste a video or audio link": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Pega un enlace de video o audio"}},"ja":{"stringUnit":{"state":"translated","value":"動画・音声のリンクを貼り付け"}},"de":{"stringUnit":{"state":"translated","value":"Video- oder Audio-Link einfügen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"粘贴视频或音频链接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"貼上影片或音訊連結"}}}},
    "Preparing web link download": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Preparando la descarga del enlace web"}},"ja":{"stringUnit":{"state":"translated","value":"Webリンクのダウンロードを準備中"}},"de":{"stringUnit":{"state":"translated","value":"Weblink-Download wird vorbereitet"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在准备网页链接下载"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在準備網頁連結下載"}}}},
    "The downloaded media was added to the transcription queue.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"El contenido descargado se agregó a la cola de transcripción."}},"ja":{"stringUnit":{"state":"translated","value":"ダウンロードしたメディアを文字起こし待ちの一覧に追加しました。"}},"de":{"stringUnit":{"state":"translated","value":"Das heruntergeladene Medium wurde der Transkriptionswarteschlange hinzugefügt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载的媒体已添加到转录队列。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下載的媒體已新增到轉錄佇列。"}}}},
    "The Web Link add-on is not ready.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"El complemento Enlace web no está listo."}},"ja":{"stringUnit":{"state":"translated","value":"Web Linkプラグインの準備ができていません。"}},"de":{"stringUnit":{"state":"translated","value":"Das Weblink-Add-on ist noch nicht bereit."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Web Link 附加组件尚未就绪。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Web Link 附加元件尚未就緒。"}}}},
    "Transcribe audio from a web link": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"Transcribir el audio de un enlace web"}},"ja":{"stringUnit":{"state":"translated","value":"Webリンクの音声を文字起こし"}},"de":{"stringUnit":{"state":"translated","value":"Audio aus einem Weblink transkribieren"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转录网页链接中的音频"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"轉錄網頁連結中的音訊"}}}},
    "TypeWhisper could not add the downloaded media to the transcription queue.": {"localizations":{"es":{"stringUnit":{"state":"translated","value":"TypeWhisper no pudo agregar el contenido descargado a la cola de transcripción."}},"ja":{"stringUnit":{"state":"translated","value":"TypeWhisperがダウンロードしたメディアを文字起こし待ちの一覧に追加できませんでした。"}},"de":{"stringUnit":{"state":"translated","value":"TypeWhisper konnte das heruntergeladene Medium nicht zur Transkriptionswarteschlange hinzufügen."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"TypeWhisper 无法将下载的媒体添加到转录队列。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"TypeWhisper 無法將下載的媒體新增到轉錄佇列。"}}}}
