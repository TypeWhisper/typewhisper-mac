          }
        }
      }
    },
    "Your Apple account keeps Polar and App Store entitlements available on Mac and iPhone." : {
      "comment" : "A description of the benefits of using a premium account.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta de Apple mantiene disponibles los accesos de Polar y App Store en el Mac y el iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 Apple 账户可让 Polar 和 App Store 权益在 Mac 和 iPhone 上保持可用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleアカウントを使って、PolarとApp Storeの利用権をMacとiPhoneで共有できます。"
          }
        }
      }
    },
    "Your changes will be lost if you don’t save them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderungen gehen verloren, wenn du sie nicht sicherst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perderás los cambios si no los guardas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存しない場合、変更内容は失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不保存，你的更改将会丢失。"
          }
        }
      }
    },
    "Your existing shortcut will stay unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu atajo actual no cambiará."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のショートカットは変更されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现有快捷键不会改变。"
          }
        }
      }
    },
    "Your statistics will appear here after your first transcription." : {
      "localizations" : {
        "de" : {
