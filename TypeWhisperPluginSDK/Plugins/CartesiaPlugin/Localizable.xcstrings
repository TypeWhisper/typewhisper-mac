    "Spoken Language is the source audio language. Choose English only when the audio itself is English.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesprochene Sprache ist die Sprache der Audioquelle. Wähle Englisch nur, wenn die Aufnahme selbst Englisch ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma hablado es el idioma del audio de origen. Elige inglés solo cuando el propio audio esté en inglés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話し言葉は音声ソースの言語です。音声自体が英語の場合のみ英語を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口语语言是源音频的语言。仅当音频本身为英语时才选择英语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "口語語言是來源音訊的語言。僅當音訊本身為英語時才選擇英語。"
          }
        }
      }
    },
