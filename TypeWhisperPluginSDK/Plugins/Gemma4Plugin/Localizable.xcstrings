{
  "sourceLanguage": "en",
  "strings": {
    "Download & Load": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden & Aktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み & 有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并加载"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Delete cached model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischengespeichertes Modell löschen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされたモデルを削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除缓存的模型"
          }
        }
      }
    },
    "Download timed out while fetching Gemma 4 from Hugging Face. Please retry. Adding an optional HuggingFace token in this plugin can also increase download rate limits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download von Gemma 4 von Hugging Face hat zu lange gedauert. Bitte erneut versuchen. Ein optionaler HuggingFace-Token in diesem Plugin kann die Download-Rate-Limits erhoehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging FaceからGemma 4のダウンロードが長すぎました。再度試してください。このプラグインでオプションのHuggingFaceトークンを使用すると、ダウンロードレート制限を高めることができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Hugging Face 获取 Gemma 4 时下载超时。请重试。在此插件中添加可选的 HuggingFace 令牌也可以提高下载速率限制。"
          }
        }
      }
    },
    "Downloading %1$@ stalled at %2$@ because no additional bytes were received for five minutes. Try again. If the issue persists, delete the cached model and download it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download von %1$@ ist bei %2$@ stehen geblieben, da fünf Minuten lang keine weiteren Bytes empfangen wurden. Versuche es erneut. Wenn das Problem bestehen bleibt, lösche das zwischengespeicherte Modell und lade es erneut herunter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のダウンロードは %2$@ で停止し、5 分間新しいバイトを受信しませんでした。もう一度お試しください。問題が続く場合は、キャッシュされたモデルを削除して再度ダウンロードしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载 %1$@ 在 %2$@ 处停滞，因为五分钟内未收到更多字节。请重试。如果问题仍然存在，请删除缓存模型并重新下载。"
          }
        }
      }
    },
    "Preparing %1$@ timed out after 15 minutes (last download progress: %2$@). The downloaded model was kept; try loading it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorbereitung von %1$@ hat nach 15 Minuten das Zeitlimit erreicht (letzter Downloadfortschritt: %2$@). Das heruntergeladene Modell wurde beibehalten; versuche erneut, es zu laden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の準備は 15 分後にタイムアウトしました（最後のダウンロード進捗: %2$@）。ダウンロード済みモデルは保持されています。もう一度読み込んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备 %1$@ 在 15 分钟后超时（上次下载进度：%2$@）。已保留下载的模型，请尝试重新加载。"
          }
        }
      }
    },
    "The downloaded Gemma model cache appears incomplete or incompatible. Delete the cached model and download it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der heruntergeladene Gemma-Modellcache scheint unvollständig oder inkompatibel zu sein. Lösche das zwischengespeicherte Modell und lade es erneut herunter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードされたGemmaモデルキャッシュは不完全または互換性がないようです。キャッシュされたモデルを削除し、再度ダウンロードしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的 Gemma 模型缓存不完整或不兼容。请删除缓存模型并重新下载。"
          }
        }
      }
    },
    "HuggingFace Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HuggingFace Token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HuggingFace トークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HuggingFace 令牌"
          }
        }
      }
    },
    "Load a Gemma 4 model in Integrations before using it for prompts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade zuerst ein Gemma-4-Modell in den Integrationen, bevor du es fuer Prompts verwendest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトでGemma 4モデルを使用する前に、統合からGemma 4モデルをまず読み込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用 Gemma 4 模型处理提示词前，请在集成中加载该模型。"
          }
        }
      }
    },
    "Local LLM powered by Google Gemma 4 on Apple Silicon. No API key required.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales LLM mit Google Gemma 4 auf Apple Silicon. Kein API-Schlüssel erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon上でGoogle Gemma 4を使用したローカルLLM。APIキー不要。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Apple Silicon 上 Google Gemma 4 驱动的本地 LLM。无需 API 密钥。"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "Invalid HuggingFace Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger HuggingFace-Token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なHuggingFaceトークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效的 HuggingFace 令牌"
          }
        }
      }
    },
    "Experimental": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性"
          }
        }
      }
    },
    "Experimental. You can try it at your own risk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell. Du kannst es auf eigene Gefahr ausprobieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的です。ご自身の責任で試してみてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性功能。您可以自行尝试，风险自负。"
          }
        }
      }
    },
    "Valid HuggingFace Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gültiger HuggingFace-Token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なHuggingFaceトークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效的 HuggingFace 令牌"
          }
        }
      }
    },
    "Validating token...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token wird geprüft..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンの検証中..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证令牌..."
          }
        }
      }
    },
    "Optional. Increases download rate limits. Free at huggingface.co/settings/tokens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Erhoeht Download-Rate-Limits. Kostenlos unter huggingface.co/settings/tokens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション。ダウンロードレート制限を高めます。huggingface.co/settings/tokensで無料で取得可能です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。提高下载速率限制。在 huggingface.co/settings/tokens 免费获取。"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Gemma 4 E2B/E4B 4-bit models are recommended. Larger variants are experimental and may fail depending on hardware.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 4 E2B/E4B 4-bit Modelle sind empfohlen. Groessere Varianten sind experimentell und koennen je nach Hardware fehlschlagen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 4 E2B/E4B 4-bitモデルが推奨されます。より大きいバリアントは実験的であり、ハードウェアによっては失敗する可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议使用 Gemma 4 E2B/E4B 4 位模型。较大变体为实验性，可能因硬件配置而失败。"
          }
        }
      }
    },
    "Try anyway": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem versuchen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それでも試す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍要尝试"
          }
        }
      }
    },
    "Unload": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载"
          }
        }
      }
    }
  },
  "version": "1.0"
}
