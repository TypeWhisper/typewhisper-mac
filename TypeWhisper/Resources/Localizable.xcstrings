          }
        }
      }
    },
    "The workflow contains duplicate shortcuts." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークフローに重複したショートカットが含まれています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作流中包含重复的快捷键。"
          }
        }
      }
    },
    "the Workflow Palette" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークフローパレット"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作流面板"
          }
        }
      }
    },
    "These plugins could not be updated: %@. Successful updates remain installed. TypeWhisper was not restarted." : {
      "comment" : "An alert message listing failed plugin updates and explaining why the app did not restart. The argument is a comma-separated list of plugin names.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Plugins konnten nicht aktualisiert werden: %1$@. Erfolgreiche Updates bleiben installiert. TypeWhisper wurde nicht neu gestartet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のプラグインを更新できませんでした：%1$@。成功した更新はインストールされたままです。TypeWhisperは再起動されませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下插件无法更新：%1$@。成功的更新仍保持已安装状态。TypeWhisper 未重新启动。"
          }
        }
      }
    },
    "This engine avoids repeated live API calls and transcribes the full recording after you stop." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンはライブAPI呼び出しの繰り返しを避け、停止後に録音全体を文字起こします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎避免重复的实时 API 调用，在你停止后对完整录音进行一次性转录。"
          }
        }
      }
    },
    "This engine currently uses Dictionary Corrections only." : {
      "comment" : "Text displayed in a detail label for a dictionary engine that currently uses only dictionary corrections.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンは現在、辞書修正のみを使用しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎当前仅使用“词典纠正”功能。"
          }
        }
      }
    },
    "This engine does not support multiple language hints. It will use #1 as the spoken language." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Engine unterstützt keine mehreren Sprachhinweise. Sie verwendet Nr. 1 als gesprochene Sprache."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンは複数の言語ヒントに対応していません。1番目を話す言語として使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎不支持多语言提示，将使用列表中的第一种语言作为口语。"
          }
        }
      }
    },
    "This engine needs an extra plugin setting before Terms are applied." : {
      "comment" : "Tooltip text for the extra plugin setting required for the Terms feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンで用語を適用するには、追加のプラグイン設定が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎需要先完成额外的插件设置，才能应用术语。"
          }
        }
      }
    },
    "This engine uses a lightweight live preview that updates every few seconds. Final transcription still runs on the full recording after you stop." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンは数秒ごとに更新される軽量のライブプレビューを使用します。最終的な文字起こしは、停止後に完全な録音データに対して実行されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎使用轻量实时预览，每隔几秒更新一次。停止录音后，仍会对完整录音执行最终转录。"
          }
        }
      }
    },
    "This engine uses the ordered list as language hints." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Engine verwendet die sortierte Liste als Sprachhinweise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンは並び順どおりのリストを言語ヒントとして使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎会按列表顺序使用语言提示。"
          }
        }
      }
    },
    "This entitlement is not active." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
