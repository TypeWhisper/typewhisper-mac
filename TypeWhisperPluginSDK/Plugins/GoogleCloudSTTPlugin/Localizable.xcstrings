          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務帳戶 JSON"
          }
        }
      }
    },
    "Stored credentials are active. Paste a new JSON key above to replace them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Zugangsdaten sind aktiv. Füge oben einen neuen JSON-Schlüssel ein, um sie zu ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales guardadas están activas. Pega una clave JSON nueva arriba para reemplazarlas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの認証情報が有効です。置き換えるには上に新しいJSONキーを貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储的凭据有效。请在上面粘贴新的 JSON 密钥以替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的憑證有效。請在上面貼上新的 JSON 金鑰以替換。"
          }
        }
      }
    },
    "Test Stored Credentials": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Zugangsdaten testen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probar las credenciales guardadas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み認証情報をテスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试已存储的凭据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試已儲存的憑證"
          }
        }
      }
    },
    "The JSON could not be parsed. Paste the full Google service-account JSON file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das JSON konnte nicht gelesen werden. Füge die vollständige JSON-Datei des Google-Dienstkontos ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el JSON. Pega el archivo JSON completo de la cuenta de servicio de Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSONを解析できませんでした。GoogleサービスアカウントJSONファイル全体を貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析 JSON。请粘贴完整的 Google 服务账户 JSON 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析 JSON。請貼上完整的 Google 服務帳戶 JSON 檔案。"
          }
        }
      }
    },
    "The verification audio was rejected as too large.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodatei zur Überprüfung wurde als zu groß abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazó el audio de verificación por ser demasiado grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証用音声が大きすぎるため拒否されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证音频因过大被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證音訊因過大被拒絕。"
          }
        }
      }
    },
    "Use `default` or `command_and_search` for the broadest language coverage. The newer `latest_*` models can be more restrictive depending on language support.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
