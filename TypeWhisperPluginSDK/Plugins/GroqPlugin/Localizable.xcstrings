    "Using default models. Press Refresh to fetch all available models.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se están usando los modelos predeterminados. Presiona Actualizar para obtener todos los modelos disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのモデルを使用しています。「更新」を押すと、利用可能なすべてのモデルを取得します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmodelle werden verwendet. Klicke auf „Aktualisieren“, um alle verfügbaren Modelle abzurufen."
          }
        },
        "zh-Hans": {
