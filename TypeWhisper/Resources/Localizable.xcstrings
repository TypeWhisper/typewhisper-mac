    "A local pack with the id “%@” is already imported. The file replaces its name, terms and corrections. If the pack is on, its dictionary entries are updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein lokales Paket mit der ID „%@“ ist bereits importiert. Die Datei ersetzt seinen Namen, seine Begriffe und Korrekturen. Ist das Paket eingeschaltet, werden seine Wörterbuch-Einträge aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay un paquete local importado con el id “%@”. El archivo reemplaza su nombre, sus términos y sus correcciones. Si el paquete está activado, se actualizan sus entradas del diccionario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID「%@」のローカルパックはすでに読み込まれています。このファイルで名前、用語、修正が置き換えられます。パックがオンの場合は、辞書のエントリも更新されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID 为“%@”的本地包已导入。该文件将替换其名称、词条和修正。如果该包已开启，其词典条目也会更新。"
          }
        }
      }
    },
    "Remove “%@”?" : {
