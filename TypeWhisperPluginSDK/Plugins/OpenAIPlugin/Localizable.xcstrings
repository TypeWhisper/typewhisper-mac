    "Use your existing ChatGPT Plus/Pro or Codex login for prompt processing. Transcription and text-to-speech still require an API key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu inicio de sesión actual de ChatGPT Plus/Pro o Codex para procesar prompts. La transcripción y la conversión de texto a voz siguen requiriendo una clave de API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のChatGPT Plus/ProまたはCodexのログインでプロンプト処理を利用できます。文字起こしと読み上げには引き続きAPIキーが必要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende deine bestehende ChatGPT-Plus-/Pro- oder Codex-Anmeldung für die Prompt-Verarbeitung. Transkription und Sprachausgabe benötigen weiterhin einen API-Schlüssel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用现有的 ChatGPT Plus/Pro 或 Codex 登录来处理提示词。转录和语音合成功能仍需要 API 密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用現有的 ChatGPT Plus/Pro 或 Codex 登入來處理提示詞。轉錄和語音合成功能仍需要 API 金鑰。"
          }
        }
      }
    },
