    "Choose an entry to read its text, audio, and details." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle einen Eintrag aus, um Text, Audio und Details anzuzeigen."}},"es":{"stringUnit":{"state":"translated","value":"Elige una entrada para leer su texto, escuchar su audio y ver sus detalles."}},"ja":{"stringUnit":{"state":"translated","value":"テキスト、音声、詳細を表示する項目を選択してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一个条目以查看文本、音频和详细信息。"}}}},
    "Copy, export, complete, reopen, or delete the selected entries." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ausgewählte Einträge kopieren, exportieren, abschließen, erneut öffnen oder löschen."}},"es":{"stringUnit":{"state":"translated","value":"Copia, exporta, completa, vuelve a abrir o elimina las entradas seleccionadas."}},"ja":{"stringUnit":{"state":"translated","value":"選択した項目をコピー、書き出し、完了、再開、削除できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以复制、导出、完成、重新打开或删除所选条目。"}}}},
    "Corrections added to the dictionary" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Korrekturen zum Wörterbuch hinzugefügt"}},"es":{"stringUnit":{"state":"translated","value":"Correcciones agregadas al diccionario"}},"ja":{"stringUnit":{"state":"translated","value":"修正を辞書に追加しました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已将更正添加到词典"}}}},
    "Delete %lld Entries?" : {"localizations":{"de":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld Eintrag löschen?"}},"other":{"stringUnit":{"state":"translated","value":"%lld Einträge löschen?"}}}}},"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Delete %lld Entry?"}},"other":{"stringUnit":{"state":"translated","value":"Delete %lld Entries?"}}}}},"es":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"¿Eliminar %lld entrada?"}},"many":{"stringUnit":{"state":"translated","value":"¿Eliminar %lld entradas?"}},"other":{"stringUnit":{"state":"translated","value":"¿Eliminar %lld entradas?"}}}}},"ja":{"stringUnit":{"state":"translated","value":"%lld件の項目を削除しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除 %lld 个条目？"}}}},
    "Delete All History?" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gesamten Verlauf löschen?"}},"es":{"stringUnit":{"state":"translated","value":"¿Eliminar todo el historial?"}},"ja":{"stringUnit":{"state":"translated","value":"すべての履歴を削除しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除所有历史记录？"}}}},
    "Delete Entry?" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eintrag löschen?"}},"es":{"stringUnit":{"state":"translated","value":"¿Eliminar la entrada?"}},"ja":{"stringUnit":{"state":"translated","value":"項目を削除しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除条目？"}}}},
    "Delete History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf löschen"}},"es":{"stringUnit":{"state":"translated","value":"Eliminar historial"}},"ja":{"stringUnit":{"state":"translated","value":"履歴を削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除历史记录"}}}},
    "Download Audio" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio laden"}},"es":{"stringUnit":{"state":"translated","value":"Descargar audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声をダウンロード"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载音频"}}}},
    "Downloading and verifying audio…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio wird geladen und überprüft …"}},"es":{"stringUnit":{"state":"translated","value":"Descargando y verificando el audio…"}},"ja":{"stringUnit":{"state":"translated","value":"音声をダウンロードして検証中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在下载并验证音频…"}}}},
    "Duration" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dauer"}},"es":{"stringUnit":{"state":"translated","value":"Duración"}},"ja":{"stringUnit":{"state":"translated","value":"長さ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时长"}}}},
    "Empty transcription" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Leere Transkription"}},"es":{"stringUnit":{"state":"translated","value":"Transcripción vacía"}},"ja":{"stringUnit":{"state":"translated","value":"空の文字起こし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"空转录"}}}},
    "Enable History Sync" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlaufssync aktivieren"}},"es":{"stringUnit":{"state":"translated","value":"Activar la sincronización del historial"}},"ja":{"stringUnit":{"state":"translated","value":"履歴同期を有効にする"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用历史记录同步"}}}},
    "Enable Premium Sync first, then choose whether this Mac participates in History and Inbox sync." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviere zuerst Premium Sync und lege dann fest, ob dieser Mac Verlauf und Posteingang synchronisiert."}},"es":{"stringUnit":{"state":"translated","value":"Activa primero la sincronización Premium y luego elige si este Mac participa en la sincronización del historial y la bandeja de entrada."}},"ja":{"stringUnit":{"state":"translated","value":"まずPremium同期を有効にしてから、このMacで履歴と受信箱を同期するか選択してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先启用 Premium 同步，然后选择此 Mac 是否参与历史记录和收件箱同步。"}}}},
    "Enable Sync" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sync aktivieren"}},"es":{"stringUnit":{"state":"translated","value":"Activar sincronización"}},"ja":{"stringUnit":{"state":"translated","value":"同期を有効にする"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用同步"}}}},
    "Existing transcription text and metadata will be added to your private sync folder. Audio is synchronized only for new entries created after you enable this feature." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Vorhandene Transkriptionstexte und Metadaten werden deinem privaten Sync-Ordner hinzugefügt. Audio wird nur für neue Einträge synchronisiert, die nach der Aktivierung erstellt werden."}},"es":{"stringUnit":{"state":"translated","value":"El texto y los metadatos de las transcripciones existentes se agregarán a tu carpeta privada de sincronización. El audio solo se sincroniza para las entradas nuevas creadas después de activar esta función."}},"ja":{"stringUnit":{"state":"translated","value":"既存の文字起こしテキストとメタデータがプライベート同期フォルダに追加されます。音声は、この機能を有効にした後に作成された新しい項目だけ同期されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现有转录文本和元数据将添加到你的私人同步文件夹。仅同步启用此功能后创建的新条目的音频。"}}}},
    "Export as…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Exportieren als …"}},"es":{"stringUnit":{"state":"translated","value":"Exportar como…"}},"ja":{"stringUnit":{"state":"translated","value":"書き出す…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出为…"}}}},
    "Filter" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Filter"}},"es":{"stringUnit":{"state":"translated","value":"Filtrar"}},"ja":{"stringUnit":{"state":"translated","value":"フィルタ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"筛选"}}}},
    "Filter History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf filtern"}},"es":{"stringUnit":{"state":"translated","value":"Filtrar historial"}},"ja":{"stringUnit":{"state":"translated","value":"履歴を絞り込む"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"筛选历史记录"}}}},
    "Final" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Final"}},"es":{"stringUnit":{"state":"translated","value":"Final"}},"ja":{"stringUnit":{"state":"translated","value":"最終版"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最终版本"}}}},
    "History & Sync" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf & Sync"}},"es":{"stringUnit":{"state":"translated","value":"Historial y sincronización"}},"ja":{"stringUnit":{"state":"translated","value":"履歴と同期"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"历史记录与同步"}}}},
    "History Workspace" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlaufsarbeitsbereich"}},"es":{"stringUnit":{"state":"translated","value":"Espacio de trabajo del historial"}},"ja":{"stringUnit":{"state":"translated","value":"履歴ワークスペース"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"历史记录工作区"}}}},
    "History sync is optional on each device. Audio stays inside your selected private sync storage and downloads only when requested." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Verlaufssync ist auf jedem Gerät optional. Audio bleibt im ausgewählten privaten Sync-Speicher und wird nur bei Bedarf geladen."}},"es":{"stringUnit":{"state":"translated","value":"La sincronización del historial es opcional en cada dispositivo. El audio permanece en el almacenamiento privado de sincronización que elegiste y solo se descarga cuando lo solicitas."}},"ja":{"stringUnit":{"state":"translated","value":"履歴同期はデバイスごとに任意です。音声は選択したプライベート同期ストレージ内に保存され、必要なときだけダウンロードされます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每台设备都可单独选择是否同步历史记录。音频保留在所选的私人同步存储中，仅在需要时下载。"}}}},
    "Imported Files" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Importierte Dateien"}},"es":{"stringUnit":{"state":"translated","value":"Archivos importados"}},"ja":{"stringUnit":{"state":"translated","value":"読み込んだファイル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导入的文件"}}}},
    "Importing…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird importiert …"}},"es":{"stringUnit":{"state":"translated","value":"Importando…"}},"ja":{"stringUnit":{"state":"translated","value":"読み込み中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在导入…"}}}},
    "Inbox" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Posteingang"}},"es":{"stringUnit":{"state":"translated","value":"Bandeja de entrada"}},"ja":{"stringUnit":{"state":"translated","value":"受信箱"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收件箱"}}}},
    "Inbox is Empty" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Posteingang ist leer"}},"es":{"stringUnit":{"state":"translated","value":"La bandeja de entrada está vacía"}},"ja":{"stringUnit":{"state":"translated","value":"受信箱は空です"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收件箱为空"}}}},
    "iOS Keyboard" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"iOS-Tastatur"}},"es":{"stringUnit":{"state":"translated","value":"Teclado de iOS"}},"ja":{"stringUnit":{"state":"translated","value":"iOSキーボード"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iOS 键盘"}}}},
    "Library" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mediathek"}},"es":{"stringUnit":{"state":"translated","value":"Biblioteca"}},"ja":{"stringUnit":{"state":"translated","value":"ライブラリ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"资料库"}}}},
    "Local History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Lokaler Verlauf"}},"es":{"stringUnit":{"state":"translated","value":"Historial local"}},"ja":{"stringUnit":{"state":"translated","value":"ローカル履歴"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地历史记录"}}}},
    "Mark Complete" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Als erledigt markieren"}},"es":{"stringUnit":{"state":"translated","value":"Marcar como completado"}},"ja":{"stringUnit":{"state":"translated","value":"完了にする"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标记为已完成"}}}},
    "New captures that need attention will appear here." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Neue Aufnahmen, die deine Aufmerksamkeit benötigen, erscheinen hier."}},"es":{"stringUnit":{"state":"translated","value":"Las capturas nuevas que requieran tu atención aparecerán aquí."}},"ja":{"stringUnit":{"state":"translated","value":"確認が必要な新しいキャプチャがここに表示されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要处理的新捕获内容会显示在这里。"}}}},
    "Newest First" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Neueste zuerst"}},"es":{"stringUnit":{"state":"translated","value":"Más recientes primero"}},"ja":{"stringUnit":{"state":"translated","value":"新しい順"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最新优先"}}}},
    "No History Yet" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch kein Verlauf"}},"es":{"stringUnit":{"state":"translated","value":"Todavía no hay historial"}},"ja":{"stringUnit":{"state":"translated","value":"履歴はまだありません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚无历史记录"}}}},
    "No Results" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine Ergebnisse"}},"es":{"stringUnit":{"state":"translated","value":"No hay resultados"}},"ja":{"stringUnit":{"state":"translated","value":"結果なし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无结果"}}}},
    "No history entries match the current search and filters." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine Verlaufseinträge entsprechen der aktuellen Suche und den Filtern."}},"es":{"stringUnit":{"state":"translated","value":"Ninguna entrada del historial coincide con la búsqueda y los filtros actuales."}},"ja":{"stringUnit":{"state":"translated","value":"現在の検索条件とフィルタに一致する履歴項目はありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有历史记录符合当前搜索和筛选条件。"}}}},
    "Oldest First" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Älteste zuerst"}},"es":{"stringUnit":{"state":"translated","value":"Más antiguas primero"}},"ja":{"stringUnit":{"state":"translated","value":"古い順"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最早优先"}}}},
    "Open History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir historial"}},"ja":{"stringUnit":{"state":"translated","value":"履歴を開く"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开历史记录"}}}},
    "Open in Inbox" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Im Posteingang öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir en la bandeja de entrada"}},"ja":{"stringUnit":{"state":"translated","value":"受信箱で開く"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在收件箱中打开"}}}},
    "Origin" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ursprung"}},"es":{"stringUnit":{"state":"translated","value":"Origen"}},"ja":{"stringUnit":{"state":"translated","value":"作成元"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源"}}}},
    "Original" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Original"}},"es":{"stringUnit":{"state":"translated","value":"Original"}},"ja":{"stringUnit":{"state":"translated","value":"オリジナル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始版本"}}}},
    "Other" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Andere"}},"es":{"stringUnit":{"state":"translated","value":"Otros"}},"ja":{"stringUnit":{"state":"translated","value":"その他"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"其他"}}}},
    "Processing" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verarbeitung"}},"es":{"stringUnit":{"state":"translated","value":"Procesamiento"}},"ja":{"stringUnit":{"state":"translated","value":"処理中"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"处理中"}}}},
    "Processing Failed" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verarbeitung fehlgeschlagen"}},"es":{"stringUnit":{"state":"translated","value":"Error de procesamiento"}},"ja":{"stringUnit":{"state":"translated","value":"処理に失敗しました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"处理失败"}}}},
    "Processing failed" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verarbeitung fehlgeschlagen"}},"es":{"stringUnit":{"state":"translated","value":"Error de procesamiento"}},"ja":{"stringUnit":{"state":"translated","value":"処理に失敗しました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"处理失败"}}}},
    "Processing on %@" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verarbeitung auf %@"}},"es":{"stringUnit":{"state":"translated","value":"Procesando en %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@で処理中"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在 %@ 上处理"}}}},
    "Processing on %@…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verarbeitung auf %@ …"}},"es":{"stringUnit":{"state":"translated","value":"Procesando en %@…"}},"ja":{"stringUnit":{"state":"translated","value":"%@で処理中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在 %@ 上处理…"}}}},
    "Reopen" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erneut öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Volver a abrir"}},"ja":{"stringUnit":{"state":"translated","value":"再開"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新打开"}}}},
    "Restore & Delete" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wiederherstellen & Löschen"}},"es":{"stringUnit":{"state":"translated","value":"Restaurar y eliminar"}},"ja":{"stringUnit":{"state":"translated","value":"復元と削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复与删除"}}}},
    "Restore Automatically Removed History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatisch entfernten Verlauf wiederherstellen"}},"es":{"stringUnit":{"state":"translated","value":"Restaurar el historial eliminado automáticamente"}},"ja":{"stringUnit":{"state":"translated","value":"自動削除された履歴を復元"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复自动移除的历史记录"}}}},
    "Restoring re-imports synchronized entries removed only by local retention. Deleting history while sync is enabled removes it from all synchronized devices." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beim Wiederherstellen werden synchronisierte Einträge erneut importiert, die nur durch die lokale Aufbewahrung entfernt wurden. Wenn Sync aktiv ist, wird gelöschter Verlauf von allen synchronisierten Geräten entfernt."}},"es":{"stringUnit":{"state":"translated","value":"La restauración vuelve a importar las entradas sincronizadas que solo eliminó la conservación local. Si eliminas el historial con la sincronización activada, se elimina de todos los dispositivos sincronizados."}},"ja":{"stringUnit":{"state":"translated","value":"復元すると、ローカルの保存期間によってのみ削除された同期済み項目が再度読み込まれます。同期中に履歴を削除すると、すべての同期デバイスから削除されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复会重新导入仅因本地保留策略而移除的已同步条目。启用同步时删除历史记录，会将其从所有已同步设备中移除。"}}}},
    "Search History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf durchsuchen"}},"es":{"stringUnit":{"state":"translated","value":"Buscar en el historial"}},"ja":{"stringUnit":{"state":"translated","value":"履歴を検索"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索历史记录"}}}},
    "Search, review, edit, export, and complete Inbox entries in a dedicated window." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Posteingangseinträge in einem eigenen Fenster suchen, prüfen, bearbeiten, exportieren und abschließen."}},"es":{"stringUnit":{"state":"translated","value":"Busca, revisa, edita, exporta y completa las entradas de la bandeja de entrada en una ventana propia."}},"ja":{"stringUnit":{"state":"translated","value":"専用ウインドウで受信箱の項目を検索、確認、編集、書き出し、完了できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在专用窗口中搜索、检查、编辑、导出和完成收件箱条目。"}}}},
    "Select an Entry" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eintrag auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Selecciona una entrada"}},"ja":{"stringUnit":{"state":"translated","value":"項目を選択"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一个条目"}}}},
    "Shortcuts" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kurzbefehle"}},"es":{"stringUnit":{"state":"translated","value":"Atajos"}},"ja":{"stringUnit":{"state":"translated","value":"ショートカット"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快捷指令"}}}},
    "Sort" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sortieren"}},"es":{"stringUnit":{"state":"translated","value":"Ordenar"}},"ja":{"stringUnit":{"state":"translated","value":"並べ替え"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"排序"}}}},
    "Sort History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf sortieren"}},"es":{"stringUnit":{"state":"translated","value":"Ordenar historial"}},"ja":{"stringUnit":{"state":"translated","value":"履歴を並べ替え"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"历史记录排序"}}}},
    "Sources" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Quellen"}},"es":{"stringUnit":{"state":"translated","value":"Fuentes"}},"ja":{"stringUnit":{"state":"translated","value":"ソース"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源"}}}},
    "Sync Audio for New Entries" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio für neue Einträge synchronisieren"}},"es":{"stringUnit":{"state":"translated","value":"Sincronizar el audio de las entradas nuevas"}},"ja":{"stringUnit":{"state":"translated","value":"新しい項目の音声を同期"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同步新条目的音频"}}}},
    "Sync History & Inbox" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf & Posteingang synchronisieren"}},"es":{"stringUnit":{"state":"translated","value":"Sincronizar historial y bandeja de entrada"}},"ja":{"stringUnit":{"state":"translated","value":"履歴と受信箱を同期"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同步历史记录和收件箱"}}}},
    "Sync History & Inbox?" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf & Posteingang synchronisieren?"}},"es":{"stringUnit":{"state":"translated","value":"¿Sincronizar historial y bandeja de entrada?"}},"ja":{"stringUnit":{"state":"translated","value":"履歴と受信箱を同期しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同步历史记录和收件箱？"}}}},
    "Synchronized" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Synchronisiert"}},"es":{"stringUnit":{"state":"translated","value":"Sincronizado"}},"ja":{"stringUnit":{"state":"translated","value":"同期済み"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已同步"}}}},
    "Text Version" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Textversion"}},"es":{"stringUnit":{"state":"translated","value":"Versión de texto"}},"ja":{"stringUnit":{"state":"translated","value":"テキスト版"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文本版本"}}}},
    "The origin device could not finish this transcription." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Ursprungsgerät konnte diese Transkription nicht abschließen."}},"es":{"stringUnit":{"state":"translated","value":"El dispositivo de origen no pudo terminar esta transcripción."}},"ja":{"stringUnit":{"state":"translated","value":"作成元のデバイスでこの文字起こしを完了できませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源设备无法完成此转录。"}}}},
    "The result will update here automatically." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Ergebnis wird hier automatisch aktualisiert."}},"es":{"stringUnit":{"state":"translated","value":"El resultado se actualizará aquí automáticamente."}},"ja":{"stringUnit":{"state":"translated","value":"結果はここで自動的に更新されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结果会在此处自动更新。"}}}},
    "The synchronized audio could not be verified." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das synchronisierte Audio konnte nicht überprüft werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo verificar el audio sincronizado."}},"ja":{"stringUnit":{"state":"translated","value":"同期した音声を検証できませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法验证已同步的音频。"}}}},
    "The synchronized audio is not available yet." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das synchronisierte Audio ist noch nicht verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El audio sincronizado todavía no está disponible."}},"ja":{"stringUnit":{"state":"translated","value":"同期した音声はまだ利用できません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已同步的音频尚不可用。"}}}},
    "The synchronized audio reference is invalid." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Verweis auf das synchronisierte Audio ist ungültig."}},"es":{"stringUnit":{"state":"translated","value":"La referencia al audio sincronizado no es válida."}},"ja":{"stringUnit":{"state":"translated","value":"同期した音声の参照が無効です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已同步音频的引用无效。"}}}},
    "This Mac" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Mac"}},"es":{"stringUnit":{"state":"translated","value":"Este Mac"}},"ja":{"stringUnit":{"state":"translated","value":"このMac"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此 Mac"}}}},
    "This Month" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Monat"}},"es":{"stringUnit":{"state":"translated","value":"Este mes"}},"ja":{"stringUnit":{"state":"translated","value":"今月"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本月"}}}},
    "This deletes all history from every synchronized device. This cannot be undone." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dadurch wird der gesamte Verlauf von allen synchronisierten Geräten gelöscht. Dies kann nicht rückgängig gemacht werden."}},"es":{"stringUnit":{"state":"translated","value":"Esto elimina todo el historial de todos los dispositivos sincronizados. Esta acción no se puede deshacer."}},"ja":{"stringUnit":{"state":"translated","value":"すべての同期デバイスから履歴がすべて削除されます。この操作は取り消せません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会从所有已同步设备中删除全部历史记录，且无法撤销。"}}}},
    "This deletes all history stored on this Mac. This cannot be undone." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dadurch wird der gesamte auf diesem Mac gespeicherte Verlauf gelöscht. Dies kann nicht rückgängig gemacht werden."}},"es":{"stringUnit":{"state":"translated","value":"Esto elimina todo el historial guardado en este Mac. Esta acción no se puede deshacer."}},"ja":{"stringUnit":{"state":"translated","value":"このMacに保存された履歴がすべて削除されます。この操作は取り消せません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会删除此 Mac 上存储的全部历史记录，且无法撤销。"}}}},
    "This entry is too long to compare word by word. Use Final or Original to read the full text." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Eintrag ist zu lang für einen wortweisen Vergleich. Verwende „Final“ oder „Original“, um den vollständigen Text zu lesen."}},"es":{"stringUnit":{"state":"translated","value":"Esta entrada es demasiado larga para compararla palabra por palabra. Usa “Final” u “Original” para leer el texto completo."}},"ja":{"stringUnit":{"state":"translated","value":"この項目は長すぎるため、単語単位で比較できません。全文を読むには「最終版」または「オリジナル」を使用してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此条目过长，无法逐词比较。请使用“最终版本”或“原始版本”阅读全文。"}}}},
    "This removes the selected history from every synchronized device. This cannot be undone." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dadurch wird der ausgewählte Verlauf von allen synchronisierten Geräten entfernt. Dies kann nicht rückgängig gemacht werden."}},"es":{"stringUnit":{"state":"translated","value":"Esto quita el historial seleccionado de todos los dispositivos sincronizados. Esta acción no se puede deshacer."}},"ja":{"stringUnit":{"state":"translated","value":"選択した履歴がすべての同期デバイスから削除されます。この操作は取り消せません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会从所有已同步设备中移除所选历史记录，且无法撤销。"}}}},
    "This removes the selected history from this Mac. This cannot be undone." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dadurch wird der ausgewählte Verlauf von diesem Mac entfernt. Dies kann nicht rückgängig gemacht werden."}},"es":{"stringUnit":{"state":"translated","value":"Esto quita el historial seleccionado de este Mac. Esta acción no se puede deshacer."}},"ja":{"stringUnit":{"state":"translated","value":"選択した履歴がこのMacから削除されます。この操作は取り消せません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会从此 Mac 中移除所选历史记录，且无法撤销。"}}}},
    "With Audio" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mit Audio"}},"es":{"stringUnit":{"state":"translated","value":"Con audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声あり"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"含音频"}}}},
    "Your saved text and Inbox state will be added to your private sync folder and become available on your other enabled TypeWhisper devices." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gespeicherter Text und der Posteingangsstatus werden deinem privaten Sync-Ordner hinzugefügt und auf deinen anderen aktivierten TypeWhisper-Geräten verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"Tu texto guardado y el estado de la bandeja de entrada se agregarán a tu carpeta privada de sincronización y estarán disponibles en tus otros dispositivos con TypeWhisper activado."}},"ja":{"stringUnit":{"state":"translated","value":"保存済みのテキストと受信箱の状態がプライベート同期フォルダに追加され、有効化した他のTypeWhisperデバイスでも利用できるようになります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存的文本和收件箱状态将添加到你的私人同步文件夹，并可在其他已启用的 TypeWhisper 设备上使用。"}}}},
    "Your saved transcriptions will appear here." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine gespeicherten Transkriptionen erscheinen hier."}},"es":{"stringUnit":{"state":"translated","value":"Tus transcripciones guardadas aparecerán aquí."}},"ja":{"stringUnit":{"state":"translated","value":"保存した文字起こしがここに表示されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你保存的转录会显示在这里。"}}}},
    "iPhone & iPad" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"iPhone & iPad"}},"es":{"stringUnit":{"state":"translated","value":"iPhone y iPad"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneとiPad"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iPhone 和 iPad"}}}},
    "Choose an entry to read and edit its text or inspect its details." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle einen Eintrag aus, um seinen Text zu lesen und zu bearbeiten oder seine Details anzusehen."}},"es":{"stringUnit":{"state":"translated","value":"Elige una entrada para leer y editar su texto o ver sus detalles."}},"ja":{"stringUnit":{"state":"translated","value":"項目を選択してテキストを読んだり編集したり、詳細を確認したりできます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一个条目以阅读和编辑文本，或查看其详细信息。"}}}},
    "Device" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gerät"}},"es":{"stringUnit":{"state":"translated","value":"Dispositivo"}},"ja":{"stringUnit":{"state":"translated","value":"デバイス"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备"}}}},
    "Failed" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fehlgeschlagen"}},"es":{"stringUnit":{"state":"translated","value":"Con errores"}},"ja":{"stringUnit":{"state":"translated","value":"失敗"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"失败"}}}},
    "Failed imports and transcriptions will appear here." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fehlgeschlagene Importe und Transkriptionen erscheinen hier."}},"es":{"stringUnit":{"state":"translated","value":"Las importaciones y transcripciones con errores aparecerán aquí."}},"ja":{"stringUnit":{"state":"translated","value":"失敗した読み込みと文字起こしがここに表示されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"失败的导入和转录会显示在这里。"}}}},
    "History sync is optional on each device. Audio sync applies to new entries and downloads automatically on enabled devices." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Verlaufssync ist auf jedem Gerät optional. Audiosync gilt für neue Einträge und lädt Audio auf aktivierten Geräten automatisch herunter."}},"es":{"stringUnit":{"state":"translated","value":"La sincronización del historial es opcional en cada dispositivo. La sincronización del audio se aplica a las entradas nuevas y se descarga automáticamente en los dispositivos activados."}},"ja":{"stringUnit":{"state":"translated","value":"履歴同期はデバイスごとに任意です。音声同期は新しい項目に適用され、有効なデバイスに自動的にダウンロードされます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每台设备都可单独选择是否同步历史记录。音频同步适用于新条目，并会自动下载到已启用的设备。"}}}},
    "iPad App" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"iPad-App"}},"es":{"stringUnit":{"state":"translated","value":"App para iPad"}},"ja":{"stringUnit":{"state":"translated","value":"iPadアプリ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iPad App"}}}},
    "iPhone App" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"iPhone-App"}},"es":{"stringUnit":{"state":"translated","value":"App para iPhone"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneアプリ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iPhone App"}}}},
    "Mac Dictation" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mac-Diktat"}},"es":{"stringUnit":{"state":"translated","value":"Dictado en el Mac"}},"ja":{"stringUnit":{"state":"translated","value":"Macの音声入力"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Mac 听写"}}}},
    "Windows Dictation" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Windows-Diktat"}},"es":{"stringUnit":{"state":"translated","value":"Dictado en Windows"}},"ja":{"stringUnit":{"state":"translated","value":"Windowsの音声入力"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Windows 听写"}}}},
    "Windows" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Windows"}},"es":{"stringUnit":{"state":"translated","value":"Windows"}},"ja":{"stringUnit":{"state":"translated","value":"Windows"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Windows"}}}},
    "Recorder" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Recorder"}},"es":{"stringUnit":{"state":"translated","value":"Grabadora"}},"ja":{"stringUnit":{"state":"translated","value":"レコーダー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音"}}}},
    "More History Options" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Weitere Verlaufsoptionen"}},"es":{"stringUnit":{"state":"translated","value":"Más opciones del historial"}},"ja":{"stringUnit":{"state":"translated","value":"その他の履歴オプション"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更多历史记录选项"}}}},
    "No Failed Entries" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine fehlgeschlagenen Einträge"}},"es":{"stringUnit":{"state":"translated","value":"No hay entradas con errores"}},"ja":{"stringUnit":{"state":"translated","value":"失敗した項目はありません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有失败的条目"}}}},
    "Save Changes?" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Änderungen speichern?"}},"es":{"stringUnit":{"state":"translated","value":"¿Guardar los cambios?"}},"ja":{"stringUnit":{"state":"translated","value":"変更を保存しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存更改？"}}}},
    "Save or discard your changes before leaving this entry." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Speichere oder verwirf deine Änderungen, bevor du diesen Eintrag verlässt."}},"es":{"stringUnit":{"state":"translated","value":"Guarda o descarta tus cambios antes de salir de esta entrada."}},"ja":{"stringUnit":{"state":"translated","value":"この項目を離れる前に変更を保存または破棄してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"离开此条目前，请保存或放弃更改。"}}}},
    "Smart Mailboxes" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Intelligente Postfächer"}},"es":{"stringUnit":{"state":"translated","value":"Buzones inteligentes"}},"ja":{"stringUnit":{"state":"translated","value":"スマートメールボックス"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"智能邮箱"}}}},
    "Enable the integration to open this page." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviere die Integration, um diese Seite zu öffnen."}},"es":{"stringUnit":{"state":"translated","value":"Activa la integración para abrir esta página."}},"ja":{"stringUnit":{"state":"translated","value":"このページを開くには、プラグインを有効にしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用集成后即可打开此页面。"}}}},
    "Integration Unavailable" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Integration nicht verfügbar"}},"es":{"stringUnit":{"state":"translated","value":"Integración no disponible"}},"ja":{"stringUnit":{"state":"translated","value":"プラグインを利用できません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"集成不可用"}}}},
    "calendarMeeting.settings.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erkennung nutzt die Audioaktivität von Meeting-Apps und Meeting-URLs, auch in Hintergrund-Tabs. Bei mehrdeutigen Browser-Meetings startet keine Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detection uses meeting app audio activity and meeting URLs, including background tabs. Ambiguous browser meetings do not start a recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La detección usa la actividad de audio de las apps de reuniones y las URL de reuniones, también en pestañas en segundo plano. Las reuniones ambiguas en el navegador no inician una grabación."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検出にはミーティングアプリの音声使用状況と、バックグラウンドのタブを含むミーティングURLを使用します。ブラウザのミーティングを特定できない場合は録音を開始しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测会使用会议应用的音频活动和会议网址，包括后台标签页。无法明确识别浏览器中的会议时，不会开始录音。"
          }
        }
      }
    },
