    "Not enough disk space to download %@. It needs %@ of free space, but only %@ is available on “%@”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Speicherplatz, um %1$@ herunterzuladen. Benötigt werden %2$@ freier Speicher, auf „%4$@“ sind aber nur %3$@ verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio en disco para descargar %1$@. Se necesitan %2$@ de espacio libre, pero solo hay %3$@ disponibles en “%4$@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ をダウンロードするための空き容量が足りません。%2$@ の空き容量が必要ですが、「%4$@」で使用できるのは %3$@ だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘空间不足，无法下载 %1$@。需要 %2$@ 可用空间，但“%4$@”上只有 %3$@ 可用。"
          }
        }
      }
    },
    "Not enough disk space to download %@. It needs %@ of free space, but only %@ is available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Speicherplatz, um %1$@ herunterzuladen. Benötigt werden %2$@ freier Speicher, verfügbar sind aber nur %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio en disco para descargar %1$@. Se necesitan %2$@ de espacio libre, pero solo hay %3$@ disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ をダウンロードするための空き容量が足りません。%2$@ の空き容量が必要ですが、使用できるのは %3$@ だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘空间不足，无法下载 %1$@。需要 %2$@ 可用空间，但只有 %3$@ 可用。"
          }
        }
      }
    },
    "Other model downloads in progress still need %@.": {
