    "Automatic iCloud" : {
      "comment" : "Text displayed in a toggle to enable automatic iCloud syncing of premium account information.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud automático"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动 iCloud 同步"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudで自動同期"
          }
        }
      }
    },
    "Automatically extracts facts, preferences and patterns from your transcriptions using an LLM. Memories are injected into prompt context." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrahiert automatisch Fakten, Präferenzen und Muster aus deinen Transkriptionen per LLM. Erinnerungen werden als Kontext in Prompts eingefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrae automáticamente hechos, preferencias y patrones de tus transcripciones con un LLM. Los recuerdos se insertan en el contexto de los prompts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LLMを使用して、あなたの転写テキストから事実、好み、パターンを自動的に抽出します。思い出はプロンプトのコンテキストとして挿入されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 LLM 自动从转录内容中提取事实、偏好和规律，并将这些记忆加入提示词上下文。"
          }
        }
      }
    },
    "Automatically pauses music and videos while recording and resumes when done. Uses macOS system media controls - may not work with all apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert automatisch Musik und Videos während der Aufnahme und setzt die Wiedergabe fort, wenn fertig. Verwendet macOS-Systemsteuerung - funktioniert möglicherweise nicht mit allen Apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa automáticamente la música y los videos durante la grabación y los reanuda al terminar. Usa los controles multimedia del sistema de macOS; puede que no funcione con todas las apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音中に自動的に音楽や動画を一時停止し、録音が完了すると再生を再開します。macOSのシステムコントロールを使用 - すべてのアプリで動作するとは限りません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音时自动暂停音乐和视频，结束后继续播放。此功能使用 macOS 系统媒体控制，可能不支持部分应用。"
          }
        }
      }
    },
    "Automatically raises quiet microphone input before transcription. Useful for low-gain microphones, but very noisy rooms may sound louder too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube automáticamente el nivel de las entradas de micrófono bajas antes de la transcripción. Es útil con micrófonos de poca ganancia, pero en salas muy ruidosas también puede subir el ruido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字起こし前に小さなマイク入力音量を自動的に上げます。低ゲインのマイクに便利ですが、騒がしい部屋では環境音も大きくなる可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在转录前自动提升较低的麦克风输入音量。对低增益麦克风很有用，但在非常嘈杂的房间中，环境噪音也可能被放大。"
          }
        }
      }
    },
    "Automatically unloads local models from memory after inactivity. It reloads when needed. Does not affect cloud engines." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entlädt lokale Modelle nach Inaktivität automatisch aus dem Arbeitsspeicher. Bei Bedarf werden sie neu geladen. Cloud-Engines sind nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera automáticamente de la memoria los modelos locales tras un periodo de inactividad. Se vuelven a cargar cuando hacen falta. No afecta a los motores en la nube."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルモデルを不使用時に自動的にメモリからアンロードします。必要に応じて再読み込みされます。クラウドエンジンは影響を受けません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在闲置后自动将本地模型从内存中卸载。需要时会重新加载。不会影响云端引擎。"
          }
        }
      }
    },
    "Available" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfügbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible"
          }
        },
        "ja" : {
