    "Custom temperature is ignored for the selected GPT-5 reasoning configuration.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La temperatura personalizada se ignora con la configuración de razonamiento de GPT-5 seleccionada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したGPT-5の推論設定では、カスタム温度は無視されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die benutzerdefinierte Temperatur wird für die gewählte GPT-5-Denkkonfiguration ignoriert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选的 GPT-5 推理配置不使用自定义温度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選的 GPT-5 推理設定不使用自訂溫度。"
          }
        }
      }
    },
