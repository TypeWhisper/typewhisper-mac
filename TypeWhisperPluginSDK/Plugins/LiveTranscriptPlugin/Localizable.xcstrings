{
  "sourceLanguage": "en",
  "strings": {
    "Clear shortcut": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkürzel entfernen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar atajo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除快捷键"
          }
        }
      }
    },
    "Background opacity": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacidad del fondo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景の不透明度"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrunddeckkraft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景不透明度"
          }
        }
      }
    },
    "Height": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高さ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhe"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高度"
          }
        }
      }
    },
    "Lower values keep more of the app behind the transcript visible.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con valores más bajos se ve más de la app que hay detrás de la transcripción."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値を小さくすると、文字起こしの背後にあるアプリがより透けて見えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei niedrigeren Werten bleibt mehr von der App hinter dem Transkript sichtbar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值越低，越能看清转录窗口后面的应用内容。"
          }
        }
      }
    },
    "Width": {
      "localizations": {
        "es": {
