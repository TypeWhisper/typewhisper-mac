          }
        }
      }
    },
    "A model operation is already in progress. Wait for it to finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Modellvorgang läuft bereits. Warte, bis er abgeschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una operación de modelo en curso. Espera a que termine."
          }
