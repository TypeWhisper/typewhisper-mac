    "Auto (Realtime with REST fallback)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch (Echtzeit mit REST-Fallback)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto (en tiempo real con respaldo REST)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動（リアルタイム、RESTフォールバック）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动（实时，REST 回退）"
          }
        }
      }
    },
    "Auto streams while you dictate and falls back to batch REST. REST only avoids realtime concurrency limits and bills the batch rate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch streamt bereits während des Diktats und wechselt bei Fehlern zu Batch-REST. Nur REST vermeidet Echtzeit-Parallelitätslimits und wird zum Batch-Tarif abgerechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto transmite mientras dictas y recurre a REST por lotes si falla. Solo REST evita los límites de simultaneidad en tiempo real y se factura con la tarifa por lotes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動モードでは音声入力中にストリーミングし、失敗時はバッチRESTに切り替えます。RESTのみではリアルタイムの同時実行制限を回避し、バッチ料金で課金されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动模式在听写时进行流式传输，失败时回退到批量 REST。仅 REST 模式可避免实时并发限制，并按批量费率计费。"
          }
        }
      }
    },
    "API keys are stored securely in the Keychain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel werden sicher im Schlüsselbund gespeichert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de API se guardan de forma segura en el llavero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーはキーチェーンに安全に保存されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥安全存储在钥匙串中"
          }
        }
      }
    },
