    },
    " Among multiple matching workflows, the one higher in the list wins here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 複数の一致するワークフローがある場合、リストの上位にあるものが優先されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当多个工作流匹配时，列表中排在上方的优先。"
          }
        }
      }
    },
    " Manual override can force it at any time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 手動のオーバーライドでいつでも強制的に適用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动覆盖可随时强制执行。"
          }
        }
      }
    },
    " Manual override can still force it at any time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 手動のオーバーライドにより、引き続きいつでも強制的に適用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动覆盖仍可随时强制执行。"
          }
        }
      }
    },
