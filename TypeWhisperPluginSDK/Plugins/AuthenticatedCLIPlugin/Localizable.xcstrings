    "Available models": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verfügbare Modelle"}},"ja":{"stringUnit":{"state":"translated","value":"利用可能なモデル"}}}},
    "Best-effort integration": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Best-Effort-Integration"}},"ja":{"stringUnit":{"state":"translated","value":"ベストエフォート統合"}}}},
