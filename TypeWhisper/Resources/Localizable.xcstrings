    "This will permanently delete aggregate word, app, time-saved, and activity statistics. Transcription history entries are unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará de forma permanente las estadísticas acumuladas de palabras, apps, tiempo ahorrado y actividad. Las entradas del historial de transcripciones no cambian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将永久删除词数、应用、节省时间和活动的汇总统计数据。转写历史记录不会更改。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語数、利用アプリ、短縮できた時間、利用状況の集計を完全に削除します。文字起こし履歴は変更されません。"
          }
        }
      }
    },
    "This will permanently delete all recorded errors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle aufgezeichneten Fehler dauerhaft gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará de forma permanente todos los errores registrados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、すべての記録されたエラーが永久に削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除所有已记录的错误。"
          }
        }
      }
    },
    "This will permanently delete all stored memories from all plugins. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gespeicherten Erinnerungen werden unwiderruflich aus allen Plugins gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará de forma permanente todos los recuerdos guardados de todos los plugins. Esta acción no se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての保存されたメモリは、すべてのプラグインから不可逆的に削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除所有插件中存储的全部记忆。此操作无法撤销。"
          }
        }
      }
    },
    "This workflow applies because no more specific workflow matched." : {
