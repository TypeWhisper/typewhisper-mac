    "Built-in model list. Refresh loads the models of your Mistral account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingebaute Modellliste. „Aktualisieren“ lädt die Modelle deines Mistral-Kontos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de modelos integrada. «Actualizar» carga los modelos de tu cuenta de Mistral."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組み込みのモデル一覧です。「更新」でMistralアカウントのモデルを読み込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置模型列表。“刷新”会加载你的 Mistral 账户中的模型。"
          }
        }
      }
    },
    "Could not load the models of your Mistral account. The built-in list stays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modelle deines Mistral-Kontos ließen sich nicht laden. Die eingebaute Liste bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los modelos de tu cuenta de Mistral. Se mantiene la lista integrada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistralアカウントのモデルを読み込めませんでした。組み込みの一覧をそのまま使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载你的 Mistral 账户中的模型，将继续使用内置列表。"
          }
        }
      }
    },
