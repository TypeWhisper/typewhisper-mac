    "The source could not be read safely. Quitting the source app and trying again may help. Nothing was imported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle konnte nicht sicher gelesen werden. Beende gegebenenfalls die Quell-App und versuche es erneut. Es wurde nichts importiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el origen de forma segura. Puede ayudar salir de la app de origen y volver a intentarlo. No se importó nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
