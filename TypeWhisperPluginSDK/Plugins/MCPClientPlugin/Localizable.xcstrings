{
  "sourceLanguage": "en",
  "strings": {
    "%@ is not one of the values allowed by the tool schema.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ gehört nicht zu den vom Tool-Schema erlaubten Werten."}},"ja":{"stringUnit":{"state":"translated","value":"%@ はツールスキーマで許可された値ではありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 不是工具架构允许的值。"}}}},
    "%@ must be a JSON %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ muss ein JSON-Wert vom Typ %@ sein."}},"ja":{"stringUnit":{"state":"translated","value":"%@ は JSON の %@ である必要があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 必须是 JSON %@。"}}}},
    "%@ timed out. The request was not retried.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeitüberschreitung bei %@. Die Anfrage wurde nicht erneut gesendet."}},"ja":{"stringUnit":{"state":"translated","value":"%@ がタイムアウトしました。リクエストは再試行されませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 超时。请求未重试。"}}}},
    "%lld actions completed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld Aktionen abgeschlossen."}},"ja":{"stringUnit":{"state":"translated","value":"%lld 件のアクションが完了しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成 %lld 个操作。"}}}},
    "%lld of %lld actions completed; failed items: %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld von %lld Aktionen abgeschlossen; fehlgeschlagene Elemente: %@."}},"ja":{"stringUnit":{"state":"translated","value":"%2$lld 件中 %1$lld 件のアクションが完了しました。失敗した項目: %3$@。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成 %2$lld 个操作中的 %1$lld 个；失败项目：%3$@。"}}}},
    "Acknowledge automatic execution of this destructive tool before saving.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bestätige vor dem Speichern die automatische Ausführung dieses destruktiven Tools."}},"ja":{"stringUnit":{"state":"translated","value":"保存する前に、この破壊的ツールの自動実行を確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存前请确认自动执行此破坏性工具。"}}}},
    "Acknowledge that TypeWhisper may launch this executable with your user permissions.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bestätige, dass TypeWhisper dieses Programm mit deinen Benutzerrechten starten darf."}},"ja":{"stringUnit":{"state":"translated","value":"TypeWhisper がユーザー権限でこの実行ファイルを起動することを確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请确认 TypeWhisper 可以使用你的用户权限启动此可执行文件。"}}}},
    "Action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktion"}},"ja":{"stringUnit":{"state":"translated","value":"アクション"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"操作"}}}},
    "Actions": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktionen"}},"ja":{"stringUnit":{"state":"translated","value":"アクション"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"操作"}}}},
    "Active application URL": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"URL der aktiven App"}},"ja":{"stringUnit":{"state":"translated","value":"アクティブなアプリの URL"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前应用 URL"}}}},
    "Active application bundle identifier": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bundle-ID der aktiven App"}},"ja":{"stringUnit":{"state":"translated","value":"アクティブなアプリのバンドル ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前应用软件包标识符"}}}},
    "Active application name": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Name der aktiven App"}},"ja":{"stringUnit":{"state":"translated","value":"アクティブなアプリ名"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前应用名称"}}}},
    "Activity": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktivität"}},"ja":{"stringUnit":{"state":"translated","value":"アクティビティ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"活动"}}}},
    "Activity summaries never include transcripts, complete arguments, or secret values.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktivitätszusammenfassungen enthalten niemals Transkripte, vollständige Argumente oder geheime Werte."}},"ja":{"stringUnit":{"state":"translated","value":"アクティビティの概要に文字起こし、完全な引数、シークレット値は含まれません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"活动摘要绝不包含转录、完整参数或机密值。"}}}},
    "Add Action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktion hinzufügen"}},"ja":{"stringUnit":{"state":"translated","value":"アクションを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加操作"}}}},
    "Add Argument": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argument hinzufügen"}},"ja":{"stringUnit":{"state":"translated","value":"引数を追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加参数"}}}},
    "Add Environment Value": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Umgebungswert hinzufügen"}},"ja":{"stringUnit":{"state":"translated","value":"環境変数を追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加环境变量"}}}},
    "Add MCP Action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Aktion hinzufügen"}},"ja":{"stringUnit":{"state":"translated","value":"MCP アクションを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 MCP 操作"}}}},
    "Add MCP Server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Server hinzufügen"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバーを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 MCP 服务器"}}}},
    "Add MCP action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Aktion hinzufügen"}},"ja":{"stringUnit":{"state":"translated","value":"MCP アクションを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 MCP 操作"}}}},
    "Add MCP server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Server hinzufügen"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバーを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 MCP 服务器"}}}},
    "Add Server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Server hinzufügen"}},"ja":{"stringUnit":{"state":"translated","value":"サーバーを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加服务器"}}}},
    "Add a server before creating an action.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge einen Server hinzu, bevor du eine Aktion erstellst."}},"ja":{"stringUnit":{"state":"translated","value":"アクションを作成する前にサーバーを追加してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建操作前请先添加服务器。"}}}},
    "Add a stdio server to discover its tools.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge einen stdio-Server hinzu, um seine Tools zu finden."}},"ja":{"stringUnit":{"state":"translated","value":"stdio サーバーを追加してツールを検出します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 stdio 服务器以发现其工具。"}}}},
    "Add argument": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argument hinzufügen"}},"ja":{"stringUnit":{"state":"translated","value":"引数を追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加参数"}}}},
    "Add bindings for required arguments: %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge Bindungen für erforderliche Argumente hinzu: %@."}},"ja":{"stringUnit":{"state":"translated","value":"必須引数のバインディングを追加してください: %@。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请为必需参数添加绑定：%@。"}}}},
    "Argument": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argument"}},"ja":{"stringUnit":{"state":"translated","value":"引数"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数"}}}},
    "Argument Preview": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argumentvorschau"}},"ja":{"stringUnit":{"state":"translated","value":"引数プレビュー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数预览"}}}},
    "Arguments": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argumente"}},"ja":{"stringUnit":{"state":"translated","value":"引数"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数"}}}},
    "Arguments come from runtime JSON.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Argumente stammen zur Laufzeit aus JSON."}},"ja":{"stringUnit":{"state":"translated","value":"引数は実行時の JSON から取得されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数来自运行时 JSON。"}}}},
    "Authorization": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Autorisierung"}},"ja":{"stringUnit":{"state":"translated","value":"承認"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"授权"}}}},
    "Automatic Execution": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatische Ausführung"}},"ja":{"stringUnit":{"state":"translated","value":"自動実行"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动执行"}}}},
    "Batch raw JSON arguments must use the current batch item.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Unverarbeitete JSON-Argumente im Stapelmodus müssen das aktuelle Stapelelement verwenden."}},"ja":{"stringUnit":{"state":"translated","value":"バッチの生 JSON 引数には現在のバッチ項目を使用する必要があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批处理原始 JSON 参数必须使用当前批处理项目。"}}}},
    "Batch": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Stapel"}},"ja":{"stringUnit":{"state":"translated","value":"バッチ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批处理"}}}},
    "Batch mode expects a JSON array, validates all items before the first call, runs at most 100 items sequentially, and never retries writes automatically.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Stapelmodus erwartet ein JSON-Array, validiert alle Elemente vor dem ersten Aufruf, führt höchstens 100 Elemente nacheinander aus und wiederholt Schreibvorgänge nie automatisch."}},"ja":{"stringUnit":{"state":"translated","value":"バッチモードは JSON 配列を受け取り、最初の呼び出し前に全項目を検証し、最大 100 項目を順番に実行します。書き込みは自動再試行されません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批处理模式需要 JSON 数组，在首次调用前验证所有项目，最多按顺序运行 100 个项目，并且绝不自动重试写入。"}}}},
    "Batch mode requires the processed workflow text to be a JSON array.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Stapelmodus erfordert, dass der verarbeitete Workflow-Text ein JSON-Array ist."}},"ja":{"stringUnit":{"state":"translated","value":"バッチモードでは処理済みワークフローテキストが JSON 配列である必要があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批处理模式要求处理后的工作流文本为 JSON 数组。"}}}},
    "Cancel": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abbrechen"}},"ja":{"stringUnit":{"state":"translated","value":"キャンセル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}}}},
    "Command": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Befehl"}},"ja":{"stringUnit":{"state":"translated","value":"コマンド"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"命令"}}}},
    "Configure local MCP processes. Commands are launched directly, never through a shell.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Konfiguriere lokale MCP-Prozesse. Befehle werden direkt und nie über eine Shell gestartet."}},"ja":{"stringUnit":{"state":"translated","value":"ローカル MCP プロセスを設定します。コマンドはシェルを介さず直接起動されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置本地 MCP 进程。命令会直接启动，绝不通过 shell。"}}}},
    "Connect & Load Tools": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verbinden & Tools laden"}},"ja":{"stringUnit":{"state":"translated","value":"接続してツールを読み込む"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接并加载工具"}}}},
    "Connection": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verbindung"}},"ja":{"stringUnit":{"state":"translated","value":"接続"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接"}}}},
    "Connection and action results appear here.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verbindungs- und Aktionsergebnisse erscheinen hier."}},"ja":{"stringUnit":{"state":"translated","value":"接続とアクションの結果がここに表示されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接和操作结果会显示在此处。"}}}},
    "Could not connect to MCP server ‘%@’: %@. stderr: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verbindung zum MCP-Server „%@“ nicht möglich: %@. stderr: %@"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバー「%@」に接続できませんでした: %@。stderr: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法连接 MCP 服务器“%@”：%@。stderr：%@"}}}},
    "Could not launch MCP server ‘%@’: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Server „%@“ konnte nicht gestartet werden: %@"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバー「%@」を起動できませんでした: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法启动 MCP 服务器“%@”：%@"}}}},
    "Create an action and select it as a workflow Action Target.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erstelle eine Aktion und wähle sie als Aktionsziel eines Workflows aus."}},"ja":{"stringUnit":{"state":"translated","value":"アクションを作成し、ワークフローのアクションターゲットとして選択します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建操作并将其选为工作流操作目标。"}}}},
    "Current batch item": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktuelles Stapelelement"}},"ja":{"stringUnit":{"state":"translated","value":"現在のバッチ項目"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前批处理项目"}}}},
    "Current batch item can only be used in batch mode.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das aktuelle Stapelelement kann nur im Stapelmodus verwendet werden."}},"ja":{"stringUnit":{"state":"translated","value":"現在のバッチ項目はバッチモードでのみ使用できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前批处理项目只能在批处理模式中使用。"}}}},
    "Detected language": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erkannte Sprache"}},"ja":{"stringUnit":{"state":"translated","value":"検出された言語"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检测到的语言"}}}},
    "Each saved action binds one workflow target to one MCP tool.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Jede gespeicherte Aktion verbindet ein Workflow-Ziel mit einem MCP-Tool."}},"ja":{"stringUnit":{"state":"translated","value":"保存した各アクションは、1 つのワークフローターゲットを 1 つの MCP ツールに結び付けます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每个已保存操作将一个工作流目标绑定到一个 MCP 工具。"}}}},
    "Edit": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bearbeiten"}},"ja":{"stringUnit":{"state":"translated","value":"編集"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑"}}}},
    "Edit MCP Action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Aktion bearbeiten"}},"ja":{"stringUnit":{"state":"translated","value":"MCP アクションを編集"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑 MCP 操作"}}}},
    "Edit MCP Server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Server bearbeiten"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバーを編集"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑 MCP 服务器"}}}},
    "Enter a server name.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gib einen Servernamen ein."}},"ja":{"stringUnit":{"state":"translated","value":"サーバー名を入力してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入服务器名称。"}}}},
    "Enter an MCP server command.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gib einen MCP-Serverbefehl ein."}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバーコマンドを入力してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 MCP 服务器命令。"}}}},
    "Enter an action name.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gib einen Aktionsnamen ein."}},"ja":{"stringUnit":{"state":"translated","value":"アクション名を入力してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入操作名称。"}}}},
    "Environment": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Umgebung"}},"ja":{"stringUnit":{"state":"translated","value":"環境"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"环境"}}}},
    "Environment variable names must be unique.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Namen von Umgebungsvariablen müssen eindeutig sein."}},"ja":{"stringUnit":{"state":"translated","value":"環境変数名は一意である必要があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"环境变量名称必须唯一。"}}}},
    "Executable not found: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ausführbare Datei nicht gefunden: %@"}},"ja":{"stringUnit":{"state":"translated","value":"実行ファイルが見つかりません: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"找不到可执行文件：%@"}}}},
    "Expected valid JSON.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gültiges JSON erwartet."}},"ja":{"stringUnit":{"state":"translated","value":"有効な JSON が必要です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应为有效的 JSON。"}}}},
    "File is not executable: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Datei ist nicht ausführbar: %@"}},"ja":{"stringUnit":{"state":"translated","value":"ファイルを実行できません: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文件不可执行：%@"}}}},
    "I understand that TypeWhisper will launch %@ with my user permissions.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ich verstehe, dass TypeWhisper %@ mit meinen Benutzerrechten startet."}},"ja":{"stringUnit":{"state":"translated","value":"TypeWhisper がユーザー権限で %@ を起動することを理解しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我了解 TypeWhisper 将使用我的用户权限启动 %@。"}}}},
    "I understand that this tool is marked destructive and may change or delete external data.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ich verstehe, dass dieses Tool als destruktiv markiert ist und externe Daten ändern oder löschen kann."}},"ja":{"stringUnit":{"state":"translated","value":"このツールが破壊的とマークされ、外部データを変更または削除する可能性があることを理解しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我了解此工具被标记为破坏性，可能更改或删除外部数据。"}}}},
    "JSON Source": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"JSON-Quelle"}},"ja":{"stringUnit":{"state":"translated","value":"JSON ソース"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"JSON 来源"}}}},
    "JSON property path": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"JSON-Eigenschaftspfad"}},"ja":{"stringUnit":{"state":"translated","value":"JSON プロパティパス"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"JSON 属性路径"}}}},
    "Literal JSON": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Festes JSON"}},"ja":{"stringUnit":{"state":"translated","value":"リテラル JSON"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"JSON 字面量"}}}},
    "Literal JSON value": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fester JSON-Wert"}},"ja":{"stringUnit":{"state":"translated","value":"リテラル JSON 値"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"JSON 字面值"}}}},
    "Literal value": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fester Wert"}},"ja":{"stringUnit":{"state":"translated","value":"リテラル値"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"字面值"}}}},
    "Loaded %lld MCP tools.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld MCP-Tools geladen."}},"ja":{"stringUnit":{"state":"translated","value":"%lld 個の MCP ツールを読み込みました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已加载 %lld 个 MCP 工具。"}}}},
    "MCP Configuration Unavailable": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Konfiguration nicht verfügbar"}},"ja":{"stringUnit":{"state":"translated","value":"MCP 設定を利用できません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 配置不可用"}}}},
    "Loaded %lld tools": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld Tools geladen"}},"ja":{"stringUnit":{"state":"translated","value":"%lld 個のツールを読み込みました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已加载 %lld 个工具"}}}},
    "Loading tools…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tools werden geladen …"}},"ja":{"stringUnit":{"state":"translated","value":"ツールを読み込み中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在加载工具…"}}}},
    "MCP Action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Aktion"}},"ja":{"stringUnit":{"state":"translated","value":"MCP アクション"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 操作"}}}},
    "MCP Client is not active.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP Client ist nicht aktiv."}},"ja":{"stringUnit":{"state":"translated","value":"MCP Client が有効ではありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP Client 未启用。"}}}},
    "MCP Servers": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Server"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 服务器"}}}},
    "MCP Tool": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Tool"}},"ja":{"stringUnit":{"state":"translated","value":"MCP ツール"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 工具"}}}},
    "MCP action completed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Aktion abgeschlossen."}},"ja":{"stringUnit":{"state":"translated","value":"MCP アクションが完了しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 操作已完成。"}}}},
    "MCP action failed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Aktion fehlgeschlagen."}},"ja":{"stringUnit":{"state":"translated","value":"MCP アクションに失敗しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 操作失败。"}}}},
    "MCP argument ‘%@’ must be a JSON %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das MCP-Argument „%@“ muss ein JSON-Wert vom Typ %@ sein."}},"ja":{"stringUnit":{"state":"translated","value":"MCP 引数「%@」は JSON の %@ である必要があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 参数“%@”必须是 JSON %@。"}}}},
    "MCP connection": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Verbindung"}},"ja":{"stringUnit":{"state":"translated","value":"MCP 接続"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 连接"}}}},
    "MCP tool call": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Tool-Aufruf"}},"ja":{"stringUnit":{"state":"translated","value":"MCP ツール呼び出し"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 工具调用"}}}},
    "MCP tool discovery": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Tool-Erkennung"}},"ja":{"stringUnit":{"state":"translated","value":"MCP ツール検出"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 工具发现"}}}},
    "Missing required MCP argument: %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erforderliches MCP-Argument fehlt: %@."}},"ja":{"stringUnit":{"state":"translated","value":"必須の MCP 引数がありません: %@。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缺少必需的 MCP 参数：%@。"}}}},
    "Missing server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Server fehlt"}},"ja":{"stringUnit":{"state":"translated","value":"サーバーがありません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务器缺失"}}}},
    "Move argument down": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argument nach unten verschieben"}},"ja":{"stringUnit":{"state":"translated","value":"引数を下へ移動"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下移参数"}}}},
    "Move argument up": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argument nach oben verschieben"}},"ja":{"stringUnit":{"state":"translated","value":"引数を上へ移動"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上移参数"}}}},
    "Mode": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Modus"}},"ja":{"stringUnit":{"state":"translated","value":"モード"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"模式"}}}},
    "Name": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Name"}},"ja":{"stringUnit":{"state":"translated","value":"名前"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"名称"}}}},
    "No Activity": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine Aktivität"}},"ja":{"stringUnit":{"state":"translated","value":"アクティビティなし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无活动"}}}},
    "No MCP Actions": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine MCP-Aktionen"}},"ja":{"stringUnit":{"state":"translated","value":"MCP アクションなし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无 MCP 操作"}}}},
    "No MCP Servers": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine MCP-Server"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバーなし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无 MCP 服务器"}}}},
    "Original transcript": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Originaltranskript"}},"ja":{"stringUnit":{"state":"translated","value":"元の文字起こし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始转录"}}}},
    "Processed workflow JSON": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verarbeitetes Workflow-JSON"}},"ja":{"stringUnit":{"state":"translated","value":"処理済みワークフロー JSON"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已处理的工作流 JSON"}}}},
    "Processed workflow text": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verarbeiteter Workflow-Text"}},"ja":{"stringUnit":{"state":"translated","value":"処理済みワークフローテキスト"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已处理的工作流文本"}}}},
    "Property path": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eigenschaftspfad"}},"ja":{"stringUnit":{"state":"translated","value":"プロパティパス"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"属性路径"}}}},
    "Raw JSON Arguments": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Unverarbeitete JSON-Argumente"}},"ja":{"stringUnit":{"state":"translated","value":"生の JSON 引数"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始 JSON 参数"}}}},
    "Raw JSON arguments must resolve to an object.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Unverarbeitete JSON-Argumente müssen ein Objekt ergeben."}},"ja":{"stringUnit":{"state":"translated","value":"生の JSON 引数はオブジェクトである必要があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始 JSON 参数必须解析为对象。"}}}},
    "Recent Activity": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Letzte Aktivität"}},"ja":{"stringUnit":{"state":"translated","value":"最近のアクティビティ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最近活动"}}}},
    "Refresh Tools": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tools aktualisieren"}},"ja":{"stringUnit":{"state":"translated","value":"ツールを更新"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新工具"}}}},
    "Refresh incompatible argument bindings before saving.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktualisiere inkompatible Argumentbindungen vor dem Speichern."}},"ja":{"stringUnit":{"state":"translated","value":"保存する前に互換性のない引数バインディングを更新してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存前请刷新不兼容的参数绑定。"}}}},
    "Remove MCP action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Aktion entfernen"}},"ja":{"stringUnit":{"state":"translated","value":"MCP アクションを削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除 MCP 操作"}}}},
    "Remove MCP server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Server entfernen"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバーを削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除 MCP 服务器"}}}},
    "Remove argument": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argument entfernen"}},"ja":{"stringUnit":{"state":"translated","value":"引数を削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除参数"}}}},
    "Remove environment value": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Umgebungswert entfernen"}},"ja":{"stringUnit":{"state":"translated","value":"環境変数を削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除环境变量"}}}},
    "Required": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erforderlich"}},"ja":{"stringUnit":{"state":"translated","value":"必須"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"必需"}}}},
    "Resolved executable": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufgelöste Programmdatei"}},"ja":{"stringUnit":{"state":"translated","value":"解決された実行ファイル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已解析的可执行文件"}}}},
    "SF Symbol": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"SF Symbol"}},"ja":{"stringUnit":{"state":"translated","value":"SF シンボル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"SF 符号"}}}},
    "Sample JSON property": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beispielhafte JSON-Eigenschaft"}},"ja":{"stringUnit":{"state":"translated","value":"サンプル JSON プロパティ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"示例 JSON 属性"}}}},
    "Sample batch item": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beispielhaftes Stapelelement"}},"ja":{"stringUnit":{"state":"translated","value":"サンプルバッチ項目"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"示例批处理项目"}}}},
    "Sample original transcript": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beispielhaftes Originaltranskript"}},"ja":{"stringUnit":{"state":"translated","value":"サンプルの元の文字起こし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"示例原始转录"}}}},
    "Sample processed text": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beispielhafter verarbeiteter Text"}},"ja":{"stringUnit":{"state":"translated","value":"サンプル処理済みテキスト"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"示例已处理文本"}}}},
    "Save": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Speichern"}},"ja":{"stringUnit":{"state":"translated","value":"保存"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存"}}}},
    "Saving and selecting an action authorizes TypeWhisper to run that fixed tool automatically when the workflow completes.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Durch Speichern und Auswählen einer Aktion darf TypeWhisper dieses festgelegte Tool nach Abschluss des Workflows automatisch ausführen."}},"ja":{"stringUnit":{"state":"translated","value":"アクションを保存して選択すると、ワークフロー完了時に TypeWhisper がその固定ツールを自動実行することを許可します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存并选择操作即授权 TypeWhisper 在工作流完成时自动运行该固定工具。"}}}},
    "Secret": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Geheim"}},"ja":{"stringUnit":{"state":"translated","value":"シークレット"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"机密"}}}},
    "Select a tool…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tool auswählen …"}},"ja":{"stringUnit":{"state":"translated","value":"ツールを選択…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择工具…"}}}},
    "Select an MCP tool.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle ein MCP-Tool aus."}},"ja":{"stringUnit":{"state":"translated","value":"MCP ツールを選択してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择 MCP 工具。"}}}},
    "Server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Server"}},"ja":{"stringUnit":{"state":"translated","value":"サーバー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务器"}}}},
    "Servers": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Server"}},"ja":{"stringUnit":{"state":"translated","value":"サーバー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务器"}}}},
    "Single": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einzeln"}},"ja":{"stringUnit":{"state":"translated","value":"単一"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"单次"}}}},
    "Source": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Quelle"}},"ja":{"stringUnit":{"state":"translated","value":"ソース"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源"}}}},
    "Store environment value in Keychain": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Umgebungswert im Schlüsselbund speichern"}},"ja":{"stringUnit":{"state":"translated","value":"環境変数をキーチェーンに保存"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将环境变量存储在钥匙串中"}}}},
    "The MCP client is not connected.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der MCP Client ist nicht verbunden."}},"ja":{"stringUnit":{"state":"translated","value":"MCP Client は接続されていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP Client 未连接。"}}}},
    "The MCP connection was lost after the request may have been sent. The request was not retried.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die MCP-Verbindung ging verloren, nachdem die Anfrage möglicherweise gesendet wurde. Die Anfrage wurde nicht erneut gesendet."}},"ja":{"stringUnit":{"state":"translated","value":"リクエスト送信後の可能性がある時点で MCP 接続が失われました。リクエストは再試行されませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 连接在请求可能已发送后丢失。请求未重试。"}}}},
    "The MCP tool reported an error.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das MCP-Tool hat einen Fehler gemeldet."}},"ja":{"stringUnit":{"state":"translated","value":"MCP ツールがエラーを報告しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 工具报告了错误。"}}}},
    "The MCP tool ‘%@’ is no longer available. Refresh the action configuration.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das MCP-Tool „%@“ ist nicht mehr verfügbar. Aktualisiere die Aktionskonfiguration."}},"ja":{"stringUnit":{"state":"translated","value":"MCP ツール「%@」は利用できなくなりました。アクション設定を更新してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 工具“%@”已不可用。请刷新操作配置。"}}}},
    "The batch contains %lld items. MCP Client supports at most %lld.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Stapel enthält %lld Elemente. MCP Client unterstützt höchstens %lld."}},"ja":{"stringUnit":{"state":"translated","value":"バッチには %lld 項目あります。MCP Client がサポートする上限は %lld 項目です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批处理包含 %lld 个项目。MCP Client 最多支持 %lld 个。"}}}},
    "The command is not interpreted by a shell. The process may still access files and services available to your macOS user.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Befehl wird nicht von einer Shell interpretiert. Der Prozess kann dennoch auf Dateien und Dienste zugreifen, die deinem macOS-Benutzer zur Verfügung stehen."}},"ja":{"stringUnit":{"state":"translated","value":"コマンドはシェルで解釈されません。ただし、プロセスは macOS ユーザーが利用できるファイルやサービスにアクセスできます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"命令不会由 shell 解释。该进程仍可访问你的 macOS 用户可用的文件和服务。"}}}},
    "The configured MCP action no longer exists.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die konfigurierte MCP-Aktion existiert nicht mehr."}},"ja":{"stringUnit":{"state":"translated","value":"設定された MCP アクションは存在しません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已配置的 MCP 操作已不存在。"}}}},
    "The configured MCP server no longer exists.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der konfigurierte MCP-Server existiert nicht mehr."}},"ja":{"stringUnit":{"state":"translated","value":"設定された MCP サーバーは存在しません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已配置的 MCP 服务器已不存在。"}}}},
    "The input is not valid UTF-8 text.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Eingabe ist kein gültiger UTF-8-Text."}},"ja":{"stringUnit":{"state":"translated","value":"入力は有効な UTF-8 テキストではありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"输入不是有效的 UTF-8 文本。"}}}},
    "The input schema for ‘%@’ changed. Refresh the action configuration.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Eingabeschema für „%@“ hat sich geändert. Aktualisiere die Aktionskonfiguration."}},"ja":{"stringUnit":{"state":"translated","value":"「%@」の入力スキーマが変更されました。アクション設定を更新してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“%@”的输入架构已更改。请刷新操作配置。"}}}},
    "The stored MCP configuration could not be loaded. It was left unchanged to prevent data loss.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die gespeicherte MCP-Konfiguration konnte nicht geladen werden. Sie wurde unverändert beibehalten, um Datenverlust zu verhindern."}},"ja":{"stringUnit":{"state":"translated","value":"保存された MCP 設定を読み込めませんでした。データ損失を防ぐため、保存データは変更されていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载已存储的 MCP 配置。为防止数据丢失，原始数据保持不变。"}}}},
    "This fixed MCP tool runs automatically whenever a workflow using this Action Target completes.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses festgelegte MCP-Tool wird automatisch ausgeführt, sobald ein Workflow mit diesem Aktionsziel abgeschlossen ist."}},"ja":{"stringUnit":{"state":"translated","value":"この固定 MCP ツールは、このアクションターゲットを使用するワークフローの完了時に自動実行されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用此操作目标的工作流完成时，该固定 MCP 工具会自动运行。"}}}},
    "This tool has no top-level properties to map. Use Raw JSON Arguments for complex schemas.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses Tool hat keine zuzuordnenden Eigenschaften auf oberster Ebene. Verwende für komplexe Schemas unverarbeitete JSON-Argumente."}},"ja":{"stringUnit":{"state":"translated","value":"このツールにはマッピング可能なトップレベルプロパティがありません。複雑なスキーマには生の JSON 引数を使用してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此工具没有可映射的顶层属性。复杂架构请使用原始 JSON 参数。"}}}},
    "Tool": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tool"}},"ja":{"stringUnit":{"state":"translated","value":"ツール"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"工具"}}}},
    "Use an absolute path or a bare executable name instead of: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verwende einen absoluten Pfad oder nur den Programmnamen anstelle von: %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@ の代わりに絶対パスまたは実行ファイル名のみを使用してください"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用绝对路径或单独的可执行文件名，而不是：%@"}}}},
    "Value": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wert"}},"ja":{"stringUnit":{"state":"translated","value":"値"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"值"}}}},
    "Workflow Actions": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Workflow-Aktionen"}},"ja":{"stringUnit":{"state":"translated","value":"ワークフローアクション"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"工作流操作"}}}},
    "Acknowledge that TypeWhisper may connect to this MCP server and send configured workflow data.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bestätige, dass TypeWhisper eine Verbindung zu diesem MCP-Server herstellen und konfigurierte Workflow-Daten senden darf."}},"ja":{"stringUnit":{"state":"translated","value":"TypeWhisper がこの MCP サーバーに接続し、設定されたワークフローデータを送信できることを確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请确认 TypeWhisper 可以连接此 MCP 服务器并发送已配置的工作流数据。"}}}},
    "Add a stdio or Streamable HTTP server to discover its tools.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge einen stdio- oder Streamable-HTTP-Server hinzu, um seine Tools zu finden."}},"ja":{"stringUnit":{"state":"translated","value":"stdio または Streamable HTTP サーバーを追加してツールを検出します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 stdio 或 Streamable HTTP 服务器以发现其工具。"}}}},
    "Authentication": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Authentifizierung"}},"ja":{"stringUnit":{"state":"translated","value":"認証"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"身份验证"}}}},
    "Bearer token": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bearer-Token"}},"ja":{"stringUnit":{"state":"translated","value":"Bearer トークン"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Bearer 令牌"}}}},
    "Configure local stdio processes or remote Streamable HTTP endpoints.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Konfiguriere lokale stdio-Prozesse oder entfernte Streamable-HTTP-Endpunkte."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルの stdio プロセスまたはリモートの Streamable HTTP エンドポイントを設定します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置本地 stdio 进程或远程 Streamable HTTP 端点。"}}}},
    "Endpoint URL": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Endpunkt-URL"}},"ja":{"stringUnit":{"state":"translated","value":"エンドポイント URL"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"端点 URL"}}}},
    "Enter a bearer token.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gib einen Bearer-Token ein."}},"ja":{"stringUnit":{"state":"translated","value":"Bearer トークンを入力してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 Bearer 令牌。"}}}},
    "Enter a valid MCP server URL using HTTPS, or HTTP for a local address.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gib eine gültige MCP-Server-URL mit HTTPS oder HTTP für eine lokale Adresse ein."}},"ja":{"stringUnit":{"state":"translated","value":"HTTPS、またはローカルアドレスには HTTP を使用した有効な MCP サーバー URL を入力してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入使用 HTTPS 的有效 MCP 服务器 URL，或为本地地址使用 HTTP。"}}}},
    "I understand that TypeWhisper will connect to this MCP server and may send configured workflow data.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ich verstehe, dass TypeWhisper eine Verbindung zu diesem MCP-Server herstellt und konfigurierte Workflow-Daten senden kann."}},"ja":{"stringUnit":{"state":"translated","value":"TypeWhisper がこの MCP サーバーに接続し、設定されたワークフローデータを送信する場合があることを理解しています。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我了解 TypeWhisper 将连接此 MCP 服务器，并可能发送已配置的工作流数据。"}}}},
    "None": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine"}},"ja":{"stringUnit":{"state":"translated","value":"なし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无"}}}},
    "Streamable HTTP": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Streamable HTTP"}},"ja":{"stringUnit":{"state":"translated","value":"Streamable HTTP"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Streamable HTTP"}}}},
    "The bearer token is stored in the macOS Keychain and sent only in the Authorization header.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Bearer-Token wird im macOS-Schlüsselbund gespeichert und nur im Authorization-Header gesendet."}},"ja":{"stringUnit":{"state":"translated","value":"Bearer トークンは macOS キーチェーンに保存され、Authorization ヘッダーでのみ送信されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Bearer 令牌存储在 macOS 钥匙串中，并且仅通过 Authorization 标头发送。"}}}},
    "Transport": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Transport"}},"ja":{"stringUnit":{"state":"translated","value":"トランスポート"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"传输方式"}}}},
    "Use only an MCP endpoint you trust. Tool calls can include text and context mapped by your workflow action.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verwende nur einen vertrauenswürdigen MCP-Endpunkt. Tool-Aufrufe können Text und Kontext enthalten, die deine Workflow-Aktion zuordnet."}},"ja":{"stringUnit":{"state":"translated","value":"信頼できる MCP エンドポイントのみを使用してください。ツール呼び出しには、ワークフローアクションでマッピングされたテキストやコンテキストが含まれる場合があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅使用你信任的 MCP 端点。工具调用可能包含工作流操作映射的文本和上下文。"}}}},
    "stdio": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"stdio"}},"ja":{"stringUnit":{"state":"translated","value":"stdio"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"stdio"}}}}
  },
  "version": "1.0"
}
