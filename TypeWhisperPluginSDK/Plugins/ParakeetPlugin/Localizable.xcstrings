    "The imported model files are removed from TypeWhisper. Your original files are not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die importierten Modelldateien werden aus TypeWhisper entfernt. Deine Originaldateien bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos del modelo importado se eliminan de TypeWhisper. Tus archivos originales no se modifican."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートしたモデルファイルをTypeWhisperから削除します。元のファイルは変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的模型文件将从 TypeWhisper 中移除。你的原始文件不会被更改。"
          }
        }
      }
    },
    "This model architecture is not supported by this plugin. Open the settings of a compatible plugin to import it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Modellarchitektur wird von diesem Plugin nicht unterstützt. Öffne zum Importieren die Einstellungen eines kompatiblen Plugins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plugin no admite esta arquitectura de modelo. Abre los ajustes de un plugin compatible para importarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインはこのモデルアーキテクチャに対応していません。対応するプラグインの設定を開いてインポートしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此插件不支持该模型架构。请打开兼容插件的设置进行导入。"
          }
        }
      }
    },
    "You can select the engine in Dictation settings and manage the model in Integrations.": {
      "localizations": {
        "de": {
