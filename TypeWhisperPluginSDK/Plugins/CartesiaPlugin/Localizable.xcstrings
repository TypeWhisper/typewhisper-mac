        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de API se guardan de forma segura en el llavero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーはキーチェーンに安全に保存されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥安全存储在钥匙串中"
