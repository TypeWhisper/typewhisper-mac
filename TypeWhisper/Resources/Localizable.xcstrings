        }
      }
    },
    "Core dictation stays free and open source. A commercial license unlocks Sync Dictionary & Snippets, Learn from Corrections, non-GPL terms, procurement, and support." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dictado básico sigue siendo gratuito y de código abierto. Una licencia comercial desbloquea Sincronizar diccionario y fragmentos, Aprender de las correcciones, condiciones no GPL, compras corporativas y soporte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本の音声入力は無料でオープンソースのままです。商用ライセンスで「辞書とスニペットの同期」「修正からの学習」、GPL以外の条件、調達、サポートが利用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核心听写功能始终免费且开源。商用许可证可解锁「同步词典与片段」「从更正中学习」、非 GPL 条款、采购和技术支持。"
          }
        }
      }
    },
    "Dictation, local engines, workflows, and add-ons" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictado, motores locales, flujos de trabajo y complementos"
