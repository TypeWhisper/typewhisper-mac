    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "One model for English, German, Spanish, French, Italian, Portuguese, Japanese, Korean, Chinese and Arabic. Detects the language when none is set. Does not use dictionary terms.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Modell für Englisch, Deutsch, Spanisch, Französisch, Italienisch, Portugiesisch, Japanisch, Koreanisch, Chinesisch und Arabisch. Erkennt die Sprache, wenn keine eingestellt ist. Verwendet keine Wörterbuchbegriffe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modelo para inglés, alemán, español, francés, italiano, portugués, japonés, coreano, chino y árabe. Detecta el idioma cuando no hay ninguno configurado. No usa los términos del diccionario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英語、ドイツ語、スペイン語、フランス語、イタリア語、ポルトガル語、日本語、韓国語、中国語、アラビア語に対応する1つのモデルです。言語が設定されていない場合は自動で検出します。辞書の用語は使用しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个模型支持英语、德语、西班牙语、法语、意大利语、葡萄牙语、日语、韩语、中文和阿拉伯语。未设置语言时会自动检测。不使用词典术语。"
          }
        }
      }
    },
