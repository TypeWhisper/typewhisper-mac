    "TypeWhisper" : {
      "comment" : "The title of the application.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper"
          }
