    "Unable to refresh models. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle konnten nicht aktualisiert werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron actualizar los modelos. Comprueba tu conexión y vuelve a intentarlo."
