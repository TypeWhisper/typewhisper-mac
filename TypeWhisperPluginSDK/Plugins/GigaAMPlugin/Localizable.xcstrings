          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を読み込んで有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并加载 %@"
          }
        }
      }
    },
