    "Invalid HuggingFace Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger HuggingFace-Token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なHuggingFaceトークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效的 HuggingFace 令牌"
          }
        }
      }
    },
    "Loaded": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加载"
          }
        }
      }
    },
    "Loading %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird geladen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を読み込み中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载 %@"
          }
        }
      }
    },
    "Loads on demand": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird bei Bedarf geladen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要時に読み込み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需加载"
          }
        }
      }
    },
    "Local Russian speech recognition with GigaAM v3 by Sber. Adds punctuation and capitalization and runs on the CPU. It only recognizes Russian, so recordings in other languages are transcribed as Russian.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale russische Spracherkennung mit GigaAM v3 von Sber. Setzt Satzzeichen und Großschreibung und läuft auf der CPU. Erkennt nur Russisch, daher werden Aufnahmen in anderen Sprachen als Russisch transkribiert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SberのGigaAM v3によるロシア語のローカル音声認識です。句読点と大文字を付け、CPUで動作します。ロシア語のみを認識するため、他の言語の録音もロシア語として文字起こしされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Sber 的 GigaAM v3 进行本地俄语语音识别。会添加标点和大小写，并在 CPU 上运行。仅识别俄语，因此其他语言的录音也会按俄语转写。"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "Optional. Increases download rate limits. Free at huggingface.co/settings/tokens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Erhöht Download-Rate-Limits. Kostenlos unter huggingface.co/settings/tokens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション。ダウンロードレート制限を引き上げます。huggingface.co/settings/tokensで無料で取得可能です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。提高下载速率限制。在 huggingface.co/settings/tokens 免费获取。"
          }
        }
      }
    },
