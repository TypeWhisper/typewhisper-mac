    "Local speech-to-text and translation by IBM, powered by MLX on Apple Silicon. 6 languages with bidirectional translation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Spracherkennung und Übersetzung von IBM mit MLX auf Apple Silicon. 6 Sprachen mit bidirektionaler Übersetzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voz a texto y traducción locales de IBM, con MLX en Apple Silicon. 6 idiomas con traducción en ambas direcciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon向けMLXによるIBMのローカル音声認識および翻訳。6言語に対応し、双方向翻訳が可能です。"
