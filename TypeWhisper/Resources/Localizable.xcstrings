        }
      }
    },
    "Importing a backup skips unchanged items. Choose Replace existing items when you want to update matching workflows, profiles and prompt actions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Import einer Sicherung werden unveränderte Einträge übersprungen. Wähle „Vorhandene Einträge ersetzen“, um gleichnamige Workflows, Profile und Prompt-Aktionen zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al importar una copia de seguridad se omiten los elementos sin cambios. Elige “Reemplazar elementos existentes” cuando quieras actualizar flujos de trabajo, perfiles y acciones de prompt que coincidan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの読み込みでは、変更のない項目をスキップします。同名のワークフロー、プロファイル、プロンプトアクションを更新するには「既存の項目を置き換える」を選びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入备份时会跳过未更改的项目。选择“替换现有项目”，即可更新同名的工作流、配置文件和提示词操作。"
          }
