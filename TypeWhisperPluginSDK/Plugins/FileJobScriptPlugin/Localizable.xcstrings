            "value": "Nuevo script"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいスクリプト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新脚本"
          }
        }
      }
    },
    "Untitled Script": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbenanntes Skript"
          }
        },
        "es": {
