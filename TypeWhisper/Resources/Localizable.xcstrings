        }
      }
    },
    "Use the grant access button to continue setup.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス許可ボタンを使用してセットアップを続行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 的 授予 访问 按钮 到 继续 setup."
          }
        }
      }
    },
    "Use these phrases with %@ in any text field. If the native output already matches the expected result, keep Native. Otherwise use Fallback for this combination.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のテキスト入力欄で %@ を使って、以下のフレーズを試してください。ネイティブ出力が期待結果と一致する場合は「ネイティブ」のままにします。一致しない場合は、この組み合わせで「フォールバック」を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 这些 phrases 带 %@ 在 任何 文本 字段. If 的 原生 输出 已经 匹配 的 预期 结果, 保持 原生. 否则 使用 回退 为 这个 combination."
          }
        }
      }
    },
    "Use this if you already bought a commercial or supporter license and want to manage it in Polar.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに商用またはサポーターライセンスを購入済みで、Polarで管理したい場合はこちらを使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 这个 如果 你 已经 bought a 商业 或 支持者 许可证 与 想要 到 管理 它 在 Polar."
          }
        }
      }
    },
