    "This removes the account and entitlement link. Local entries and private cloud files are not deleted." : {
      "comment" : "A message displayed in a confirmation alert when the user deletes their premium account.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina la cuenta y el vínculo con el acceso. Las entradas locales y los archivos privados en la nube no se eliminan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会移除账户及其权益关联。本地条目和专用云端文件不会被删除。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントと利用権の紐づけを削除します。このMacの項目や非公開のクラウドファイルは削除されません。"
          }
        }
      }
    },
    "This shortcut is already part of the workflow." : {
