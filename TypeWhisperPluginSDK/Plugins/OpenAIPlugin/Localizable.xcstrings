{
  "sourceLanguage": "en",
  "strings": {
    "API Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        }
      }
    },
    "API keys are stored securely in the Keychain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel werden sicher im Schlüsselbund gespeichert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーはキーチェーンに安全に保存されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥安全存储在钥匙串中"
          }
        }
      }
    },
    "ChatGPT Login": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT-Login"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPTログイン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 登录"
          }
        }
      }
    },
    "ChatGPT login connected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT-Login verbunden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPTログインが接続済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 登录已连接"
          }
        }
      }
    },
    "ChatGPT login connected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT-Login verbunden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPTログインが接続済み。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 登录已连接。"
          }
        }
      }
    },
    "ChatGPT login exposes only the supported ChatGPT/Codex models.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ChatGPT-Login zeigt nur die unterstuetzten ChatGPT-/Codex-Modelle an."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPTログインはサポートされているChatGPT/Codexモデルのみを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 登录仅显示支持的 ChatGPT/Codex 模型。"
          }
        }
      }
    },
    "Complete the OpenAI login in your browser. TypeWhisper will finish the connection automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schliessen Sie den OpenAI-Login im Browser ab. TypeWhisper verbindet den Account danach automatisch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでOpenAIログインを完了してください。TypeWhisperはその後自動でアカウントを接続します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中完成 OpenAI 登录。TypeWhisper 会自动完成连接。"
          }
        }
      }
    },
    "Connected plan: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbundener Plan: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済みプラン: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接套餐：%@"
          }
        }
      }
    },
    "Connection Method": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungsmethode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続方法"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接方式"
          }
        }
      }
    },
    "Describe the recording topic, setting, or relevant context.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie Thema, Umgebung oder relevanten Kontext der Aufnahme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音のトピック、状況、または関連するコンテキストを説明します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述录音主题、环境或相关上下文。"
          }
        }
      }
    },
    "GPT-4o models do not support Whisper Translate (translation to English).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-4o-Modelle unterstützen Whisper Translate (Übersetzung ins Englische) nicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-4oモデルはWhisper Translate（英語への翻訳）をサポートしていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-4o 模型不支持 Whisper 翻译（翻译为英语）。"
          }
        }
      }
    },
    "Language hints and dictionary terms are added automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachhinweise und Wörterbucheinträge werden automatisch ergänzt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語ヒントと辞書用語は自動的に追加されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言提示和词典术语会自动添加。"
          }
        }
      }
    },
    "Live Transcription Delay": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzögerung der Live-Transkription"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ文字起こしの遅延"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时转录延迟"
          }
        }
      }
    },
    "Lower delay shows partial text sooner; higher delay gives the model more audio context.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine niedrigere Verzögerung zeigt Teiltext früher; eine höhere gibt dem Modell mehr Audiokontext."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅延を低くすると部分テキストが早く表示され、高くするとモデルがより多くの音声コンテキストを利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较低的延迟会更快显示部分文本；较高的延迟为模型提供更多音频上下文。"
          }
        }
      }
    },
    "Minimal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最小"
          }
        }
      }
    },
    "Realtime transcription streams 24 kHz PCM through OpenAI's Realtime API.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Echtzeittranskription streamt 24-kHz-PCM über die Realtime API von OpenAI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイム文字起こしは、OpenAIのRealtime APIを通じて24 kHz PCMをストリーミングします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时转录通过 OpenAI Realtime API 流式传输 24 kHz PCM 音频。"
          }
        }
      }
    },
    "Transcription Context": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptionskontext"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしコンテキスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录上下文"
          }
        }
      }
    },
    "Translate requires Whisper 1.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Übersetzungen ist Whisper 1 erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳にはWhisper 1が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译需要 Whisper 1。"
          }
        }
      }
    },
    "X High": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr hoch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
