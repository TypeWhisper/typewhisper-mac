        }
      }
    },
    "The text field changed. The final transcript is available in Recent Transcriptions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Textfeld wurde geändert. Das endgültige Transkript ist unter „Letzte Transkriptionen“ verfügbar."
          }
        },
        "ja" : {
          "stringUnit" : {
