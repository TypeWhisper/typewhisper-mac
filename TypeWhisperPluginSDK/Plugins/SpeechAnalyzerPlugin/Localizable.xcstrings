            "state": "translated",
            "value": "Descargando el modelo de idioma..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声モデルをダウンロード中..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载语言模型..."
          }
        }
      }
    },
    "Loading available languages...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbare Sprachen werden geladen ..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando los idiomas disponibles..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な言語を読み込み中..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载可用语言..."
          }
        }
      }
    },
    "On-device speech recognition via Apple's Speech framework with streaming support. Select a language model below - only one can be active at a time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätebasierte Spracherkennung über Apples Speech-Framework mit Streaming-Unterstützung. Wähle unten ein Sprachmodell - es kann jeweils nur eines aktiv sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconocimiento de voz en el dispositivo con el framework Speech de Apple y transcripción en tiempo real. Selecciona abajo un modelo de idioma; solo puede haber uno activo a la vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスベースの音声認識は、AppleのSpeech-Frameworkを使用し、ストリーミングをサポートしています。下から音声モデルを選択してください。一度に1つしかアクティブにできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple Speech 框架实现设备端语音识别，支持流式传输。请从下方选择一个语言模型——一次仅可激活一个。"
          }
        }
      }
    },
