    "Your activity will appear here after your first transcription." : {
      "comment" : "A description displayed when the user's activity chart is empty, explaining that it will populate once they make their first transcription.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aktivität erscheint hier nach deiner ersten Transkription."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu actividad aparecerá aquí después de tu primera transcripción."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の音声認識後、あなたの活動がここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
