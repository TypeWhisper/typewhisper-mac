{
  "sourceLanguage": "en",
  "strings": {
    "Hide API key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel ausblenden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーを非表示にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏 API 密钥"
          }
        }
      }
    },
    "Refresh LLM models": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM-Modelle aktualisieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LLMモデルを更新"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新 LLM 模型"
          }
        }
      }
    },
    "Remove API key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel entfernen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーを削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 API 密钥"
          }
        }
      }
    },
    "Save API key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel sichern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーを保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存 API 密钥"
          }
        }
      }
    },
    "Show API key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel anzeigen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーを表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 API 密钥"
          }
        }
      }
    },
    "Send dictionary terms": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörterbuchbegriffe senden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書の用語を送信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送词典术语"
          }
        }
      }
    },
    "Off by default because dictionary terms can make Groq skip parts of a dictation. Dictionary corrections after transcription apply either way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus, weil Groq mit Wörterbuchbegriffen Teile eines Diktats auslassen kann. Wörterbuchkorrekturen nach der Transkription gelten in jedem Fall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書の用語を送信するとGroqが口述の一部を省略することがあるため、既定ではオフです。文字起こし後の辞書による修正は常に適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，因为发送词典术语可能导致 Groq 漏掉部分听写内容。转写后的词典纠正始终生效。"
          }
        }
      }
    },
    "API Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        }
      }
    },
    "API keys are stored in a private file on this Mac": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel werden in einer privaten Datei auf diesem Mac gespeichert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーはこのMac上の非公開ファイルに保存されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥保存在这台 Mac 上的私有文件中"
          }
        }
      }
    },
