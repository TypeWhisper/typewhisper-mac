    },
    "Could not validate API Key. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Key konnte nicht geprüft werden. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo validar la clave de API. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーの検証に失敗しました。接続を確認し、再度試してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证 API 密钥。请检查连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證 API 金鑰。請檢查連線後重試。"
