    "The download timed out. Try again. An optional Hugging Face token in this plugin can raise download rate limits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download hat zu lange gedauert. Versuche es erneut. Ein optionaler Hugging-Face-Token in diesem Plugin kann die Download-Rate-Limits erhöhen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de la descarga. Vuelve a intentarlo. Un token opcional de Hugging Face en este plugin puede aumentar los límites de descarga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードがタイムアウトしました。もう一度お試しください。このプラグインにHugging Faceトークンを追加すると、ダウンロードのレート制限が緩和される場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载超时。请重试。在此插件中添加可选的 Hugging Face 令牌可以提高下载速率限制。"
          }
        }
      }
    },
    "The downloaded llama.cpp runtime is incomplete.": {
