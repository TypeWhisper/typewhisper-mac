            "value" : "可用"
          }
        }
      }
    },
    "Available from the Workflow Palette. It never runs automatically after dictation." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible desde la paleta de flujos de trabajo. Nunca se ejecuta automáticamente después del dictado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークフローパレットから利用可能です。音声入力後に自動的に実行されることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可从工作流面板手动运行，听写结束后不会自动执行。"
          }
        }
      }
    },
