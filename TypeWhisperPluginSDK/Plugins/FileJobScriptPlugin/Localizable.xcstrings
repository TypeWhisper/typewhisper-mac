{
  "sourceLanguage": "en",
  "strings": {
    "File Job Script": {
      "shouldTranslate": false
    },
    "New Script": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neues Skript"
          }
        },
        "es": {
