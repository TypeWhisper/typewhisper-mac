            "value": "HuggingFace 令牌"
          }
        }
      }
    },
    "Import": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入"
          }
        }
      }
    },
    "Import Model…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell importieren …"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをインポート…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入模型…"
          }
        }
      }
    },
    "Import Speech Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracherkennungsmodell importieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識モデルをインポート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入语音识别模型"
          }
        }
      }
    },
    "Imported and loaded: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiert und geladen: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート・読み込み完了：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入并加载：%@"
          }
        }
      }
    },
    "Imported model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiertes Modell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートしたモデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入的模型"
          }
        }
      }
    },
    "Importing and loading with %@…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren und Laden mit %@ …"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@でインポート・読み込み中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用 %@ 导入并加载…"
          }
        }
      }
    },
    "Invalid HuggingFace Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger HuggingFace-Token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なHuggingFaceトークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效的 HuggingFace 令牌"
          }
        }
      }
    },
    "Load": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载"
          }
        }
      }
    },
    "Local Canary speech recognition on Apple Silicon, including Sophea for Greek and English. Select an explicit source language in Dictation settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Canary-Spracherkennung auf Apple Silicon, einschließlich Sophea für Griechisch und Englisch. Wähle in den Diktateinstellungen eine konkrete Ausgangssprache."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Siliconで動作するローカルCanary音声認識。ギリシャ語と英語のSopheaに対応します。音声入力設定で入力言語を指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Silicon 上运行本地 Canary 语音识别，包括支持希腊语和英语的 Sophea。请在听写设置中选择具体的源语言。"
          }
        }
      }
    },
    "Local Folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaler Ordner"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルフォルダ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地文件夹"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "No folder selected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ordner ausgewählt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择文件夹"
          }
        }
      }
    },
    "Optional. Increases download rate limits. Free at huggingface.co/settings/tokens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Erhöht Download-Rate-Limits. Kostenlos unter huggingface.co/settings/tokens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション。ダウンロードレート制限を引き上げます。huggingface.co/settings/tokensで無料で取得可能です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。提高下载速率限制。在 huggingface.co/settings/tokens 免费获取。"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Source": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソース"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源"
          }
        }
      }
    },
    "This model architecture is not supported by this plugin. Open the settings of a compatible plugin to import it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Modellarchitektur wird von diesem Plugin nicht unterstützt. Öffne zum Importieren die Einstellungen eines kompatiblen Plugins."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインはこのモデルアーキテクチャに対応していません。対応するプラグインの設定を開いてインポートしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此插件不支持该模型架构。请打开兼容插件的设置进行导入。"
          }
        }
      }
    },
    "Unload": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载"
          }
        }
      }
    },
    "Valid HuggingFace Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gültiger HuggingFace-Token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なHuggingFaceトークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效的 HuggingFace 令牌"
          }
        }
      }
    },
    "Validating token...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token wird geprüft..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンの検証中..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证令牌..."
          }
        }
      }
    },
    "You can select the engine in Dictation settings and manage the model in Integrations.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Engine in den Diktateinstellungen auswählen und das Modell unter Integrationen verwalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力設定でエンジンを選択し、連携でモデルを管理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在听写设置中选择引擎，在集成中管理模型。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
