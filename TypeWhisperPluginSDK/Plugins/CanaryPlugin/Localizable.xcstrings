{
  "sourceLanguage": "en",
  "strings": {
    "A token is only needed for private or gated models. It is used for this import and is not saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Token ist nur für private oder zugangsbeschränkte Modelle nötig. Es wird für diesen Import verwendet und nicht gespeichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開またはアクセス制限のあるモデルにのみトークンが必要です。このインポートにのみ使用され、保存されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅私有或受限模型需要令牌。令牌仅用于此次导入，不会保存。"
          }
        }
      }
    },
    "Add a model compatible with this plugin. The model is checked and loaded before the import completes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein mit diesem Plugin kompatibles Spracherkennungsmodell hinzu. Das Modell wird vor Abschluss des Imports geprüft und geladen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインに対応したモデルを追加します。インポートが完了する前に、モデルの検証と読み込みが行われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加与此插件兼容的语音识别模型。导入完成前会检查并加载模型。"
          }
        }
      }
    },
    "Canary needs an explicit source language. Choose Greek or English for Sophea in Dictation settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary braucht eine konkrete Ausgangssprache. Wähle für Sophea Griechisch oder Englisch in den Diktateinstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Canaryでは入力言語の指定が必要です。Sopheaを使う場合は、音声入力設定でギリシャ語または英語を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary 需要明确指定源语言。使用 Sophea 时，请在听写设置中选择希腊语或英语。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cancelling…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird abgebrochen …"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在取消…"
          }
        }
      }
    },
    "Checking model compatibility…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellkompatibilität wird geprüft …"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの互換性を確認中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查模型兼容性…"
          }
        }
      }
    },
    "Choose Folder…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner auswählen …"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選択…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件夹…"
          }
        }
      }
    },
    "Choose the folder containing config.json, tokenizer files and weights. TypeWhisper keeps its own copy; your original files are not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner mit config.json, Tokenizer-Dateien und Gewichten. TypeWhisper erstellt eine eigene Kopie; deine Originaldateien bleiben unverändert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "config.json、トークナイザー、重みを含むフォルダを選択してください。TypeWhisperはコピーを保存し、元のファイルは変更しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择包含 config.json、分词器文件和权重的文件夹。TypeWhisper 会保存副本，不会修改原始文件。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Download & Load": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden & Aktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み & 有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并加载"
          }
        }
      }
    },
    "Hugging Face model URL": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging-Face-Modell-URL"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging FaceモデルのURL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face 模型网址"
          }
