    "audiocpp_server %@ is running on 127.0.0.1:%@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ se está ejecutando en 127.0.0.1:%@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@は127.0.0.1:%@で実行中です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ läuft auf 127.0.0.1:%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ 正在 127.0.0.1:%@ 上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ 正在 127.0.0.1:%@ 上執行。"
          }
        }
      }
    },
    "audiocpp_server %@ starts with the first dictation and restarts if it stops.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ se inicia con el primer dictado y se reinicia si se detiene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@は最初の音声入力時に起動し、停止した場合は再起動します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ startet mit dem ersten Diktat und wird neu gestartet, falls er beendet wird."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ 会在第一次听写时启动，停止后会自动重启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server %@ 會在第一次聽寫時啟動，停止後會自動重新啟動。"
          }
        }
      }
    },
