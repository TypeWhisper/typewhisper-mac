    "ChatGPT login uses the supported ChatGPT/Codex model list. Use API Key mode for the full OpenAI API catalog.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de ChatGPT usa la lista de modelos compatibles de ChatGPT/Codex. Usa el modo Clave de API para el catálogo completo de la API de OpenAI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPTログインでは、対応するChatGPT/Codexモデルの一覧を使用します。OpenAI APIの全モデルを使用するには、APIキーモードを選んでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ChatGPT-Anmeldung verwendet die unterstützte ChatGPT-/Codex-Modellliste. Verwende den API-Schlüssel-Modus für den vollständigen OpenAI-API-Katalog."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 登录使用受支持的 ChatGPT/Codex 模型列表。如需完整的 OpenAI API 模型目录，请使用 API 密钥模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT 登入使用受支援的 ChatGPT/Codex 模型清單。如需完整的 OpenAI API 模型目錄，請使用 API 金鑰模式。"
          }
        }
      }
    },
    "Could not refresh models. Keeping the current list.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron actualizar los modelos. Se mantiene la lista actual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを更新できませんでした。現在の一覧を保持します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle konnten nicht aktualisiert werden. Die aktuelle Liste bleibt erhalten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法刷新模型，将保留当前列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新整理模型，將保留目前清單。"
          }
        }
      }
    },
