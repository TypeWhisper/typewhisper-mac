    "Delete the downloaded model?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード済みのモデルを削除しますか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geladene Modell löschen?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除已下载的模型？"
