{
  "sourceLanguage": "en",
  "strings": {
    "audiocpp_server with a confucius4_r2t2 model in streaming mode.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server con un modelo confucius4_r2t2 en modo de transmisión en tiempo real."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "confucius4_r2t2モデルをストリーミングモードで実行するaudiocpp_server。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "audiocpp_server mit einem confucius4_r2t2-Modell im Streaming-Modus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 confucius4_r2t2 模型（流式模式）的 audiocpp_server。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 confucius4_r2t2 模型（流式模式）的 audiocpp_server。"
          }
        }
      }
    },
    "Audio is streamed as 16 kHz PCM only to the audio.cpp server configured here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se transmite como PCM a 16 kHz solo al servidor audio.cpp configurado aquí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は16 kHz PCM形式で、ここで設定したaudio.cppサーバーにのみストリーミング送信されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird als 16-kHz-PCM nur an den hier eingestellten audio.cpp-Server gestreamt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频以 16 kHz PCM 流式传输，仅发送到此处配置的 audio.cpp 服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊以 16 kHz PCM 流式傳輸，僅傳送到此處設定的 audio.cpp 伺服器。"
          }
        }
      }
    },
