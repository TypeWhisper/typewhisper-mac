    "The private sync folder was deleted. Local data was kept." : {
      "comment" : "Message displayed when the user deletes the private sync folder.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专用同步文件夹已删除。本地数据已保留。"
          }
        }
      }
    },
    "The selected action target is not currently enabled or installed. Saving keeps it unless you choose Insert Text or another action." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したアクション出力先は現在有効でないか、インストールされていません。「テキストを挿入」または別のアクションを選ばない限り、保存後も設定は保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选操作目标当前未启用或未安装。保存时将保留此设置，除非改为“插入文本”或其他操作。"
          }
        }
      }
    },
    "The selected microphone conflicts with your current audio routing. Disconnect Bluetooth or choose a different input." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したマイクが現在のオーディオルーティングと競合しています。Bluetoothを切断するか、別の入力を選択してください。"
          }
        },
        "zh-Hans" : {
