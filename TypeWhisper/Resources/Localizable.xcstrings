        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper"
          }
        }
      }
    },
    "TypeWhisper can watch the target text field briefly after direct dictation insertion and learn only confident corrections. Ambiguous edits are skipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper kann das Ziel-Textfeld kurz nach direktem Diktat-Einfügen beobachten und nur sichere Korrekturen lernen. Uneindeutige Bearbeitungen werden übersprungen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper 可在直接听写插入后短暂监视目标文本框，仅学习明确可信的纠正。含义不明确的编辑会被跳过。"
          }
        }
      }
    },
    "TypeWhisper Dev" : {
      "comment" : "The name of the app in development mode.",
      "isCommentAutoGenerated" : true,
