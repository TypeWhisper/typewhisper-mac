{
  "sourceLanguage": "en",
  "strings": {
    "Remove credentials": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten entfernen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar credenciales"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報を削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除凭据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除憑證"
          }
        }
      }
    },
    "Cloud Speech-to-Text API is not enabled for this Google Cloud project. Enable speech.googleapis.com in Google Cloud, wait a few minutes, and retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud Speech-to-Text API ist für dieses Google-Cloud-Projekt nicht aktiviert. Aktiviere speech.googleapis.com in Google Cloud, warte einige Minuten und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La API Cloud Speech-to-Text no está activada para este proyecto de Google Cloud. Activa speech.googleapis.com en Google Cloud, espera unos minutos y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このGoogle CloudプロジェクトでCloud Speech-to-Text APIが有効になっていません。Google Cloudでspeech.googleapis.comを有効化し、数分待ってから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Google Cloud 项目未启用 Cloud Speech-to-Text API。请在 Google Cloud 中启用 speech.googleapis.com，等待几分钟后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Google Cloud 專案未啟用 Cloud Speech-to-Text API。請在 Google Cloud 中啟用 speech.googleapis.com，等待幾分鐘後重試。"
          }
        }
      }
    },
    "Credentials look valid and Speech-to-Text is reachable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zugangsdaten sind gültig und Speech-to-Text ist erreichbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales parecen válidas y se puede acceder a Speech-to-Text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報は有効で、Speech-to-Textに接続できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭据有效，Speech-to-Text 可访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證有效，Speech-to-Text 可存取。"
          }
        }
      }
    },
    "Default Language": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardsprache"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma predeterminado"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定の言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认语言"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設語言"
          }
        }
      }
    },
    "Google Cloud billing is not enabled for this project. Enable billing for the project and retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Projekt ist die Google-Cloud-Abrechnung nicht aktiviert. Aktiviere die Abrechnung für das Projekt und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La facturación de Google Cloud no está activada para este proyecto. Activa la facturación del proyecto y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトでGoogle Cloudの請求が有効になっていません。プロジェクトの請求を有効化してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目未启用 Google Cloud 结算功能。请为项目启用结算后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此專案未啟用 Google Cloud 結算功能。請為專案啟用結算後重試。"
          }
        }
      }
    },
    "Google Cloud rate-limited the request. Please wait a moment and retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Cloud hat die Anfrage gedrosselt. Warte kurz und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Cloud limitó la solicitud. Espera un momento y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Cloudによりリクエストがレート制限されました。少し待ってから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Cloud 对请求进行了速率限制。请稍候重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Cloud 對請求進行了速率限制。請稍候重試。"
          }
        }
      }
    },
    "Google denied access to Speech-to-Text. Make sure the API is enabled and the service account has the Cloud Speech Client role.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hat den Zugriff auf Speech-to-Text verweigert. Stelle sicher, dass die API aktiviert ist und das Dienstkonto die Rolle „Cloud Speech Client“ besitzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google denegó el acceso a Speech-to-Text. Asegúrate de que la API esté activada y de que la cuenta de servicio tenga el rol Cloud Speech Client."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GoogleがSpeech-to-Textへのアクセスを拒否しました。APIが有効で、サービスアカウントにCloud Speech Clientロールがあることを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 拒绝对 Speech-to-Text 的访问。请确保 API 已启用且服务账户具有 Cloud Speech Client 角色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 拒絕對 Speech-to-Text 的存取。請確保 API 已啟用且服務帳戶具有 Cloud Speech Client 角色。"
          }
        }
      }
    },
    "Google rejected the service-account credentials.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hat die Dienstkonto-Zugangsdaten abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google rechazó las credenciales de la cuenta de servicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleがサービスアカウント認証情報を拒否しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 拒绝了服务账户凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 拒絕了服務帳戶憑證。"
          }
        }
      }
    },
    "Google rejected the service-account credentials. Check that you pasted the full JSON key file for the correct project.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hat die Dienstkonto-Zugangsdaten abgelehnt. Prüfe, ob du die vollständige JSON-Schlüsseldatei für das richtige Projekt eingefügt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google rechazó las credenciales de la cuenta de servicio. Comprueba que pegaste el archivo de clave JSON completo del proyecto correcto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleがサービスアカウント認証情報を拒否しました。正しいプロジェクトのJSONキーファイル全体を貼り付けたか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 拒绝了服务账户凭据。请确认您粘贴了正确项目的完整 JSON 密钥文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 拒絕了服務帳戶憑證。請確認您貼上了正確專案的完整 JSON 金鑰檔案。"
          }
        }
      }
    },
    "Google Speech-to-Text does not accept simple API keys. Paste a Google Cloud service-account JSON key here. Credentials are stored in the macOS Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Speech-to-Text akzeptiert keine einfachen API-Schlüssel. Füge hier den JSON-Schlüssel eines Google-Cloud-Dienstkontos ein. Die Zugangsdaten werden im macOS-Schlüsselbund gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Speech-to-Text no acepta claves de API simples. Pega aquí la clave JSON de una cuenta de servicio de Google Cloud. Las credenciales se guardan en el llavero de macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Speech-to-Textでは単純なAPIキーは使えません。Google CloudのサービスアカウントJSONキー全体をここに貼り付けてください。認証情報はmacOSキーチェーンに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Speech-to-Text 不接受简单的 API 密钥。请在此粘贴 Google Cloud 服务账户 JSON 密钥。凭据将存储在 macOS 钥匙串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Speech-to-Text 不接受簡單的 API 金鑰。請在此貼上 Google Cloud 服務帳戶 JSON 金鑰。憑證將儲存在 macOS 鑰匙圈中。"
          }
        }
      }
    },
    "If TypeWhisper already passes a spoken language, that value wins. Otherwise this BCP-47 code is used for Google recognition requests.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn TypeWhisper bereits eine gesprochene Sprache übergibt, hat dieser Wert Vorrang. Andernfalls wird dieser BCP-47-Code für die Spracherkennungsanfragen an Google verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si TypeWhisper ya envía un idioma hablado, ese valor tiene prioridad. Si no, se usa este código BCP-47 en las solicitudes de reconocimiento a Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeWhisperから発話言語が渡される場合は、その値が優先されます。それ以外の場合、このBCP-47コードがGoogle認識リクエストに使われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 TypeWhisper 已传递口语语言，则使用该值。否则，此 BCP-47 代码将用于 Google 识别请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 TypeWhisper 已傳遞口語語言，則使用該值。否則，此 BCP-47 程式碼將用於 Google 辨識請求。"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "No Google recognition model is selected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Google-Spracherkennungsmodell ausgewählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún modelo de reconocimiento de Google seleccionado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google認識モデルが選択されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择 Google 识别模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未選擇 Google 辨識模型。"
          }
        }
      }
    },
    "No service-account JSON is configured yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist noch kein Dienstkonto-JSON konfiguriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ningún JSON de cuenta de servicio configurado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスアカウントJSONがまだ設定されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配置服务账户 JSON。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定服務帳戶 JSON。"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "de": {
