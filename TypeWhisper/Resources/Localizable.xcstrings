        }
      }
    },
    "Synchronized entries remain in your private sync folder. The device will reappear if it syncs again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierte Einträge bleiben in deinem privaten Synchronisierungsordner. Das Gerät erscheint wieder, sobald es erneut synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas sincronizadas permanecen en tu carpeta privada de sincronización. El dispositivo reaparecerá si se vuelve a sincronizar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
