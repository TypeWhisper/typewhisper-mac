    "LLM Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM-Modell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LLMモデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM 模型"
          }
        }
      }
    },
    "Controls how much thinking time the model spends before answering.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert, wie viel Denkzeit sich das Modell vor der Antwort nimmt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが回答前にどのくらい考える時間を取るかを制御します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制模型在回答前花费多少思考时间。"
          }
        }
      }
    },
