    "Press a key combination...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkombination drücken..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona una combinación de teclas..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードショートカットを押してください..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下组合键..."
          }
        }
      }
    },
    "Record Shortcut": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnehmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar atajo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制快捷键"
          }
        }
      }
    },
    "Show or hide the transcript window with a keyboard shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript-Fenster mit einem Tastenkürzel ein- oder ausblenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta la ventana de transcripción con un atajo de teclado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードショートカットでテキストウィンドウを表示または非表示にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用键盘快捷键显示或隐藏转录窗口。"
          }
        }
      }
    },
    "Show the transcript window automatically when recording starts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript-Fenster automatisch bei Aufnahmestart anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la ventana de transcripción automáticamente cuando empieza la grabación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音開始時にテキストウィンドウを自動で表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音开始时自动显示转录窗口。"
          }
        }
      }
    },
    "Toggle Shortcut": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkürzel"
          }
