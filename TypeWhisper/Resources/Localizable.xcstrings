    "Replaces every regex match. Use \\n for a new line, \\t for a tab, \\s for a space, or \\\\ for a backslash. $1 stays literal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt jeden Regex-Treffer. Verwende \\n für einen Zeilenumbruch, \\t für einen Tabulator, \\s für ein Leerzeichen oder \\\\ für einen Backslash. $1 bleibt wörtlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplaza cada coincidencia de la regex. Usa \\n para un salto de línea, \\t para un tabulador, \\s para un espacio o \\\\ para una barra invertida. $1 se mantiene literal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正規表現に一致する箇所をすべて置換します。改行は \\n、タブは \\t、スペースは \\s、バックスラッシュは \\\\ を使います。$1 はそのまま挿入されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替换所有正则表达式匹配项。使用 \\n 换行、\\t 插入制表符、\\s 插入空格、\\\\ 插入反斜杠。$1 按原样插入。"
          }
        }
      }
    },
