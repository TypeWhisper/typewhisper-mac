    },
    "Enhanced provides the best accuracy. Standard is faster and more cost-effective.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhanced bietet die beste Genauigkeit. Standard ist schneller und kosteneffizienter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhanced ofrece la mejor precisión. Standard es más rápido y económico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhancedは最高の精度を提供します。Standardはより高速でコスト効率が良いです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强模式提供最佳准确度。标准模式更快且更具性价比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強模式提供最佳準確度。標準模式更快且更具價效比。"
          }
        }
      }
    },
