    "Controls how much thinking time the model spends before answering.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが回答前にどのくらい考える時間を取るかを制御します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert, wie viel Denkzeit sich das Modell vor der Antwort nimmt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制模型在回答前花费多少思考时间。"
          }
        }
      }
    },
    "Applies when a workflow leaves effort on Provider Default. Higher levels are slower and use more output tokens.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークフローで思考負荷が「プロバイダーのデフォルト」のままの場合に適用されます。レベルが高いほど遅くなり、出力トークンも多く消費します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt, wenn ein Workflow den Denkaufwand auf „Anbieterstandard“ lässt. Höhere Stufen sind langsamer und verbrauchen mehr Ausgabe-Tokens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当工作流的推理力度保持为“提供商默认”时生效。级别越高，速度越慢，消耗的输出 token 也越多。"
          }
        }
      }
    },
    "The selected model doesn't support reasoning effort.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したモデルは思考負荷の設定に対応していません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Modell unterstützt keinen einstellbaren Denkaufwand."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选模型不支持设置推理力度。"
          }
        }
      }
    },
    "Model Default": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのデフォルト"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellstandard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型默认"
          }
        }
      }
    },
    "Model Default (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのデフォルト（%@）"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellstandard (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型默认（%@）"
          }
        }
      }
    },
    "%@ isn't available for this model, so requests use the model default.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はこのモデルでは使用できないため、モデルのデフォルトが使われます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist für dieses Modell nicht verfügbar, daher gilt der Modellstandard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型不支持“%@”，因此请求将使用模型默认值。"
          }
        }
      }
    },
    "Custom temperature is ignored for this model or while a reasoning effort is set.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルでは、または思考負荷を設定している間は、カスタム温度は無視されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die benutzerdefinierte Temperatur wird bei diesem Modell oder bei eingestelltem Denkaufwand ignoriert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于此模型或已设置推理力度时，自定义温度将被忽略。"
          }
        }
      }
    },
    "Prompt Caching": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトキャッシュ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt-Caching"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示缓存"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        },
        "de": {
