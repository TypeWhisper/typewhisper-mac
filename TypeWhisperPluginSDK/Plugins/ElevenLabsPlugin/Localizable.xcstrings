    "Audio events and Clean transcript can be enabled together.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Audioereignisse“ und „Bereinigtes Transkript“ können gleichzeitig aktiviert werden."
