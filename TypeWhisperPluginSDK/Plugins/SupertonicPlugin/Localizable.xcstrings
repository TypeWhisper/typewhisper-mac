    "I have read and accept the Supertonic 3 model license terms": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe die Lizenzbedingungen für das Supertonic-3-Modell gelesen und akzeptiere sie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He leído y acepto las condiciones de la licencia del modelo Supertonic 3"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Supertonic 3モデルのライセンス条項を読み、同意します"
