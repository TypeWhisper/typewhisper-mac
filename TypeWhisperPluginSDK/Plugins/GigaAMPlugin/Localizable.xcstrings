    "Loads on demand": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird bei Bedarf geladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga cuando se necesita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要時に読み込み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需加载"
          }
        }
      }
    },
    "GigaAM by Sber transcribes locally on the CPU with punctuation and capitalization. Choose v3 for Russian, v4 for Russian and English, or Multilingual v2 for 21 languages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GigaAM von Sber transkribiert lokal auf der CPU mit Satzzeichen und Großschreibung. Wähle v3 für Russisch, v4 für Russisch und Englisch oder Multilingual v2 für 21 Sprachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GigaAM de Sber transcribe localmente en la CPU con puntuación y mayúsculas. Elige v3 para ruso, v4 para ruso e inglés o Multilingual v2 para 21 idiomas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SberのGigaAMはCPU上でローカルに文字起こしを行い、句読点と大文字を補います。ロシア語にはv3、ロシア語と英語にはv4、21言語にはMultilingual v2を選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sber 的 GigaAM 在本机 CPU 上转写语音，并自动添加标点和处理大小写。v3 支持俄语，v4 支持俄语和英语，Multilingual v2 支持 21 种语言。"
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "Optional. Increases download rate limits. Free at huggingface.co/settings/tokens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Erhöht Download-Rate-Limits. Kostenlos unter huggingface.co/settings/tokens"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Aumenta los límites de descarga. Gratis en huggingface.co/settings/tokens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション。ダウンロードレート制限を引き上げます。huggingface.co/settings/tokensで無料で取得可能です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。提高下载速率限制。在 huggingface.co/settings/tokens 免费获取。"
          }
        }
      }
    },
