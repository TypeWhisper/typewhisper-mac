            "state": "translated",
            "value": "温度模式"
          }
        }
      }
    },
    "Creative": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreativ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创意"
          }
        }
      }
    },
    "Custom": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefiniert"
          }
        },
        "zh-Hans": {
