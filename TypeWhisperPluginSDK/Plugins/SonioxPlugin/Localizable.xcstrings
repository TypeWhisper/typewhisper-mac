    "Sent to Soniox with every transcription. Dictionary terms are added automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird bei jeder Transkription an Soniox gesendet. Wörterbuchbegriffe werden automatisch ergänzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envía a Soniox con cada transcripción. Los términos del diccionario se agregan automáticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしのたびにSonioxへ送信されます。辞書の用語は自動的に追加されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次转录时发送给 Soniox。词典术语会自动添加。"
