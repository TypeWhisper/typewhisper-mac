{
  "sourceLanguage": "en",
  "strings": {
    "Download and load %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ laden und aktivieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar y cargar %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を読み込んで有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并加载 %@"
          }
        }
      }
    },
    "Error": {
      "localizations": {
