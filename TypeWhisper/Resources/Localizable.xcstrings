    "Silence duration" : {
      "comment" : "Label of the stepper for how long the silence before an automatic stop lasts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauer der Stille"
          }
        },
        "es" : {
