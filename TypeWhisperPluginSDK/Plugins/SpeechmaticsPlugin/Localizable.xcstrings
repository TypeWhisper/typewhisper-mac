    "Select the server region closest to you for lower latency.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Serverregion, die dir am nächsten ist, für geringere Latenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona la región de servidores más cercana para reducir la latencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの地域を近い場所に選ぶことで、遅延を低減できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择离您最近的服务器区域以降低延迟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇離您最近的伺服器區域以降低延遲。"
          }
        }
      }
    },
