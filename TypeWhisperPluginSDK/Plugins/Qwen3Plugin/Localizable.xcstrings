    "Best default for most 16 GB+ Macs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste Vorgabe für die meisten Macs mit 16 GB+."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mejor opción predeterminada para la mayoría de los Mac con 16 GB o más."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "16 GB以上のMacのほとんどに最適な設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数 16 GB 以上 Mac 的最佳默认选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大多數 16 GB 以上 Mac 的最佳預設選擇。"
          }
        }
      }
    },
    "Canary needs an explicit source language. Choose Greek or English for Sophea in Dictation settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary braucht eine konkrete Ausgangssprache. Wähle für Sophea Griechisch oder Englisch in den Diktateinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary necesita un idioma de origen explícito. Elige griego o inglés para Sophea en los ajustes de Dictado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Canaryでは入力言語の指定が必要です。Sopheaを使う場合は、音声入力設定でギリシャ語または英語を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary 需要明确指定源语言。使用 Sophea 时，请在听写设置中选择希腊语或英语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary 需要明確指定來源語言。使用 Sophea 時，請在聽寫設定中選擇希臘語或英語。"
          }
        }
      }
    },
