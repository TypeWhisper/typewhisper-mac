{
  "sourceLanguage": "en",
  "strings": {
    "Cancel": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abbrechen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}}}},
    "Check again": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erneut prüfen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检查"}}}},
    "Download audio from a supported web link and pass it to TypeWhisper's regular file-transcription queue.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Lädt Audio aus einem unterstützten Weblink und übergibt es an die normale Dateitranskriptions-Warteschlange von TypeWhisper."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从受支持的网页链接下载音频，并将其添加到 TypeWhisper 的常规文件转录队列。"}}}},
    "Download complete": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Download abgeschlossen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载完成"}}}},
    "Downloading media…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Medium wird heruntergeladen…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在下载媒体…"}}}},
    "Helper tools": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Hilfsprogramme"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"辅助工具"}}}},
    "Homebrew found at %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Homebrew wurde unter %@ gefunden."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 %@ 找到 Homebrew。"}}}},
    "Homebrew was not found. Install the helper tools manually or install Homebrew first.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Homebrew wurde nicht gefunden. Installiere die Hilfsprogramme manuell oder zuerst Homebrew."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未找到 Homebrew。请手动安装辅助工具，或先安装 Homebrew。"}}}},
    "Homebrew was not found. Install yt-dlp and ffmpeg manually, then check again.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Homebrew wurde nicht gefunden. Installiere yt-dlp und ffmpeg manuell und prüfe danach erneut."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未找到 Homebrew。请手动安装 yt-dlp 和 ffmpeg，然后重新检查。"}}}},
    "Homebrew will download and install: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Homebrew lädt Folgendes herunter und installiert es: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Homebrew 将下载并安装：%@"}}}},
    "Homebrew could not install the helper tools.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Homebrew konnte die Hilfsprogramme nicht installieren."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Homebrew 无法安装辅助工具。"}}}},
    "Install helper tools?": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Hilfsprogramme installieren?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装辅助工具？"}}}},
    "Install missing tools with Homebrew": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fehlende Programme mit Homebrew installieren"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 Homebrew 安装缺少的工具"}}}},
    "Install with Homebrew": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mit Homebrew installieren"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 Homebrew 安装"}}}},
    "Missing helper tools: %@. Open the add-on settings to install them.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fehlende Hilfsprogramme: %@. Öffne die Add-on-Einstellungen, um sie zu installieren."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缺少辅助工具：%@。请打开此附加组件的设置进行安装。"}}}},
    "No helper tool is downloaded without confirmation. Homebrew verifies and manages the installed packages.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kein Hilfsprogramm wird ohne Bestätigung heruntergeladen. Homebrew prüft und verwaltet die installierten Pakete."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未经确认不会下载任何辅助工具。Homebrew 会验证并管理已安装的软件包。"}}}},
    "Not installed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht installiert"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未安装"}}}},
    "Open Homebrew setup": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Homebrew-Einrichtung öffnen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 Homebrew 设置"}}}},
    "Ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereit"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"就绪"}}}},
    "The download did not produce a supported audio or video file.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Download hat keine unterstützte Audio- oder Videodatei erzeugt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载未生成受支持的音频或视频文件。"}}}},
    "The link must be a valid HTTP or HTTPS URL.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Link muss eine gültige HTTP- oder HTTPS-URL sein."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"链接必须是有效的 HTTP 或 HTTPS URL。"}}}},
    "The media download failed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Medien-Download ist fehlgeschlagen."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"媒体下载失败。"}}}},
    "The Web Link add-on is not active.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Weblink-Add-on ist nicht aktiv."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Web Link 附加组件未启用。"}}}},
    "Transcribe Web Link…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Weblink transkribieren…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转录网页链接…"}}}},
    "Web Link": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Weblink"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网页链接"}}}},
    "Web Link Transcription": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Weblink-Transkription"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网页链接转录"}}}},
    "Web Link Transcription Settings…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Weblink-Transkriptionseinstellungen…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"网页链接转录设置…"}}}},
    "Add Link": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Link hinzufügen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加链接"}}}},
    "Open add-on settings…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Add-on-Einstellungen öffnen…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开附加组件设置…"}}}},
    "Paste a supported video or audio link. The add-on downloads its audio and adds it to TypeWhisper's transcription queue.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge einen unterstützten Video- oder Audio-Link ein. Das Add-on lädt die Audiospur herunter und fügt sie der Transkriptionswarteschlange von TypeWhisper hinzu."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"粘贴受支持的视频或音频链接。附加组件会下载其音轨并添加到 TypeWhisper 的转录队列。"}}}},
    "Paste a video or audio link": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Video- oder Audio-Link einfügen"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"粘贴视频或音频链接"}}}},
    "Preparing web link download": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Weblink-Download wird vorbereitet"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在准备网页链接下载"}}}},
    "The downloaded media was added to the transcription queue.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das heruntergeladene Medium wurde der Transkriptionswarteschlange hinzugefügt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载的媒体已添加到转录队列。"}}}},
    "The Web Link add-on is not ready.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Weblink-Add-on ist noch nicht bereit."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Web Link 附加组件尚未就绪。"}}}},
    "Transcribe audio from a web link": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio aus einem Weblink transkribieren"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转录网页链接中的音频"}}}},
    "TypeWhisper could not add the downloaded media to the transcription queue.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"TypeWhisper konnte das heruntergeladene Medium nicht zur Transkriptionswarteschlange hinzufügen."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"TypeWhisper 无法将下载的媒体添加到转录队列。"}}}}
  },
  "version": "1.0"
}
