{
  "sourceLanguage": "en",
  "strings": {
    "API Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        }
      }
    },
    "All credentials are stored securely in the macOS Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zugangsdaten werden sicher im macOS-Schlüsselbund gespeichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての認証情報はmacOSキーチェーンに安全に保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有凭据都安全存储在 macOS 钥匙串中。"
          }
        }
      }
    },
    "Cloudflare Tunnel Auth": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare-Tunnel-Authentifizierung"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel認証"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel 认证"
          }
        }
      }
    },
