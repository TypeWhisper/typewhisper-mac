            "value": "4-bitと同等のメモリ使用量で少し正確性が向上。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比 4 位略高精度，占用空间相似。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比 4 位略高精度，佔用空間相似。"
          }
        }
      }
    },
    "Smallest 1.7B option; use when 6-bit is too heavy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinste 1.7B-Option; nutze sie, wenn 6-bit zu schwer ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción 1.7B más pequeña; úsala cuando el de 6 bits sea demasiado pesado."
