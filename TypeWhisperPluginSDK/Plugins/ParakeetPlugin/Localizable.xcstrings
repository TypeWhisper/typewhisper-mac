    "NVIDIA Parakeet TDT V2 - extremely fast on Apple Silicon. English only, highest recall. No API key required.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA Parakeet TDT V2 - extrem schnell auf Apple Silicon. Nur Englisch, höchster Recall. Kein API-Schlüssel nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA Parakeet TDT V2: extremadamente rápido en Apple Silicon. Solo inglés, la mayor exhaustividad. No necesita clave de API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA Parakeet TDT V2 - Apple Siliconで非常に高速。英語のみ、最高のRecall。APIキー不要。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA Parakeet TDT V2 - 在 Apple Silicon 上极快。仅限英语，最高召回率。无需 API 密钥。"
          }
        }
      }
    },
    "NVIDIA Parakeet TDT - extremely fast on Apple Silicon. 25 European languages, no API key required.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA Parakeet TDT - extrem schnell auf Apple Silicon. 25 europäische Sprachen, kein API-Schlüssel nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA Parakeet TDT: extremadamente rápido en Apple Silicon. 25 idiomas europeos, no necesita clave de API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA Parakeet TDT - Apple Siliconで非常に高速。25のヨーロッパ語、APIキー不要。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA Parakeet TDT - 在 Apple Silicon 上极快。支持 25 种欧洲语言，无需 API 密钥。"
          }
        }
      }
    },
    "NVIDIA Nemotron 3.5 ASR Streaming - streams as you speak, so the text is ready when you stop. 28 languages, no API key required." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NVIDIA Nemotron 3.5 ASR Streaming - transkribiert schon beim Sprechen, damit der Text beim Stoppen fertig ist. 28 Sprachen, kein API-Schlüssel nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NVIDIA Nemotron 3.5 ASR Streaming: transcribe mientras hablas, así que el texto está listo cuando te detienes. 28 idiomas, no necesita clave de API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NVIDIA Nemotron 3.5 ASR Streaming - 話している間に文字起こしするため、停止した時点でテキストが完成しています。28言語、APIキー不要。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NVIDIA Nemotron 3.5 ASR Streaming - 边说边转写，停止时文字即已就绪。支持 28 种语言，无需 API 密钥。"
          }
        }
      }
    },
    "Optional. Increases download rate limits. Free at huggingface.co/settings/tokens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Erhöht die Download-Rate-Limits. Kostenlos unter huggingface.co/settings/tokens"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Aumenta los límites de descarga. Gratis en huggingface.co/settings/tokens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。ダウンロードのレート制限を緩和できます。huggingface.co/settings/tokens で無料作成できます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。提高下载速率限制。在 huggingface.co/settings/tokens 免费获取。"
          }
        }
      }
    },
