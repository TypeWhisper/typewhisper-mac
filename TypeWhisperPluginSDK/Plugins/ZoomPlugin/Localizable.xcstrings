    "Cloud speech recognition with Zoom Scribe. Needs an API key from Zoom AI Services.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Spracherkennung mit Zoom Scribe. Benötigt einen API-Schlüssel von Zoom AI Services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconocimiento de voz en la nube con Zoom Scribe. Requiere una clave de API de Zoom AI Services."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom Scribeによるクラウド音声認識です。Zoom AI ServicesのAPIキーが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Zoom Scribe 进行云端语音识别。需要 Zoom AI Services 的 API 密钥。"
          }
        }
      }
    },
    "Create a key at zoom.ai under Configure > API Keys. Zoom bills usage in Build Credits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen Schlüssel auf zoom.ai unter Configure > API Keys. Zoom rechnet die Nutzung in Build Credits ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una clave en zoom.ai, en Configure > API Keys. Zoom factura el uso en Build Credits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "zoom.aiの「Configure > API Keys」でキーを作成してください。利用料金はBuild Creditsで請求されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 zoom.ai 的 Configure > API Keys 中创建密钥。Zoom 以 Build Credits 计费。"
          }
        }
      }
    },
