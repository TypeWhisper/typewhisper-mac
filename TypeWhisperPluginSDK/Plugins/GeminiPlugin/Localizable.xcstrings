    "Using default models. Press Refresh to fetch all available models.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard-Modelle werden verwendet. Klicke auf Aktualisieren, um alle verfügbaren Modelle abzurufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se están usando los modelos predeterminados. Presiona Actualizar para obtener todos los modelos disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準モデルが使用されます。すべての利用可能なモデルを取得するには「更新」をクリックしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用默认模型。点击刷新以获取所有可用模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用預設模型。點選重新整理以取得所有可用模型。"
          }
        }
      }
    },
    "Using built-in transcription models until the Gemini catalog is available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis der Gemini-Katalog verfügbar ist, werden die integrierten Transkriptionsmodelle verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usan los modelos de transcripción integrados hasta que el catálogo de Gemini esté disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini カタログが利用可能になるまで、内蔵の文字起こしモデルを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Gemini 目录可用之前，将使用内置转录模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Gemini 目錄可用之前，將使用內建轉錄模型。"
          }
        }
      }
    },
