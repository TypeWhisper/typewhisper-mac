    "Press %@ in any app to get started." : {
      "comment" : "A message displayed in the \"Recent Transcriptions\" section of the Home Settings view, instructing the user to press a hotkey to start transcription.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke %1$@ in einer beliebigen App, um loszulegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presiona %@ en cualquier app para empezar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のアプリで %@ を押して開始してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意应用中按下 %@ 即可开始。"
          }
        }
      }
    },
    "Press a hotkey and talk in any app." : {
      "localizations" : {
