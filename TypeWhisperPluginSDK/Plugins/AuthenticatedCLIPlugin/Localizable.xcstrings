    "Anthropic account via Claude Code": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Anthropic-Konto über Claude Code"}},"ja":{"stringUnit":{"state":"translated","value":"Claude Code経由のAnthropicアカウント"}}}},
