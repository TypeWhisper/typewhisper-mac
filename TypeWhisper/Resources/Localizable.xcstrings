    "Installing %@ %@ will replace an older external plugin bundle (%@) that was kept for another TypeWhisper runtime. Older app versions may stop using that bundle after this replacement." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Installing %1$@ %2$@ will replace an older external plugin bundle (%3$@) that was kept for another TypeWhisper runtime. Older app versions may stop using that bundle after this replacement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalar %1$@ %2$@ reemplazará un paquete de plugin externo anterior (%3$@) que se conservó para otro entorno de ejecución de TypeWhisper. Es posible que las versiones anteriores de la app dejen de usar ese paquete después de este reemplazo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@のインストールは、別のTypeWhisperランタイム用に保持されていた古い外部プラグインバンドル(%@)を置き換えます。この置き換え後、古いアプリバージョンはそのバンドルの使用を停止する可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装 %1$@ %2$@ 将替换为其他 TypeWhisper 运行环境保留的旧外部插件包（%3$@）。替换后，旧版应用可能无法继续使用该插件包。"
          }
        }
      }
    },
    "Installing this plugin will replace an older external bundle that was kept for another TypeWhisper runtime. Older app versions may stop using that bundle after this replacement." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalar este plugin reemplazará un paquete externo anterior que se conservó para otro entorno de ejecución de TypeWhisper. Es posible que las versiones anteriores de la app dejen de usar ese paquete después de este reemplazo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプラグインをインストールすると、別のTypeWhisperランタイム用に保持されていた古い外部バンドルが置き換えられます。この置き換え後、古いアプリバージョンはそのバンドルの使用を停止する可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装此插件将替换为其他 TypeWhisper 运行环境保留的旧外部插件包。替换后，旧版应用可能无法继续使用该插件包。"
          }
        }
      }
    },
