        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を削除しますか？互換性のないプラグインバンドル、保存データ、認証情報が削除されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
