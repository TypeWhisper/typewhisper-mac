    "No automatic language detection, streaming, timestamps, diarization, translation, or dictionary boosting.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の自動検出、ストリーミング、タイムスタンプ、話者分離、翻訳、辞書による認識精度の向上には対応していません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine automatische Spracherkennung, kein Streaming, keine Zeitstempel, Diarisierung, Übersetzung oder Wörterbuchverstärkung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持自动语言检测、流式传输、时间戳、说话人分离、翻译或词典增强。"
          }
        }
      }
    },
    "Model weights are downloaded from a pinned Apache-2.0 GGUF revision. CrispASR and the VAD model are MIT-licensed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの重みは、Apache-2.0ライセンスのGGUFの固定リビジョンからダウンロードされます。CrispASRとVADモデルはMITライセンスです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modellgewichte werden aus einer festgeschriebenen Apache-2.0-GGUF-Revision geladen. CrispASR und das VAD-Modell stehen unter der MIT-Lizenz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型权重从固定的 Apache-2.0 GGUF 版本下载。CrispASR 和 VAD 模型采用 MIT 许可。"
          }
        }
      }
    },
    "Not Downloaded": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未ダウンロード"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht heruntergeladen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未下载"
          }
        }
      }
    },
    "Optional. Increases download rate limits and may speed up the model download. The token is stored securely in Keychain.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。ダウンロードのレート制限が緩和され、モデルのダウンロードが速くなる場合があります。トークンはキーチェーンに安全に保存されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Erhöht die Download-Limits und kann den Modelldownload beschleunigen. Der Token wird sicher im Schlüsselbund gespeichert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。提高下载速率限制并可能加速模型下载。令牌安全存储在钥匙串中。"
          }
        }
      }
    },
    "Preparing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備中"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird vorbereitet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备中"
          }
        }
      }
    },
    "Starting CrispASR with Metal and warming up the model. Dictation is ready when this finishes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalでCrispASRを起動し、モデルの初期準備を行っています。完了すると音声入力を使用できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CrispASR wird mit Metal gestartet und das Modell wird aufgewärmt. Nach Abschluss ist die Diktierfunktion bereit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用 Metal 启动 CrispASR 并预热模型。完成后即可开始听写。"
          }
        }
      }
    },
    "Ready": {
      "localizations": {
