            "state": "translated",
            "value": "ウィンドウサイズ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenstergröße"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口大小"
          }
        }
      }
    },
    "Auto-open on recording": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch bei Aufnahme öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir automáticamente al grabar"
