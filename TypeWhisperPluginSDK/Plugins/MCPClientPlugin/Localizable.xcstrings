    "Sample JSON property": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beispielhafte JSON-Eigenschaft"}},"es":{"stringUnit":{"state":"translated","value":"Propiedad JSON de ejemplo"}},"ja":{"stringUnit":{"state":"translated","value":"サンプル JSON プロパティ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"示例 JSON 属性"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"範例 JSON 屬性"}}}},
    "Sample batch item": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beispielhaftes Stapelelement"}},"es":{"stringUnit":{"state":"translated","value":"Elemento de lote de ejemplo"}},"ja":{"stringUnit":{"state":"translated","value":"サンプルバッチ項目"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"示例批处理项目"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"範例批次處理項目"}}}},
    "Sample original transcript": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beispielhaftes Originaltranskript"}},"es":{"stringUnit":{"state":"translated","value":"Transcripción original de ejemplo"}},"ja":{"stringUnit":{"state":"translated","value":"サンプルの元の文字起こし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"示例原始转录"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"範例原始轉錄"}}}},
    "Sample processed text": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beispielhafter verarbeiteter Text"}},"es":{"stringUnit":{"state":"translated","value":"Texto procesado de ejemplo"}},"ja":{"stringUnit":{"state":"translated","value":"サンプル処理済みテキスト"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"示例已处理文本"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"範例已處理文字"}}}},
    "Save": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Speichern"}},"es":{"stringUnit":{"state":"translated","value":"Guardar"}},"ja":{"stringUnit":{"state":"translated","value":"保存"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存"}}}},
    "Saving and selecting an action authorizes TypeWhisper to run that fixed tool automatically when the workflow completes.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Durch Speichern und Auswählen einer Aktion darf TypeWhisper dieses festgelegte Tool nach Abschluss des Workflows automatisch ausführen."}},"es":{"stringUnit":{"state":"translated","value":"Al guardar y seleccionar una acción, autorizas a TypeWhisper a ejecutar automáticamente esa herramienta fija cuando termine el flujo de trabajo."}},"ja":{"stringUnit":{"state":"translated","value":"アクションを保存して選択すると、ワークフロー完了時に TypeWhisper がその固定ツールを自動実行することを許可します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存并选择操作即授权 TypeWhisper 在工作流完成时自动运行该固定工具。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存並選擇操作即授權 TypeWhisper 在工作流程完成時自動執行該固定工具。"}}}},
    "Secret": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Geheim"}},"es":{"stringUnit":{"state":"translated","value":"Secreto"}},"ja":{"stringUnit":{"state":"translated","value":"シークレット"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"机密"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"機密"}}}},
    "Select a tool…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tool auswählen …"}},"es":{"stringUnit":{"state":"translated","value":"Seleccionar una herramienta…"}},"ja":{"stringUnit":{"state":"translated","value":"ツールを選択…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择工具…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇工具…"}}}},
    "Select an MCP tool.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle ein MCP-Tool aus."}},"es":{"stringUnit":{"state":"translated","value":"Selecciona una herramienta MCP."}},"ja":{"stringUnit":{"state":"translated","value":"MCP ツールを選択してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择 MCP 工具。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請選擇 MCP 工具。"}}}},
    "Server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Server"}},"es":{"stringUnit":{"state":"translated","value":"Servidor"}},"ja":{"stringUnit":{"state":"translated","value":"サーバー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务器"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"伺服器"}}}},
    "Servers": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Server"}},"es":{"stringUnit":{"state":"translated","value":"Servidores"}},"ja":{"stringUnit":{"state":"translated","value":"サーバー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务器"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"伺服器"}}}},
    "Single": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einzeln"}},"es":{"stringUnit":{"state":"translated","value":"Simple"}},"ja":{"stringUnit":{"state":"translated","value":"単一"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"单次"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"單次"}}}},
    "Source": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Quelle"}},"es":{"stringUnit":{"state":"translated","value":"Origen"}},"ja":{"stringUnit":{"state":"translated","value":"ソース"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"來源"}}}},
    "Store environment value in Keychain": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Umgebungswert im Schlüsselbund speichern"}},"es":{"stringUnit":{"state":"translated","value":"Guardar el valor de entorno en el llavero"}},"ja":{"stringUnit":{"state":"translated","value":"環境変数をキーチェーンに保存"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将环境变量存储在钥匙串中"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將環境變數儲存在鑰匙圈中"}}}},
    "The MCP client is not connected.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der MCP Client ist nicht verbunden."}},"es":{"stringUnit":{"state":"translated","value":"El cliente MCP no está conectado."}},"ja":{"stringUnit":{"state":"translated","value":"MCP Client は接続されていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP Client 未连接。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"MCP Client 未連線。"}}}},
    "The MCP connection was lost after the request may have been sent. The request was not retried.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die MCP-Verbindung ging verloren, nachdem die Anfrage möglicherweise gesendet wurde. Die Anfrage wurde nicht erneut gesendet."}},"es":{"stringUnit":{"state":"translated","value":"Se perdió la conexión MCP después de que la solicitud pudiera haberse enviado. La solicitud no se reintentó."}},"ja":{"stringUnit":{"state":"translated","value":"リクエスト送信後の可能性がある時点で MCP 接続が失われました。リクエストは再試行されませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 连接在请求可能已发送后丢失。请求未重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"MCP 連線在請求可能已傳送後丟失。請求未重試。"}}}},
    "The MCP tool reported an error.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das MCP-Tool hat einen Fehler gemeldet."}},"es":{"stringUnit":{"state":"translated","value":"La herramienta MCP informó de un error."}},"ja":{"stringUnit":{"state":"translated","value":"MCP ツールがエラーを報告しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 工具报告了错误。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"MCP 工具報告了錯誤。"}}}},
    "The MCP tool ‘%@’ is no longer available. Refresh the action configuration.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das MCP-Tool „%@“ ist nicht mehr verfügbar. Aktualisiere die Aktionskonfiguration."}},"es":{"stringUnit":{"state":"translated","value":"La herramienta MCP ‘%@’ ya no está disponible. Actualiza la configuración de la acción."}},"ja":{"stringUnit":{"state":"translated","value":"MCP ツール「%@」は利用できなくなりました。アクション設定を更新してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 工具“%@”已不可用。请刷新操作配置。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"MCP 工具「%@」已不可用。請重新整理操作設定。"}}}},
    "The batch contains %lld items. MCP Client supports at most %lld.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Stapel enthält %lld Elemente. MCP Client unterstützt höchstens %lld."}},"es":{"stringUnit":{"state":"translated","value":"El lote contiene %lld elementos. MCP Client admite como máximo %lld."}},"ja":{"stringUnit":{"state":"translated","value":"バッチには %lld 項目あります。MCP Client がサポートする上限は %lld 項目です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批处理包含 %lld 个项目。MCP Client 最多支持 %lld 个。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"批次處理包含 %lld 個項目。MCP Client 最多支援 %lld 個。"}}}},
    "The command is not interpreted by a shell. The process may still access files and services available to your macOS user.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Befehl wird nicht von einer Shell interpretiert. Der Prozess kann dennoch auf Dateien und Dienste zugreifen, die deinem macOS-Benutzer zur Verfügung stehen."}},"es":{"stringUnit":{"state":"translated","value":"El comando no lo interpreta un shell. Aun así, el proceso puede acceder a los archivos y servicios disponibles para tu usuario de macOS."}},"ja":{"stringUnit":{"state":"translated","value":"コマンドはシェルで解釈されません。ただし、プロセスは macOS ユーザーが利用できるファイルやサービスにアクセスできます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"命令不会由 shell 解释。该进程仍可访问你的 macOS 用户可用的文件和服务。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"命令不會由 shell 解釋。該程式仍可存取你的 macOS 使用者可用的檔案和服務。"}}}},
    "The configured MCP action no longer exists.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die konfigurierte MCP-Aktion existiert nicht mehr."}},"es":{"stringUnit":{"state":"translated","value":"La acción MCP configurada ya no existe."}},"ja":{"stringUnit":{"state":"translated","value":"設定された MCP アクションは存在しません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已配置的 MCP 操作已不存在。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已設定的 MCP 操作已不存在。"}}}},
    "The configured MCP server no longer exists.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der konfigurierte MCP-Server existiert nicht mehr."}},"es":{"stringUnit":{"state":"translated","value":"El servidor MCP configurado ya no existe."}},"ja":{"stringUnit":{"state":"translated","value":"設定された MCP サーバーは存在しません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已配置的 MCP 服务器已不存在。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已設定的 MCP 伺服器已不存在。"}}}},
    "The input is not valid UTF-8 text.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Eingabe ist kein gültiger UTF-8-Text."}},"es":{"stringUnit":{"state":"translated","value":"La entrada no es texto UTF-8 válido."}},"ja":{"stringUnit":{"state":"translated","value":"入力は有効な UTF-8 テキストではありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"输入不是有效的 UTF-8 文本。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"輸入不是有效的 UTF-8 文字。"}}}},
    "The input schema for ‘%@’ changed. Refresh the action configuration.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Eingabeschema für „%@“ hat sich geändert. Aktualisiere die Aktionskonfiguration."}},"es":{"stringUnit":{"state":"translated","value":"El esquema de entrada de ‘%@’ cambió. Actualiza la configuración de la acción."}},"ja":{"stringUnit":{"state":"translated","value":"「%@」の入力スキーマが変更されました。アクション設定を更新してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“%@”的输入架构已更改。请刷新操作配置。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"「%@」的輸入架構已更改。請重新整理操作設定。"}}}},
    "The stored MCP configuration could not be loaded. It was left unchanged to prevent data loss.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die gespeicherte MCP-Konfiguration konnte nicht geladen werden. Sie wurde unverändert beibehalten, um Datenverlust zu verhindern."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo cargar la configuración de MCP guardada. Se dejó sin cambios para evitar la pérdida de datos."}},"ja":{"stringUnit":{"state":"translated","value":"保存された MCP 設定を読み込めませんでした。データ損失を防ぐため、保存データは変更されていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载已存储的 MCP 配置。为防止数据丢失，原始数据保持不变。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法載入已儲存的 MCP 設定。為防止資料丟失，原始資料保持不變。"}}}},
    "This fixed MCP tool runs automatically whenever a workflow using this Action Target completes.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses festgelegte MCP-Tool wird automatisch ausgeführt, sobald ein Workflow mit diesem Aktionsziel abgeschlossen ist."}},"es":{"stringUnit":{"state":"translated","value":"Esta herramienta MCP fija se ejecuta automáticamente cada vez que termina un flujo de trabajo que usa este destino de acción."}},"ja":{"stringUnit":{"state":"translated","value":"この固定 MCP ツールは、このアクションターゲットを使用するワークフローの完了時に自動実行されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用此操作目标的工作流完成时，该固定 MCP 工具会自动运行。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用此操作目標的工作流程完成時，該固定 MCP 工具會自動執行。"}}}},
    "This tool has no top-level properties to map. Use Raw JSON Arguments for complex schemas.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses Tool hat keine zuzuordnenden Eigenschaften auf oberster Ebene. Verwende für komplexe Schemas unverarbeitete JSON-Argumente."}},"es":{"stringUnit":{"state":"translated","value":"Esta herramienta no tiene propiedades de nivel superior que asignar. Usa Argumentos JSON sin procesar para esquemas complejos."}},"ja":{"stringUnit":{"state":"translated","value":"このツールにはマッピング可能なトップレベルプロパティがありません。複雑なスキーマには生の JSON 引数を使用してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此工具没有可映射的顶层属性。复杂架构请使用原始 JSON 参数。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此工具沒有可對映的頂層屬性。複雜架構請使用原始 JSON 參數。"}}}},
    "Tool": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tool"}},"es":{"stringUnit":{"state":"translated","value":"Herramienta"}},"ja":{"stringUnit":{"state":"translated","value":"ツール"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"工具"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"工具"}}}},
    "Use an absolute path or a bare executable name instead of: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verwende einen absoluten Pfad oder nur den Programmnamen anstelle von: %@"}},"es":{"stringUnit":{"state":"translated","value":"Usa una ruta absoluta o solo el nombre del ejecutable en lugar de: %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@ の代わりに絶対パスまたは実行ファイル名のみを使用してください"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用绝对路径或单独的可执行文件名，而不是：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請使用絕對路徑或單獨的可執行檔名，而不是：%@"}}}},
    "Value": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wert"}},"es":{"stringUnit":{"state":"translated","value":"Valor"}},"ja":{"stringUnit":{"state":"translated","value":"値"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"值"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"值"}}}},
    "Workflow Actions": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Workflow-Aktionen"}},"es":{"stringUnit":{"state":"translated","value":"Acciones de flujos de trabajo"}},"ja":{"stringUnit":{"state":"translated","value":"ワークフローアクション"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"工作流操作"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"工作流程操作"}}}},
    "Acknowledge that TypeWhisper may connect to this MCP server and send configured workflow data.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bestätige, dass TypeWhisper eine Verbindung zu diesem MCP-Server herstellen und konfigurierte Workflow-Daten senden darf."}},"es":{"stringUnit":{"state":"translated","value":"Confirma que TypeWhisper puede conectarse a este servidor MCP y enviarle los datos del flujo de trabajo configurados."}},"ja":{"stringUnit":{"state":"translated","value":"TypeWhisper がこの MCP サーバーに接続し、設定されたワークフローデータを送信できることを確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请确认 TypeWhisper 可以连接此 MCP 服务器并发送已配置的工作流数据。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請確認 TypeWhisper 可以連線此 MCP 伺服器並傳送已設定的工作流程資料。"}}}},
    "Add a stdio or Streamable HTTP server to discover its tools.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge einen stdio- oder Streamable-HTTP-Server hinzu, um seine Tools zu finden."}},"es":{"stringUnit":{"state":"translated","value":"Agrega un servidor stdio o Streamable HTTP para descubrir sus herramientas."}},"ja":{"stringUnit":{"state":"translated","value":"stdio または Streamable HTTP サーバーを追加してツールを検出します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 stdio 或 Streamable HTTP 服务器以发现其工具。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增 stdio 或 Streamable HTTP 伺服器以發現其工具。"}}}},
    "Authentication": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Authentifizierung"}},"es":{"stringUnit":{"state":"translated","value":"Autenticación"}},"ja":{"stringUnit":{"state":"translated","value":"認証"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"身份验证"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"身份驗證"}}}},
    "Bearer token": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bearer-Token"}},"es":{"stringUnit":{"state":"translated","value":"Token de portador (bearer)"}},"ja":{"stringUnit":{"state":"translated","value":"Bearer トークン"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Bearer 令牌"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Bearer 權杖"}}}},
    "Configure local stdio processes or remote Streamable HTTP endpoints.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Konfiguriere lokale stdio-Prozesse oder entfernte Streamable-HTTP-Endpunkte."}},"es":{"stringUnit":{"state":"translated","value":"Configura procesos stdio locales o endpoints Streamable HTTP remotos."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルの stdio プロセスまたはリモートの Streamable HTTP エンドポイントを設定します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置本地 stdio 进程或远程 Streamable HTTP 端点。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"設定本機 stdio 程式或遠端 Streamable HTTP 端點。"}}}},
    "Endpoint URL": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Endpunkt-URL"}},"es":{"stringUnit":{"state":"translated","value":"URL del endpoint"}},"ja":{"stringUnit":{"state":"translated","value":"エンドポイント URL"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"端点 URL"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"端點 URL"}}}},
    "Enter a bearer token.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gib einen Bearer-Token ein."}},"es":{"stringUnit":{"state":"translated","value":"Introduce un token de portador (bearer)."}},"ja":{"stringUnit":{"state":"translated","value":"Bearer トークンを入力してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 Bearer 令牌。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請輸入 Bearer 權杖。"}}}},
    "Enter a valid MCP server URL using HTTPS, or HTTP for a local address.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gib eine gültige MCP-Server-URL mit HTTPS oder HTTP für eine lokale Adresse ein."}},"es":{"stringUnit":{"state":"translated","value":"Introduce una URL de servidor MCP válida con HTTPS, o con HTTP para una dirección local."}},"ja":{"stringUnit":{"state":"translated","value":"HTTPS、またはローカルアドレスには HTTP を使用した有効な MCP サーバー URL を入力してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入使用 HTTPS 的有效 MCP 服务器 URL，或为本地地址使用 HTTP。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請輸入使用 HTTPS 的有效 MCP 伺服器 URL，或為本機地址使用 HTTP。"}}}},
    "I understand that TypeWhisper will connect to this MCP server and may send configured workflow data.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ich verstehe, dass TypeWhisper eine Verbindung zu diesem MCP-Server herstellt und konfigurierte Workflow-Daten senden kann."}},"es":{"stringUnit":{"state":"translated","value":"Entiendo que TypeWhisper se conectará a este servidor MCP y puede enviarle los datos del flujo de trabajo configurados."}},"ja":{"stringUnit":{"state":"translated","value":"TypeWhisper がこの MCP サーバーに接続し、設定されたワークフローデータを送信する場合があることを理解しています。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我了解 TypeWhisper 将连接此 MCP 服务器，并可能发送已配置的工作流数据。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"我瞭解 TypeWhisper 將連線此 MCP 伺服器，並可能傳送已設定的工作流程資料。"}}}},
    "None": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine"}},"es":{"stringUnit":{"state":"translated","value":"Ninguno"}},"ja":{"stringUnit":{"state":"translated","value":"なし"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無"}}}},
    "Streamable HTTP": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Streamable HTTP"}},"es":{"stringUnit":{"state":"translated","value":"Streamable HTTP"}},"ja":{"stringUnit":{"state":"translated","value":"Streamable HTTP"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Streamable HTTP"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Streamable HTTP"}}}},
    "The bearer token is stored in the macOS Keychain and sent only in the Authorization header.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Bearer-Token wird im macOS-Schlüsselbund gespeichert und nur im Authorization-Header gesendet."}},"es":{"stringUnit":{"state":"translated","value":"El token de portador (bearer) se guarda en el llavero de macOS y solo se envía en el encabezado Authorization."}},"ja":{"stringUnit":{"state":"translated","value":"Bearer トークンは macOS キーチェーンに保存され、Authorization ヘッダーでのみ送信されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Bearer 令牌存储在 macOS 钥匙串中，并且仅通过 Authorization 标头发送。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Bearer 權杖儲存在 macOS 鑰匙圈中，並且僅透過 Authorization 標頭髮送。"}}}},
    "Transport": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Transport"}},"es":{"stringUnit":{"state":"translated","value":"Transporte"}},"ja":{"stringUnit":{"state":"translated","value":"トランスポート"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"传输方式"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"傳輸方式"}}}},
    "Use only an MCP endpoint you trust. Tool calls can include text and context mapped by your workflow action.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verwende nur einen vertrauenswürdigen MCP-Endpunkt. Tool-Aufrufe können Text und Kontext enthalten, die deine Workflow-Aktion zuordnet."}},"es":{"stringUnit":{"state":"translated","value":"Usa solo un endpoint MCP de confianza. Las llamadas a herramientas pueden incluir el texto y el contexto que asigna la acción de tu flujo de trabajo."}},"ja":{"stringUnit":{"state":"translated","value":"信頼できる MCP エンドポイントのみを使用してください。ツール呼び出しには、ワークフローアクションでマッピングされたテキストやコンテキストが含まれる場合があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅使用你信任的 MCP 端点。工具调用可能包含工作流操作映射的文本和上下文。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"僅使用你信任的 MCP 端點。工具呼叫可能包含工作流程操作對映的文字和上下文。"}}}},
    "Add a Streamable HTTP server to discover its tools.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge einen Streamable-HTTP-Server hinzu, um seine Tools zu finden."}},"es":{"stringUnit":{"state":"translated","value":"Agrega un servidor Streamable HTTP para descubrir sus herramientas."}},"ja":{"stringUnit":{"state":"translated","value":"Streamable HTTP サーバーを追加してツールを検出します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 Streamable HTTP 服务器以发现其工具。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增 Streamable HTTP 伺服器以發現其工具。"}}}},
    "Configure remote Streamable HTTP endpoints.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Konfiguriere entfernte Streamable-HTTP-Endpunkte."}},"es":{"stringUnit":{"state":"translated","value":"Configura endpoints Streamable HTTP remotos."}},"ja":{"stringUnit":{"state":"translated","value":"リモートの Streamable HTTP エンドポイントを設定します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置远程 Streamable HTTP 端点。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"設定遠端 Streamable HTTP 端點。"}}}},
    "This edition of TypeWhisper can only connect to Streamable HTTP MCP servers.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Version von TypeWhisper kann nur Verbindungen zu Streamable-HTTP-MCP-Servern herstellen."}},"es":{"stringUnit":{"state":"translated","value":"Esta edición de TypeWhisper solo puede conectarse a servidores MCP Streamable HTTP."}},"ja":{"stringUnit":{"state":"translated","value":"このエディションの TypeWhisper は Streamable HTTP の MCP サーバーにのみ接続できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此版本的 TypeWhisper 只能连接到 Streamable HTTP MCP 服务器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此版本的 TypeWhisper 只能連線到 Streamable HTTP MCP 伺服器。"}}}},
    "stdio": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"stdio"}},"es":{"stringUnit":{"state":"translated","value":"stdio"}},"ja":{"stringUnit":{"state":"translated","value":"stdio"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"stdio"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"stdio"}}}}
  },
  "version": "1.0"
}
