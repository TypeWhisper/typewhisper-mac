        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みのローカルエンジンに対応するモデルを追加します。インポート完了前にモデルを検証して読み込みます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
