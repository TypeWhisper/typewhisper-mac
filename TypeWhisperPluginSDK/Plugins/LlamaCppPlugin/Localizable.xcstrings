{
  "sourceLanguage": "en",
  "strings": {
    "%@ at commit %@. The file is checked against its SHA-256 after the download.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ im Commit %2$@. Die Datei wird nach dem Download anhand ihrer SHA-256-Prüfsumme geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en el commit %2$@. El archivo se comprueba con su SHA-256 después de la descarga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（コミット %2$@）。ダウンロード後、ファイルをSHA-256で検証します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，提交 %2$@。下载后会根据 SHA-256 校验文件。"
          }
        }
      }
    },
    "%@ contains no GGUF model files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthält keine GGUF-Modelldateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no contiene archivos de modelo GGUF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはGGUFモデルファイルがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不包含 GGUF 模型文件。"
          }
        }
      }
    },
    "%@ does not match its expected size or checksum and was removed. Download it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht die erwartete Größe oder Prüfsumme und wurde entfernt. Lade die Datei erneut herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no coincide con el tamaño o la suma de comprobación esperados y se eliminó. Vuelve a descargarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は想定したサイズまたはチェックサムと一致しないため削除しました。もう一度ダウンロードしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 与预期的大小或校验和不符，已被删除。请重新下载。"
          }
        }
      }
    },
    "%@ only contains models split into several GGUF files, which are not supported yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthält nur Modelle, die auf mehrere GGUF-Dateien aufgeteilt sind. Diese werden noch nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo contiene modelos divididos en varios archivos GGUF, que todavía no son compatibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には複数のGGUFファイルに分割されたモデルしかなく、これにはまだ対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仅包含拆分为多个 GGUF 文件的模型，目前尚不支持。"
          }
        }
      }
    },
    "Add & Download": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen & Laden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir y descargar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加してダウンロード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加并下载"
          }
        }
      }
    },
    "Add any GGUF model from Hugging Face, for example a small 0.5B to 4B model for fast cleanup, or import a .gguf file from this Mac. Models with a chat template work best.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein beliebiges GGUF-Modell von Hugging Face hinzu, zum Beispiel ein kleines Modell mit 0,5B bis 4B Parametern für schnelle Bereinigung, oder importiere eine .gguf-Datei von diesem Mac. Am besten funktionieren Modelle mit Chat-Vorlage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade cualquier modelo GGUF de Hugging Face, por ejemplo un modelo pequeño de 0,5B a 4B para una limpieza rápida, o importa un archivo .gguf de este Mac. Los modelos con plantilla de chat funcionan mejor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Faceの任意のGGUFモデル（高速な整形には0.5B〜4Bの小さなモデルなど）を追加するか、このMacの.ggufファイルを読み込みます。チャットテンプレートを持つモデルが最適です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Hugging Face 添加任意 GGUF 模型（例如用于快速清理的 0.5B 到 4B 小模型），或导入此 Mac 上的 .gguf 文件。带有聊天模板的模型效果最好。"
          }
        }
      }
    },
    "Balanced speed and quality for every workflow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewogen schnell und gut für alle Workflows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrio entre velocidad y calidad para todos los flujos de trabajo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのワークフローで速度と品質のバランスが取れています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有工作流中兼顾速度与质量。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cancel loading %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden von %@ abbrechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar la carga de %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の読み込みをキャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消加载 %@"
          }
        }
      }
    },
    "Choose a file": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei auswählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件"
          }
        }
      }
    },
    "Choose a GGUF model file (.gguf).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine GGUF-Modelldatei (.gguf)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo de modelo GGUF (.gguf)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUFモデルファイル（.gguf）を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择 GGUF 模型文件（.gguf）。"
          }
        }
      }
    },
