    "provider.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The AI model removes fillers, organizes paragraphs, and translates. Without one, dictum inserts exactly what it heard."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AI 模型负责去掉口头禅、整理段落和翻译。没有接入时，dictum 只插入识别出的原文。"}}}},
    "provider.order": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Polishing and translation use the first one. If it fails, the next one takes over. Drag to reorder."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"润色和翻译使用第一个；它出错时，自动换下一个。拖动调整顺序。"}}}},
    "Primary": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Primary"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"首选"}}}},
