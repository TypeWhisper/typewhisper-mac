    "Keep dictionaries and snippets available wherever your cloud folder syncs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte Wörterbücher und Snippets überall verfügbar, wo dein Cloud-Ordner synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén los diccionarios y fragmentos disponibles dondequiera que se sincronice tu carpeta en la nube."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "词典和快捷短语会随你的云文件夹同步，在任何地方都可使用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドフォルダの同期先でも、辞書とスニペットを使えます。"
          }
        }
      }
    },
    "Keep using the GPL version as-is." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir usando la versión GPL tal cual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPL版をそのまま使用する。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续使用原版 GPL 版本。"
          }
        }
      }
    },
    "Keeps the Bluetooth microphone active between dictations. Audio between dictations is discarded. This shows the orange microphone indicator, uses more battery, and keeps headset audio in call-quality mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält das Bluetooth-Mikrofon zwischen Diktaten aktiv. Audio zwischen Diktaten wird verworfen. Dadurch wird der orangefarbene Mikrofonindikator angezeigt, der Akku stärker beansprucht und die Headset-Audioqualität im Telefonie-Modus gehalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene activo el micrófono Bluetooth entre dictados. El audio entre dictados se descarta. Esto muestra el indicador naranja del micrófono, consume más batería y mantiene el audio de los auriculares en modo de calidad de llamada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力の合間もBluetoothマイクを有効に保ちます。入力の合間の音声は破棄されます。オレンジ色のマイクインジケータが表示され、バッテリー消費が増え、ヘッドセットの音質は通話品質のままになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在两次听写之间保持蓝牙麦克风处于启用状态。两次听写之间的音频会被丢弃。这会显示橙色麦克风指示器、增加耗电量，并让耳机音频保持通话音质模式。"
          }
        }
      }
    },
    "Keeps a team of up to 10 devices covered with a recurring plan." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubre a un equipo de hasta 10 dispositivos con un plan recurrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "継続プランにより、最大10台のデバイスのチームをカバーします。"
