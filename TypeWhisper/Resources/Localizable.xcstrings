          "stringUnit": {
            "state": "translated",
            "value": "工作流中包含重复的快捷键。"
          }
        }
      }
    },
    "This Mac has an active commercial license.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacには有効な商用ライセンスがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac 有 an 激活 商业 许可证."
          }
        }
      }
    },
    "This Mac is covered by Individual commercial license terms on up to 3 devices.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは、最大3台のデバイスを対象としたIndividual商用ライセンス条件でカバーされています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
