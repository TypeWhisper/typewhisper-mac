    "recorder.folder.earlier.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen in diesen Ordnern werden weiter angezeigt. Entfernst du hier einen Ordner, blendet TypeWhisper nur seine Aufnahmen aus; die Dateien bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
