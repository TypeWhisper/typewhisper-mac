    "Send webhook for": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook senden für"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar webhook para"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhookの送信対象"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送 Webhook 至"
          }
        }
      }
    },
    "The webhook is sent after every transcription, including transcriptions without a workflow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Webhook wird nach jeder Transkription gesendet, auch wenn kein Workflow verwendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El webhook se envía después de cada transcripción, incluidas las transcripciones sin flujo de trabajo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークフローを使用しない場合も含め、すべての文字起こし後にWebhookを送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次转录后都会发送 Webhook，包括没有工作流的转录。"
          }
        }
      }
    },
    "The webhook is sent only for the selected workflows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Webhook wird nur für die ausgewählten Workflows gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El webhook solo se envía para los flujos de trabajo seleccionados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したワークフローに対してのみWebhookを送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对选定的工作流发送 Webhook。"
          }
        }
      }
    },
