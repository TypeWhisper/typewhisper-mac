{
  "sourceLanguage": "en",
  "strings": {
    "Edit %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ bearbeiten"}},"es":{"stringUnit":{"state":"translated","value":"Editar %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@を編集"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑 %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"編輯 %@"}}}},
    "Failed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fehlgeschlagen"}},"es":{"stringUnit":{"state":"translated","value":"Con errores"}},"ja":{"stringUnit":{"state":"translated","value":"失敗"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"失败"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"失敗"}}}},
    "Remove %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ entfernen"}},"es":{"stringUnit":{"state":"translated","value":"Quitar %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@を削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除 %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"移除 %@"}}}},
    "Succeeded": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erfolgreich"}},"es":{"stringUnit":{"state":"translated","value":"Correcto"}},"ja":{"stringUnit":{"state":"translated","value":"成功"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"成功"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"成功"}}}},
    "%@ is not one of the values allowed by the tool schema.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ gehört nicht zu den vom Tool-Schema erlaubten Werten."}},"es":{"stringUnit":{"state":"translated","value":"%@ no es uno de los valores que permite el esquema de la herramienta."}},"ja":{"stringUnit":{"state":"translated","value":"%@ はツールスキーマで許可された値ではありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 不是工具架构允许的值。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 不是工具架構允許的值。"}}}},
    "%@ must be a JSON %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ muss ein JSON-Wert vom Typ %@ sein."}},"es":{"stringUnit":{"state":"translated","value":"%@ debe ser un valor JSON de tipo %@."}},"ja":{"stringUnit":{"state":"translated","value":"%@ は JSON の %@ である必要があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 必须是 JSON %@。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 必須是 JSON %@。"}}}},
    "%@ timed out. The request was not retried.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeitüberschreitung bei %@. Die Anfrage wurde nicht erneut gesendet."}},"es":{"stringUnit":{"state":"translated","value":"Se agotó el tiempo de espera de %@. La solicitud no se reintentó."}},"ja":{"stringUnit":{"state":"translated","value":"%@ がタイムアウトしました。リクエストは再試行されませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 超时。请求未重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 超時。請求未重試。"}}}},
    "%lld actions completed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld Aktionen abgeschlossen."}},"es":{"stringUnit":{"state":"translated","value":"%lld acciones completadas."}},"ja":{"stringUnit":{"state":"translated","value":"%lld 件のアクションが完了しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成 %lld 个操作。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已完成 %lld 個操作。"}}}},
    "%lld of %lld actions completed; failed items: %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld von %lld Aktionen abgeschlossen; fehlgeschlagene Elemente: %@."}},"es":{"stringUnit":{"state":"translated","value":"%lld de %lld acciones completadas; elementos con errores: %@."}},"ja":{"stringUnit":{"state":"translated","value":"%2$lld 件中 %1$lld 件のアクションが完了しました。失敗した項目: %3$@。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成 %2$lld 个操作中的 %1$lld 个；失败项目：%3$@。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已完成 %2$lld 個操作中的 %1$lld 個；失敗項目：%3$@。"}}}},
    "Acknowledge automatic execution of this destructive tool before saving.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bestätige vor dem Speichern die automatische Ausführung dieses destruktiven Tools."}},"es":{"stringUnit":{"state":"translated","value":"Confirma la ejecución automática de esta herramienta destructiva antes de guardar."}},"ja":{"stringUnit":{"state":"translated","value":"保存する前に、この破壊的ツールの自動実行を確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存前请确认自动执行此破坏性工具。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"儲存前請確認自動執行此破壞性工具。"}}}},
    "Acknowledge that TypeWhisper may launch this executable with your user permissions.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bestätige, dass TypeWhisper dieses Programm mit deinen Benutzerrechten starten darf."}},"es":{"stringUnit":{"state":"translated","value":"Confirma que TypeWhisper puede abrir este ejecutable con tus permisos de usuario."}},"ja":{"stringUnit":{"state":"translated","value":"TypeWhisper がユーザー権限でこの実行ファイルを起動することを確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请确认 TypeWhisper 可以使用你的用户权限启动此可执行文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請確認 TypeWhisper 可以使用你的使用者權限啟動此可執行檔案。"}}}},
    "Action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktion"}},"es":{"stringUnit":{"state":"translated","value":"Acción"}},"ja":{"stringUnit":{"state":"translated","value":"アクション"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"操作"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"操作"}}}},
    "Actions": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktionen"}},"es":{"stringUnit":{"state":"translated","value":"Acciones"}},"ja":{"stringUnit":{"state":"translated","value":"アクション"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"操作"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"操作"}}}},
    "Active application URL": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"URL der aktiven App"}},"es":{"stringUnit":{"state":"translated","value":"URL de la app activa"}},"ja":{"stringUnit":{"state":"translated","value":"アクティブなアプリの URL"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前应用 URL"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前應用 URL"}}}},
    "Active application bundle identifier": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bundle-ID der aktiven App"}},"es":{"stringUnit":{"state":"translated","value":"Identificador de paquete de la app activa"}},"ja":{"stringUnit":{"state":"translated","value":"アクティブなアプリのバンドル ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前应用软件包标识符"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前應用軟體包辨識符號"}}}},
    "Active application name": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Name der aktiven App"}},"es":{"stringUnit":{"state":"translated","value":"Nombre de la app activa"}},"ja":{"stringUnit":{"state":"translated","value":"アクティブなアプリ名"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前应用名称"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前應用名稱"}}}},
    "Activity": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktivität"}},"es":{"stringUnit":{"state":"translated","value":"Actividad"}},"ja":{"stringUnit":{"state":"translated","value":"アクティビティ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"活动"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"活動"}}}},
    "Activity summaries never include transcripts, complete arguments, or secret values.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktivitätszusammenfassungen enthalten niemals Transkripte, vollständige Argumente oder geheime Werte."}},"es":{"stringUnit":{"state":"translated","value":"Los resúmenes de actividad nunca incluyen transcripciones, argumentos completos ni valores secretos."}},"ja":{"stringUnit":{"state":"translated","value":"アクティビティの概要に文字起こし、完全な引数、シークレット値は含まれません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"活动摘要绝不包含转录、完整参数或机密值。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"活動摘要絕不包含轉錄、完整參數或機密值。"}}}},
    "Add Action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktion hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Agregar acción"}},"ja":{"stringUnit":{"state":"translated","value":"アクションを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加操作"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增操作"}}}},
    "Add Argument": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argument hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Agregar argumento"}},"ja":{"stringUnit":{"state":"translated","value":"引数を追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加参数"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增參數"}}}},
    "Add Environment Value": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Umgebungswert hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Agregar valor de entorno"}},"ja":{"stringUnit":{"state":"translated","value":"環境変数を追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加环境变量"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增環境變數"}}}},
    "Add MCP Action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Aktion hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Agregar acción MCP"}},"ja":{"stringUnit":{"state":"translated","value":"MCP アクションを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 MCP 操作"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增 MCP 操作"}}}},
    "Add MCP Server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Server hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Agregar servidor MCP"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバーを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 MCP 服务器"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增 MCP 伺服器"}}}},
    "Add MCP action": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Aktion hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Agregar acción MCP"}},"ja":{"stringUnit":{"state":"translated","value":"MCP アクションを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 MCP 操作"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增 MCP 操作"}}}},
    "Add MCP server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Server hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Agregar servidor MCP"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバーを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 MCP 服务器"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增 MCP 伺服器"}}}},
    "Add Server": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Server hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Agregar servidor"}},"ja":{"stringUnit":{"state":"translated","value":"サーバーを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加服务器"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增伺服器"}}}},
    "Add a server before creating an action.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge einen Server hinzu, bevor du eine Aktion erstellst."}},"es":{"stringUnit":{"state":"translated","value":"Agrega un servidor antes de crear una acción."}},"ja":{"stringUnit":{"state":"translated","value":"アクションを作成する前にサーバーを追加してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建操作前请先添加服务器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"建立操作前請先新增伺服器。"}}}},
    "Add a stdio server to discover its tools.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge einen stdio-Server hinzu, um seine Tools zu finden."}},"es":{"stringUnit":{"state":"translated","value":"Agrega un servidor stdio para descubrir sus herramientas."}},"ja":{"stringUnit":{"state":"translated","value":"stdio サーバーを追加してツールを検出します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加 stdio 服务器以发现其工具。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增 stdio 伺服器以發現其工具。"}}}},
    "Add argument": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argument hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Agregar argumento"}},"ja":{"stringUnit":{"state":"translated","value":"引数を追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加参数"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"新增參數"}}}},
    "Add bindings for required arguments: %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge Bindungen für erforderliche Argumente hinzu: %@."}},"es":{"stringUnit":{"state":"translated","value":"Agrega asignaciones para los argumentos obligatorios: %@."}},"ja":{"stringUnit":{"state":"translated","value":"必須引数のバインディングを追加してください: %@。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请为必需参数添加绑定：%@。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請為必需參數新增繫結：%@。"}}}},
    "Argument": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argument"}},"es":{"stringUnit":{"state":"translated","value":"Argumento"}},"ja":{"stringUnit":{"state":"translated","value":"引数"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"參數"}}}},
    "Argument Preview": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argumentvorschau"}},"es":{"stringUnit":{"state":"translated","value":"Vista previa de los argumentos"}},"ja":{"stringUnit":{"state":"translated","value":"引数プレビュー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数预览"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"參數預覽"}}}},
    "Arguments": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Argumente"}},"es":{"stringUnit":{"state":"translated","value":"Argumentos"}},"ja":{"stringUnit":{"state":"translated","value":"引数"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"參數"}}}},
    "Arguments come from runtime JSON.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Argumente stammen zur Laufzeit aus JSON."}},"es":{"stringUnit":{"state":"translated","value":"Los argumentos provienen de JSON en tiempo de ejecución."}},"ja":{"stringUnit":{"state":"translated","value":"引数は実行時の JSON から取得されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"参数来自运行时 JSON。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"參數來自執行時 JSON。"}}}},
    "Authorization": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Autorisierung"}},"es":{"stringUnit":{"state":"translated","value":"Autorización"}},"ja":{"stringUnit":{"state":"translated","value":"承認"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"授权"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"授權"}}}},
    "Automatic Execution": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatische Ausführung"}},"es":{"stringUnit":{"state":"translated","value":"Ejecución automática"}},"ja":{"stringUnit":{"state":"translated","value":"自動実行"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动执行"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自動執行"}}}},
    "Batch raw JSON arguments must use the current batch item.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Unverarbeitete JSON-Argumente im Stapelmodus müssen das aktuelle Stapelelement verwenden."}},"es":{"stringUnit":{"state":"translated","value":"Los argumentos JSON sin procesar del modo por lotes deben usar el elemento actual del lote."}},"ja":{"stringUnit":{"state":"translated","value":"バッチの生 JSON 引数には現在のバッチ項目を使用する必要があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批处理原始 JSON 参数必须使用当前批处理项目。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"批次處理原始 JSON 參數必須使用目前批次處理項目。"}}}},
    "Batch": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Stapel"}},"es":{"stringUnit":{"state":"translated","value":"Lote"}},"ja":{"stringUnit":{"state":"translated","value":"バッチ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批处理"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"批次處理"}}}},
    "Batch mode expects a JSON array, validates all items before the first call, runs at most 100 items sequentially, and never retries writes automatically.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Stapelmodus erwartet ein JSON-Array, validiert alle Elemente vor dem ersten Aufruf, führt höchstens 100 Elemente nacheinander aus und wiederholt Schreibvorgänge nie automatisch."}},"es":{"stringUnit":{"state":"translated","value":"El modo por lotes espera un array JSON, valida todos los elementos antes de la primera llamada, ejecuta como máximo 100 elementos uno tras otro y nunca reintenta automáticamente las escrituras."}},"ja":{"stringUnit":{"state":"translated","value":"バッチモードは JSON 配列を受け取り、最初の呼び出し前に全項目を検証し、最大 100 項目を順番に実行します。書き込みは自動再試行されません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批处理模式需要 JSON 数组，在首次调用前验证所有项目，最多按顺序运行 100 个项目，并且绝不自动重试写入。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"批次處理模式需要 JSON 陣列，在首次呼叫前驗證所有項目，最多按順序執行 100 個項目，並且絕不自動重試寫入。"}}}},
    "Batch mode requires the processed workflow text to be a JSON array.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Stapelmodus erfordert, dass der verarbeitete Workflow-Text ein JSON-Array ist."}},"es":{"stringUnit":{"state":"translated","value":"El modo por lotes requiere que el texto procesado del flujo de trabajo sea un array JSON."}},"ja":{"stringUnit":{"state":"translated","value":"バッチモードでは処理済みワークフローテキストが JSON 配列である必要があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批处理模式要求处理后的工作流文本为 JSON 数组。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"批次處理模式要求處理後的工作流程文字為 JSON 陣列。"}}}},
    "Cancel": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abbrechen"}},"es":{"stringUnit":{"state":"translated","value":"Cancelar"}},"ja":{"stringUnit":{"state":"translated","value":"キャンセル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"取消"}}}},
    "Command": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Befehl"}},"es":{"stringUnit":{"state":"translated","value":"Comando"}},"ja":{"stringUnit":{"state":"translated","value":"コマンド"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"命令"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"命令"}}}},
    "Configure local MCP processes. Commands are launched directly, never through a shell.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Konfiguriere lokale MCP-Prozesse. Befehle werden direkt und nie über eine Shell gestartet."}},"es":{"stringUnit":{"state":"translated","value":"Configura procesos MCP locales. Los comandos se ejecutan directamente, nunca a través de un shell."}},"ja":{"stringUnit":{"state":"translated","value":"ローカル MCP プロセスを設定します。コマンドはシェルを介さず直接起動されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置本地 MCP 进程。命令会直接启动，绝不通过 shell。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"設定本機 MCP 程式。命令會直接啟動，絕不透過 shell。"}}}},
    "Connect & Load Tools": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verbinden & Tools laden"}},"es":{"stringUnit":{"state":"translated","value":"Conectar y cargar herramientas"}},"ja":{"stringUnit":{"state":"translated","value":"接続してツールを読み込む"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接并加载工具"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連線並載入工具"}}}},
    "Connection": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verbindung"}},"es":{"stringUnit":{"state":"translated","value":"Conexión"}},"ja":{"stringUnit":{"state":"translated","value":"接続"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連線"}}}},
    "Connection and action results appear here.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verbindungs- und Aktionsergebnisse erscheinen hier."}},"es":{"stringUnit":{"state":"translated","value":"Aquí aparecen los resultados de las conexiones y las acciones."}},"ja":{"stringUnit":{"state":"translated","value":"接続とアクションの結果がここに表示されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接和操作结果会显示在此处。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連線和操作結果會顯示在此處。"}}}},
    "Could not connect to MCP server ‘%@’: %@. stderr: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verbindung zum MCP-Server „%@“ nicht möglich: %@. stderr: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se pudo conectar con el servidor MCP ‘%@’: %@. stderr: %@"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバー「%@」に接続できませんでした: %@。stderr: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法连接 MCP 服务器“%@”：%@。stderr：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法連線 MCP 伺服器「%@」：%@。stderr：%@"}}}},
    "Could not launch MCP server ‘%@’: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"MCP-Server „%@“ konnte nicht gestartet werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se pudo iniciar el servidor MCP ‘%@’: %@"}},"ja":{"stringUnit":{"state":"translated","value":"MCP サーバー「%@」を起動できませんでした: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法启动 MCP 服务器“%@”：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法啟動 MCP 伺服器「%@」：%@"}}}},
    "Create an action and select it as a workflow Action Target.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erstelle eine Aktion und wähle sie als Aktionsziel eines Workflows aus."}},"es":{"stringUnit":{"state":"translated","value":"Crea una acción y selecciónala como destino de la acción de un flujo de trabajo."}},"ja":{"stringUnit":{"state":"translated","value":"アクションを作成し、ワークフローのアクションターゲットとして選択します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建操作并将其选为工作流操作目标。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"建立操作並將其選為工作流程操作目標。"}}}},
