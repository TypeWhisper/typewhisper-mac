    "Automatically extracts facts, preferences and patterns from your transcriptions using an LLM. Memories are injected into prompt context.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrahiert automatisch Fakten, Präferenzen und Muster aus deinen Transkriptionen per LLM. Erinnerungen werden als Kontext in Prompts eingefügt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LLMを使用して、あなたの転写テキストから事実、好み、パターンを自動的に抽出します。思い出はプロンプトのコンテキストとして挿入されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动 extracts facts, preferences 与 模式 从 你的 transcriptions 使用 an LLM. Memories are injected 到 提示词 上下文."
          }
        }
      }
    },
    "Automatically pauses music and videos while recording and resumes when done. Uses macOS system media controls - may not work with all apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert automatisch Musik und Videos während der Aufnahme und setzt die Wiedergabe fort, wenn fertig. Verwendet macOS-Systemsteuerung - funktioniert möglicherweise nicht mit allen Apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中に自動的に音楽や動画を一時停止し、録音が完了すると再生を再開します。macOSのシステムコントロールを使用 - すべてのアプリで動作するとは限りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动 pauses 音乐 与 视频 而 录音中 与 resumes 当 完成. Uses macOS 系统 媒体 controls - 可能 不 工作 带 全部 应用."
          }
        }
      }
    },
    "Automatically press Enter after inserting text. In chat apps this sends the message, in editors it adds a new line.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drückt nach dem Einfügen automatisch Enter. In Chat-Apps wird die Nachricht gesendet, in Editoren eine neue Zeile eingefügt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "挿入後自動的にEnterを押します。チャットアプリではメッセージが送信され、エディタでは新しい行が挿入されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动 按 Enter 之后 插入中 文本. In chat 应用 这个 发送 的 消息, 在 editors 它 adds a 新建 行."
          }
        }
      }
    },
    "Automatically raises quiet microphone input before transcription. Useful for low-gain microphones, but very noisy rooms may sound louder too.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こし前に小さなマイク入力音量を自動的に上げます。低ゲインのマイクに便利ですが、騒がしい部屋では環境音も大きくなる可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在转录前自动提升较低的麦克风输入音量。对低增益麦克风很有用，但在非常嘈杂的房间中，环境噪音也可能被放大。"
          }
        }
      }
    },
    "Automatically unloads local models from memory after inactivity. It reloads when needed. Does not affect cloud engines.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entlädt lokale Modelle nach Inaktivität automatisch aus dem Arbeitsspeicher. Bei Bedarf werden sie neu geladen. Cloud-Engines sind nicht betroffen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルモデルを不使用時に自動的にメモリからアンロードします。必要に応じて再読み込みされます。クラウドエンジンは影響を受けません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在闲置后自动将本地模型从内存中卸载。需要时会重新加载。不会影响云端引擎。"
          }
        }
      }
    },
