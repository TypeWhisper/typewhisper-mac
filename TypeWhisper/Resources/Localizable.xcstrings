        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型操作正在进行中，请等待完成。"
          }
        }
      }
    },
    "A token is only needed for private or gated models. It is used for this import and is not saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Token ist nur für private oder zugangsbeschränkte Modelle nötig. Es wird für diesen Import verwendet und nicht gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se necesita un token para modelos privados o de acceso restringido. Se usa para esta importación y no se guarda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非公開またはアクセス制限のあるモデルにのみトークンが必要です。このインポートにのみ使用され、保存されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅私有或受限模型需要令牌。令牌仅用于此次导入，不会保存。"
          }
        }
      }
    },
    "Add a model compatible with an installed local engine. The model is checked and loaded before the import completes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Modell für eine installierte lokale Engine hinzu. Das Modell wird vor Abschluss des Imports geprüft und geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega un modelo compatible con un motor local instalado. El modelo se comprueba y se carga antes de que termine la importación."
