    },
    "Imported your existing Codex login.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestehender Codex-Login importiert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のCodexログインがインポートされました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入您现有的 Codex 登录。"
          }
        }
      }
    },
    "Import Codex Login": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex-Login importieren"
          }
        },
        "ja": {
          "stringUnit": {
