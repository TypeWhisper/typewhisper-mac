    "Previously synced correction files are missing or unreadable. Wait for your cloud provider to download them, or choose a new sync folder if the old files were deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuvor synchronisierte Korrekturdateien fehlen oder sind nicht lesbar. Warte, bis dein Cloud-Anbieter sie heruntergeladen hat. Falls die alten Dateien gelöscht wurden, wähle einen neuen Sync-Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltan archivos de corrección sincronizados anteriormente o no se pueden leer. Espera a que tu proveedor en la nube los descargue, o elige una nueva carpeta de sincronización si se eliminaron los archivos antiguos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前に同期した修正ルールのファイルが見つからないか、読み取れません。クラウドサービスによるダウンロードの完了を待ってください。古いファイルを削除した場合は、新しい同期フォルダを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
