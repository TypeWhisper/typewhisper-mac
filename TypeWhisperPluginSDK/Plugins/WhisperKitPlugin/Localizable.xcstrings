    },
    "Local speech-to-text using OpenAI Whisper via CoreML. 99+ languages, streaming, translation to English.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Sprache-zu-Text-Erkennung mit OpenAI Whisper via CoreML. 99+ Sprachen, Streaming, Übersetzung ins Englische."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI Whisperを介してCoreMLでローカルに音声認識を実行。99以上の言語、ストリーミング、英語への翻訳。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 CoreML 使用 OpenAI Whisper 的本地语音转文字。支持 99 种以上语言、流式传输、翻译为英语。"
          }
        }
      }
    },
    "Models": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        }
      }
    },
    "Optional. Increases download rate limits. Free at huggingface.co/settings/tokens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Erhöht Download-Ratenlimits. Kostenlos unter huggingface.co/settings/tokens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション。ダウンロードレート制限を増やす。huggingface.co/settings/tokensで無料で取得可能。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。提高下载速率限制。在 huggingface.co/settings/tokens 免费获取。"
          }
        }
      }
    },
