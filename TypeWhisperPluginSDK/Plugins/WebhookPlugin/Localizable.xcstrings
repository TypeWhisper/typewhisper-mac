    "Add a webhook to send transcription data to external services.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Webhook hinzu, um Transkriptionsdaten an externe Dienste zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un webhook para enviar datos de transcripción a servicios externos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhookを追加して、文字起こしデータを外部サービスに送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Webhook 以将转录数据发送到外部服务。"
          }
        }
      }
    },
