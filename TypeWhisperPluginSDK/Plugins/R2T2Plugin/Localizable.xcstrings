    "The built-in server needs a Mac with Apple silicon. On this Mac, connect to an audio.cpp server you run yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der integrierte Server braucht einen Mac mit Apple Silicon. Verbinde dich auf diesem Mac mit einem audio.cpp-Server, den du selbst betreibst."
          }
        },
        "es": {
          "stringUnit": {
