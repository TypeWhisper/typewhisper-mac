{
  "sourceLanguage": "en",
  "strings": {
    "Auto-unload model is set to Immediate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Modell automatisch entladen“ steht auf „Sofort“."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モデルを自動でアンロード」が「すぐに」に設定されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动卸载模型”已设为“立即”。"
          }
        }
      }
    },
    "Download & Load": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden & Aktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み & 有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并加载"
          }
        }
      }
    },
    "Download and load %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ laden und aktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を読み込んで有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并加载 %@"
          }
        }
      }
    },
    "Error": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误"
          }
        }
      }
    },
    "GigaAM (Russian)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GigaAM (Russisch)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GigaAM（ロシア語）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GigaAM（俄语）"
          }
        }
      }
    },
