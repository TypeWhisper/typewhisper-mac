            "state": "translated",
            "value": "下载并加载 %@"
          }
        }
      }
    },
    "Downloading %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird heruntergeladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargando %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をダウンロード中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载 %@"
          }
        }
      }
    },
    "Enter a Hugging Face repository such as owner/model-GGUF, optionally with a quantization (owner/model-GGUF:Q4_K_M), or a huggingface.co link.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein Hugging-Face-Repository wie owner/model-GGUF ein, optional mit Quantisierung (owner/model-GGUF:Q4_K_M), oder einen huggingface.co-Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un repositorio de Hugging Face como owner/model-GGUF, opcionalmente con una cuantización (owner/model-GGUF:Q4_K_M), o un enlace de huggingface.co."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "owner/model-GGUFのようなHugging Faceリポジトリ（必要に応じて量子化付きでowner/model-GGUF:Q4_K_M）、またはhuggingface.coのリンクを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 Hugging Face 仓库，例如 owner/model-GGUF，可附带量化类型（owner/model-GGUF:Q4_K_M），或输入 huggingface.co 链接。"
          }
        }
      }
    },
    "Error": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误"
          }
        }
      }
    },
    "Experimental": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性"
          }
        }
      }
    },
    "Experimental. A large download that answers more slowly than the smaller models.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell. Ein großer Download, der langsamer antwortet als die kleineren Modelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Una descarga grande que responde más despacio que los modelos más pequeños."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的。ダウンロードサイズが大きく、小さいモデルより応答が遅くなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性。下载体积大，响应速度比较小的模型慢。"
          }
        }
      }
    },
    "Experimental. Reasons before answering, so results take several seconds. LFM Open License: commercial use is free only below USD 10M annual revenue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell. Denkt vor der Antwort nach, daher dauern Ergebnisse einige Sekunden. LFM Open License: Kommerzielle Nutzung ist nur unter 10 Mio. USD Jahresumsatz kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Razona antes de responder, así que los resultados tardan varios segundos. LFM Open License: el uso comercial solo es gratuito con ingresos anuales inferiores a 10 millones de USD."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的。回答前に推論するため、結果が出るまで数秒かかります。LFM Open License：商用利用が無料なのは年間売上1,000万米ドル未満の場合のみです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性。模型会先推理再回答，因此结果需要几秒钟。LFM Open License：仅年收入低于 1000 万美元时可免费商用。"
          }
        }
      }
    },
    "Experimental. Uses less memory than Gemma 4 but translates and restructures text less reliably.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell. Braucht weniger Arbeitsspeicher als Gemma 4, übersetzt und strukturiert Text aber weniger zuverlässig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Usa menos memoria que Gemma 4, pero traduce y reestructura el texto con menos fiabilidad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的。Gemma 4よりメモリ使用量は少ないものの、翻訳やテキストの再構成の精度は下がります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性。比 Gemma 4 占用更少内存，但翻译和重组文本的可靠性较低。"
          }
        }
      }
    },
    "Fastest. Good for cleanup and short texts, less reliable with inline commands and notes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am schnellsten. Gut für Bereinigung und kurze Texte, weniger zuverlässig bei Inline-Befehlen und Notizen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El más rápido. Bueno para limpiar textos cortos, menos fiable con comandos en línea y notas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最速。整形や短い文章に向いていますが、インラインコマンドやメモでは精度が下がります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "速度最快。适合清理和短文本，处理内联命令和笔记时可靠性较低。"
          }
        }
      }
    },
    "File": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        }
      }
    },
    "Find GGUF Files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF-Dateien suchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar archivos GGUF"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUFファイルを検索"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找 GGUF 文件"
          }
        }
      }
    },
    "For this Mac with %lld GB of memory, %@ is recommended. Smaller models respond faster but follow instructions less reliably.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Mac mit %1$lld GB Arbeitsspeicher wird %2$@ empfohlen. Kleinere Modelle antworten schneller, befolgen Anweisungen aber weniger zuverlässig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para este Mac con %1$lld GB de memoria se recomienda %2$@. Los modelos más pequeños responden más rápido, pero siguen las instrucciones con menos fiabilidad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ%1$lld GBのこのMacには%2$@がおすすめです。小さいモデルは応答が速い一方、指示に従う精度が下がります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于这台内存为 %1$lld GB 的 Mac，推荐使用 %2$@。较小的模型响应更快，但遵循指令的可靠性较低。"
          }
        }
      }
    },
    "Generation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Generierung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generación"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成"
          }
        }
      }
    },
    "Hugging Face could not be reached (HTTP %@). Try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face ist nicht erreichbar (HTTP %@). Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a Hugging Face (HTTP %@). Inténtalo de nuevo más tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Faceに接続できませんでした（HTTP %@）。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Hugging Face（HTTP %@）。请稍后重试。"
          }
        }
      }
    },
    "Hugging Face did not grant access to %@. Check the name. For private or gated models, save a token with access in this plugin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face hat keinen Zugriff auf %@ gewährt. Prüfe den Namen. Für private oder zugangsbeschränkte Modelle speichere in diesem Plugin einen Token mit Zugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face no concedió acceso a %@. Comprueba el nombre. Para modelos privados o restringidos, guarda en este plugin un token con acceso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Faceが%@へのアクセスを許可しませんでした。名前を確認してください。非公開またはアクセス制限付きのモデルには、アクセス権のあるトークンをこのプラグインに保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face 未授予对 %@ 的访问权限。请检查名称。对于私有或受限模型，请在此插件中保存具有访问权限的令牌。"
          }
        }
      }
    },
