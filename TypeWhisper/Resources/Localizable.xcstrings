    "Fast cloud AI. Also supports transcription. Requires a free API key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnelle Cloud-KI. Unterstützt auch Transkription. Benötigt einen kostenlosen API-Key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IA en la nube rápida. También admite transcripción. Requiere una clave de API gratuita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高速なクラウドAI。文字起こしもサポート。無料のAPIキーが必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
