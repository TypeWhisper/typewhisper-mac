    "Unload %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deaktivieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberar %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を無効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卸載 %@"
          }
        }
      }
    },
    "A token is only needed for private or gated models. It is used for this import and is not saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Token ist nur für private oder zugangsbeschränkte Modelle nötig. Es wird für diesen Import verwendet und nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se necesita un token para modelos privados o de acceso restringido. Se usa para esta importación y no se guarda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開またはアクセス制限のあるモデルにのみトークンが必要です。このインポートにのみ使用され、保存されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅私有或受限模型需要令牌。令牌仅用于此次导入，不会保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅私有或受限模型需要權杖。權杖僅用於此次匯入，不會儲存。"
          }
        }
      }
    },
    "Add a model compatible with this plugin. The model is checked and loaded before the import completes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein mit diesem Plugin kompatibles Spracherkennungsmodell hinzu. Das Modell wird vor Abschluss des Imports geprüft und geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un modelo compatible con este plugin. El modelo se comprueba y se carga antes de que termine la importación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインに対応したモデルを追加します。インポートが完了する前に、モデルの検証と読み込みが行われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加与此插件兼容的语音识别模型。导入完成前会检查并加载模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增與此外掛相容的語音辨識模型。匯入完成前會檢查並載入模型。"
          }
        }
      }
    },
    "Auto-unload model is set to Immediate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Modell automatisch entladen“ steht auf „Sofort“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Liberar el modelo automáticamente” está en “Inmediato”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モデルを自動でアンロード」が「すぐに」に設定されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动卸载模型”已设为“立即”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動卸載模型」已設為「立即」。"
          }
        }
      }
    },
    "Canary needs an explicit source language. Choose Greek or English for Sophea in Dictation settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary braucht eine konkrete Ausgangssprache. Wähle für Sophea Griechisch oder Englisch in den Diktateinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary necesita un idioma de origen explícito. Elige griego o inglés para Sophea en los ajustes de Dictado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Canaryでは入力言語の指定が必要です。Sopheaを使う場合は、音声入力設定でギリシャ語または英語を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary 需要明确指定源语言。使用 Sophea 时，请在听写设置中选择希腊语或英语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary 需要明確指定來源語言。使用 Sophea 時，請在聽寫設定中選擇希臘語或英語。"
          }
        }
      }
    },
