        }
      }
    },
    "With speaker labels on, dictations are transcribed after the recording instead of streaming.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Sprecherkennzeichnung werden Diktate nach der Aufnahme transkribiert statt gestreamt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con las etiquetas de hablante activadas, los dictados se transcriben tras la grabación en lugar de transmitirse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話者ラベルがオンのとき、音声入力はストリーミングせず録音後に文字起こしします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启说话人标签后，听写会在录音结束后转录，而不是流式传输。"
          }
        }
      }
    },
