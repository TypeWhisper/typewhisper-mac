    "Provider Default omits reasoning. Other values send reasoning: { effort: ... } to /v1/responses.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Anbieterstandard wird reasoning weggelassen. Andere Werte senden reasoning: { effort: ... } an /v1/responses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
