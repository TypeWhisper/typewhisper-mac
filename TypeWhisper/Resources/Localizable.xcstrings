          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」をローカルパックに追加しました。オンにすると、そのエントリが辞書に追加されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
