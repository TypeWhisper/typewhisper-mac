        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0.6B品質が重要である場合に、より高い精度を持つ小さなモデル。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 0.6B 质量重要时的高精度小模型。"
