    "Zoom's model for the dictation language, with dictionary terms. English, German, Spanish, French, Italian, Portuguese, Japanese, Chinese and Arabic. Without a dictation language, Scribe Multilingual detects it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zooms Modell für die Diktiersprache, mit Wörterbuchbegriffen. Englisch, Deutsch, Spanisch, Französisch, Italienisch, Portugiesisch, Japanisch, Chinesisch und Arabisch. Ohne Diktiersprache erkennt Scribe Multilingual die Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de Zoom para el idioma del dictado, con los términos del diccionario. Inglés, alemán, español, francés, italiano, portugués, japonés, chino y árabe. Sin idioma de dictado, Scribe Multilingual lo detecta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力の言語に合わせたZoomのモデルで、辞書の用語を使用します。英語、ドイツ語、スペイン語、フランス語、イタリア語、ポルトガル語、日本語、中国語、アラビア語に対応します。言語が設定されていない場合は、Scribe Multilingualが検出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom 针对听写语言的模型，支持词典术语。支持英语、德语、西班牙语、法语、意大利语、葡萄牙语、日语、中文和阿拉伯语。未设置听写语言时，由 Scribe Multilingual 检测语言。"
          }
        }
      }
    },
    "Zoom's most accurate English model, with dictionary terms. Other languages go to Scribe Multilingual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zooms genauestes englisches Modell, mit Wörterbuchbegriffen. Andere Sprachen gehen an Scribe Multilingual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de inglés más preciso de Zoom, con los términos del diccionario. Los demás idiomas van a Scribe Multilingual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomで最も精度の高い英語モデルで、辞書の用語を使用します。その他の言語はScribe Multilingualで処理されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom 最准确的英语模型，支持词典术语。其他语言交由 Scribe Multilingual 处理。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
