            "state": "translated",
            "value": "替换凭据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "替換憑證"
          }
        }
      }
    },
    "Save Credentials": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten speichern"
          }
        },
        "es": {
