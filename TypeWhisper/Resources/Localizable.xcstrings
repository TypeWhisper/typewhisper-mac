          }
        }
      }
    },
    "Stop recording after silence" : {
      "comment" : "Dictation setting that ends a toggle-mode dictation after the user stops speaking.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahme nach Stille beenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
