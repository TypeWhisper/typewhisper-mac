    "Press Enter during recording to stop, insert the text, and submit. Stopping normally only inserts the text." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presiona Intro durante la grabación para detenerla, insertar el texto y enviarlo. Al detenerla de forma normal solo se inserta el texto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音中にEnterキーを押すと、録音を停止してテキストを挿入し、送信します。通常の停止ではテキストの挿入のみを行います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
