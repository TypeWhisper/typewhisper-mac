    "premium.window.sync.deleteConfirmationMessage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud-Vorgänge werden gelöscht, lokale Wörterbucheinträge und Snippets bleiben auf diesem Mac erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud operations are deleted, but local dictionary entries and snippets stay on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan las operaciones en la nube, pero las entradas locales del diccionario y los fragmentos se quedan en este Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウド上の操作データは削除されますが、ローカルの辞書項目とスニペットはこのMacに残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云端操作记录将被删除，但本地词典条目和文本片段仍会保留在这台 Mac 上。"
          }
        }
      }
    },
