        "de" : { "stringUnit" : { "state" : "translated", "value" : "Sprechererkennung" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "話者分離" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "说话人分离" } }
      }
    },
    "The Foundry model catalog is unavailable for this Speech resource. Built-in MAI models remain available." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Foundry-Modellkatalog ist für diese Speech-Ressource nicht verfügbar. Die integrierte MAI-Modellliste bleibt nutzbar." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このSpeechリソースではFoundryモデルカタログを利用できません。組み込みのMAIモデルは引き続き利用できます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 Speech 资源无法使用 Foundry 模型目录。内置 MAI 模型仍可使用。" } }
