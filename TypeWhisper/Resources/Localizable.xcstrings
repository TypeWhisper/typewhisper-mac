    },
    "Using automatic recording with Premium? Calendars can now ask before recording events without other attendees." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du nutzt automatische Aufnahmen mit Premium? Unter Kalender kannst du jetzt festlegen, dass vor Terminen ohne weitere Teilnehmer nachgefragt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Usas la grabación automática con Premium? Ahora Calendarios puede preguntar antes de grabar eventos sin otros asistentes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premiumの自動録音をお使いですか？「カレンダー」で、他の参加者がいない予定を録音する前に確認するよう設定できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
