# Mac App Store edition screenshots.
#
# Captures the App Store edition (APPSTORE build of TypeWhisperAppStore.xcodeproj)
# in screenshot mode, using the deterministic fixtures and window handling of
# the regular screenshot lane. Raw window captures are written to
# fastlane/screenshots/appstore/<language>/<state>.png and composed into store
# images by scripts/appstore/compose_store_screenshots.rb.

APPSTORE_SCREENSHOT_DERIVED_DATA = File.join(REPOSITORY_ROOT, "build", "appstore-screenshots")
APPSTORE_SCREENSHOT_PRODUCT = "TypeWhisper App Store Dev"
APPSTORE_SCREENSHOT_APP_PATH = File.join(
  APPSTORE_SCREENSHOT_DERIVED_DATA, "Build", "Products", "Debug", "#{APPSTORE_SCREENSHOT_PRODUCT}.app"
)
APPSTORE_SCREENSHOT_BUNDLE_ID = "com.typewhisper.typewhisper-app.screenshots"
APPSTORE_SCREENSHOT_OUTPUT = File.join(SCREENSHOT_OUTPUT, "appstore")
# Settings states that exist in the App Store edition. The license page is
# replaced by the Premium page there.
APPSTORE_SCREENSHOT_STATES = %w[
  home
  indicator
  recording
  workflows
  dictionary
  history
  statistics
  integrations-available
  hotkeys
  snippets
  file-transcription
  premium
].freeze

def appstore_screenshot_states(value)
  requested = value.to_s.split(",").map(&:strip).reject(&:empty?)
  return APPSTORE_SCREENSHOT_STATES if requested.empty?

  unsupported = requested - APPSTORE_SCREENSHOT_STATES
  UI.user_error!("Unsupported App Store screenshot states: #{unsupported.join(', ')}") unless unsupported.empty?
  requested
end

def build_appstore_screenshot_app!
  sh(Shellwords.escape(File.join(REPOSITORY_ROOT, "scripts", "appstore", "generate_project.sh")))
  sh(Shellwords.join([
    "xcodebuild",
    "-project", File.join(REPOSITORY_ROOT, "TypeWhisperAppStore.xcodeproj"),
    "-scheme", "TypeWhisperAppStore",
    "-configuration", "Debug",
    "-derivedDataPath", APPSTORE_SCREENSHOT_DERIVED_DATA,
    "-destination", "platform=macOS,arch=#{screenshot_hardware_architecture}",
    "-skipPackagePluginValidation",
    "-skipMacroValidation",
    "CODE_SIGN_IDENTITY=-",
    "CODE_SIGN_STYLE=Manual",
    "CODE_SIGNING_REQUIRED=YES",
    "CODE_SIGNING_ALLOWED=YES",
    "CODE_SIGN_ENTITLEMENTS=",
    # Screenshot runs write a readiness marker into a temporary folder.
    "ENABLE_APP_SANDBOX=NO",
    "PROVISIONING_PROFILE_SPECIFIER=",
    "COMPILER_INDEX_STORE_ENABLE=NO",
    "build",
  ]))

  UI.user_error!("Missing screenshot app: #{APPSTORE_SCREENSHOT_APP_PATH}") unless File.directory?(APPSTORE_SCREENSHOT_APP_PATH)
  info_plist = File.join(APPSTORE_SCREENSHOT_APP_PATH, "Contents", "Info.plist")
  sh(
    "/usr/libexec/PlistBuddy -c #{Shellwords.escape("Set :CFBundleIdentifier #{APPSTORE_SCREENSHOT_BUNDLE_ID}")} #{Shellwords.escape(info_plist)}",
    log: false
  )
  sh(
    "/usr/bin/codesign --force --sign - --preserve-metadata=entitlements,requirements,flags #{Shellwords.escape(APPSTORE_SCREENSHOT_APP_PATH)}",
    log: false
  )
end

def reset_appstore_screenshot_defaults!
  system("/usr/bin/defaults", "delete", APPSTORE_SCREENSHOT_BUNDLE_ID, out: File::NULL, err: File::NULL)
end

def capture_appstore_screenshot!(language, state, destination)
  executable = File.join(APPSTORE_SCREENSHOT_APP_PATH, "Contents", "MacOS", APPSTORE_SCREENSHOT_PRODUCT)
  reset_appstore_screenshot_defaults!

  Dir.mktmpdir("typewhisper-appstore-screenshot") do |run_directory|
    ready_file = File.join(run_directory, "window-ready.txt")
    log_file = File.join(run_directory, "application.log")
    home_directory = File.join(run_directory, "home")
    FileUtils.mkdir_p(home_directory)

    environment = {
      "CFFIXED_USER_HOME" => home_directory,
      "NSUnbufferedIO" => "YES",
    }
    log = File.open(log_file, "w")
    process_id = Process.spawn(
      environment,
      executable,
      *screenshot_launch_arguments(language, state, "free", ready_file),
      chdir: REPOSITORY_ROOT,
      out: log,
      err: log
    )
    log.close

    begin
      window_id = wait_for_screenshot_window!(ready_file, process_id, log_file)
      sh("/usr/sbin/screencapture -x -l #{window_id} #{Shellwords.escape(destination)}", log: false)
      unless File.file?(destination) && File.size(destination) > 100_000
        UI.user_error!("Screenshot capture did not produce a valid PNG: #{destination}")
      end
    ensure
      stop_screenshot_app(process_id)
      reset_appstore_screenshot_defaults!
      FileUtils.rm_rf(File.join(Dir.tmpdir, "TypeWhisper-Screenshots-#{process_id}"))
    end
  end
end

# Localized store text of the macOS version. Name, subtitle and privacy URL are
# app-level fields shared with the iOS app and stay in the iOS repository.
APPSTORE_APP_IDENTIFIER = "com.typewhisper.typewhisper-app"
APPSTORE_APP_ID = "6759319267"
APPSTORE_METADATA_PATH = File.join(FASTLANE_DIRECTORY, "appstore-metadata")
APPSTORE_STORE_LOCALES = %w[en-US de-DE fr-FR it es-ES].freeze
APPSTORE_VERSION_FIELDS = {
  "description" => { attribute: :description, limit: 4_000 },
  "keywords" => { attribute: :keywords, limit: 100 },
  "promotional_text" => { attribute: :promotional_text, limit: 170 },
  "marketing_url" => { attribute: :marketing_url },
  "support_url" => { attribute: :support_url },
}.freeze
APPSTORE_EDITABLE_VERSION_STATES = %w[
  PREPARE_FOR_SUBMISSION
  DEVELOPER_REJECTED
  METADATA_REJECTED
  REJECTED
].freeze

def appstore_metadata_value(locale, field)
  path = File.join(APPSTORE_METADATA_PATH, locale, "#{field}.txt")
  UI.user_error!("Missing metadata file #{path}") unless File.file?(path)
  File.read(path).strip
end

def appstore_review_notes
  File.read(File.join(APPSTORE_METADATA_PATH, "review_information", "notes.txt")).strip
end

def validate_appstore_metadata!
  APPSTORE_STORE_LOCALES.each do |locale|
    APPSTORE_VERSION_FIELDS.each do |field, spec|
      value = appstore_metadata_value(locale, field)
      UI.user_error!("#{locale}/#{field}.txt is empty") if value.empty?
      if spec[:limit] && value.length > spec[:limit]
        UI.user_error!("#{locale}/#{field}.txt has #{value.length} characters (limit #{spec[:limit]})")
      end
    end
    %w[name subtitle privacy_url release_notes].each do |field|
      path = File.join(APPSTORE_METADATA_PATH, locale, "#{field}.txt")
      UI.user_error!("#{path} must not exist: it is shared with the iOS app") if File.exist?(path)
    end
  end
  notes = appstore_review_notes
  UI.user_error!("Review notes have #{notes.length} characters (limit 4000)") if notes.length > 4_000
end

def appstore_api_key!
  api_key_path = ENV["ASC_API_KEY_PATH"].to_s
  UI.user_error!("Set ASC_API_KEY_PATH to the App Store Connect API key JSON") if api_key_path.empty?
  api_key = JSON.parse(File.read(File.expand_path(api_key_path)))
  app_store_connect_api_key(
    key_id: api_key.fetch("key_id"),
    issuer_id: api_key["issuer_id"],
    key_content: api_key.fetch("key"),
    duration: 1_200,
    in_house: api_key.fetch("in_house", false),
    set_spaceship_token: true
  )
end

def editable_mac_store_version!(version_string)
  app = Spaceship::ConnectAPI::App.find(APPSTORE_APP_IDENTIFIER)
  UI.user_error!("App #{APPSTORE_APP_IDENTIFIER} was not found") unless app
  UI.user_error!("Unexpected App Store app ID #{app.id}") unless app.id.to_s == APPSTORE_APP_ID

  version = app.get_app_store_versions(filter: { platform: "MAC_OS" })
    .find { |candidate| candidate.version_string == version_string }
  UI.user_error!("macOS App Store version #{version_string} was not found") unless version

  state = version.app_version_state || version.app_store_state
  unless APPSTORE_EDITABLE_VERSION_STATES.include?(state)
    UI.user_error!("macOS App Store version #{version_string} is not editable (state: #{state || 'unknown'})")
  end
  version
end

def verify_mac_store_metadata!(version)
  localizations = version.get_app_store_version_localizations.to_h { |entry| [entry.locale, entry] }
  APPSTORE_STORE_LOCALES.each do |locale|
    localization = localizations[locale]
    UI.user_error!("Missing remote version locale #{locale}") unless localization
    APPSTORE_VERSION_FIELDS.each do |field, spec|
      actual = localization.public_send(spec[:attribute]).to_s.strip
      UI.user_error!("#{locale} #{field} differs in App Store Connect") unless actual == appstore_metadata_value(locale, field)
    end
  end
  notes = version.fetch_app_store_review_detail&.notes.to_s.strip
  UI.user_error!("Review notes differ in App Store Connect") unless notes == appstore_review_notes
  UI.success("Verified macOS #{version.version_string} store text in #{APPSTORE_STORE_LOCALES.count} locales and the review notes")
end

platform :mac do
  desc "Upload the localized macOS store text and review notes (no binary, no screenshots), then verify them"
  lane :appstore_metadata_upload do |options|
    version_string = options[:version].to_s
    UI.user_error!("Pass version:<version>") if version_string.empty?
    validate_appstore_metadata!
    appstore_api_key!
    editable_mac_store_version!(version_string)

    deliver(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      app_identifier: APPSTORE_APP_IDENTIFIER,
      app_version: version_string,
      platform: "osx",
      metadata_path: APPSTORE_METADATA_PATH,
      app_review_information: { notes: appstore_review_notes },
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      edit_live: false,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )

    verify_mac_store_metadata!(editable_mac_store_version!(version_string))
  end

  desc "Compare the macOS store text and review notes in App Store Connect with the repository"
  lane :appstore_metadata_verify do |options|
    version_string = options[:version].to_s
    UI.user_error!("Pass version:<version>") if version_string.empty?
    validate_appstore_metadata!
    appstore_api_key!
    verify_mac_store_metadata!(editable_mac_store_version!(version_string))
  end

  desc "Capture the Mac App Store edition in screenshot mode (raw window images)"
  lane :appstore_screenshots do |options|
    languages = selected_screenshot_languages(options[:languages])
    states = appstore_screenshot_states(options[:states])
    build_appstore_screenshot_app! unless options[:skip_build]
    languages.each do |language|
      directory = File.join(APPSTORE_SCREENSHOT_OUTPUT, language)
      FileUtils.mkdir_p(directory)
      states.each do |state|
        UI.message("Capturing #{language} #{state}")
        capture_appstore_screenshot!(language, state, File.join(directory, "#{state}.png"))
      end
    end
  end
end
