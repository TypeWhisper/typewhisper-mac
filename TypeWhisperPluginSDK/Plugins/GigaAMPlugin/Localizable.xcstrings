        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション。ダウンロードレート制限を引き上げます。huggingface.co/settings/tokensで無料で取得可能です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。提高下载速率限制。在 huggingface.co/settings/tokens 免费获取。"
