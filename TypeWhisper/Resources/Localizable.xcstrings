    "These plugins could not be updated: %@. Successful updates remain installed. TypeWhisper was not restarted." : {
      "comment" : "An alert message listing failed plugin updates and explaining why the app did not restart. The argument is a comma-separated list of plugin names.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Plugins konnten nicht aktualisiert werden: %1$@. Erfolgreiche Updates bleiben installiert. TypeWhisper wurde nicht neu gestartet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron actualizar estos plugins: %@. Las actualizaciones correctas siguen instaladas. TypeWhisper no se reinició."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のプラグインを更新できませんでした：%1$@。成功した更新はインストールされたままです。TypeWhisperは再起動されませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下插件无法更新：%1$@。成功的更新仍保持已安装状态。TypeWhisper 未重新启动。"
          }
        }
      }
    },
    "This engine avoids repeated live API calls and transcribes the full recording after you stop." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este motor evita llamadas repetidas a la API en vivo y transcribe la grabación completa cuando te detienes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンはライブAPI呼び出しの繰り返しを避け、停止後に録音全体を文字起こします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎避免重复的实时 API 调用，在你停止后对完整录音进行一次性转录。"
          }
        }
      }
    },
    "This engine currently uses Dictionary Corrections only." : {
      "comment" : "Text displayed in a detail label for a dictionary engine that currently uses only dictionary corrections.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ahora, este motor solo usa las correcciones del diccionario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンは現在、辞書修正のみを使用しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎当前仅使用“词典纠正”功能。"
          }
        }
      }
    },
    "This engine does not support multiple language hints. It will use #1 as the spoken language. The Language Detection plugin can pick the one you speak instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Engine unterstützt keine mehreren Sprachhinweise. Sie verwendet Nr. 1 als gesprochene Sprache. Das Plugin „Language Detection“ kann stattdessen die Sprache wählen, die du sprichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este motor no admite varias sugerencias de idioma. Usará el n.º 1 como idioma hablado. El plugin Language Detection puede elegir en su lugar el idioma que hablas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンは複数の言語ヒントに対応していません。1番目を話す言語として使います。Language Detection プラグインを使うと、代わりに話している言語を選べます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎不支持多语言提示，将使用列表中的第一种语言作为口语。Language Detection 插件可以改为选择你正在说的语言。"
          }
        }
      }
    },
    "This engine cannot detect the language itself. The Language Detection plugin picks it from the engine's languages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Engine erkennt die Sprache nicht selbst. Das Plugin „Language Detection“ wählt sie aus den Sprachen der Engine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este motor no detecta el idioma por sí mismo. El plugin Language Detection lo elige entre los idiomas del motor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンは言語を自動で判別できません。Language Detection プラグインがエンジンの対応言語から選びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎无法自行识别语言。Language Detection 插件会从该引擎支持的语言中进行选择。"
          }
        }
      }
    },
    "This engine cannot detect the language itself. It uses the first of your preferred macOS languages it supports. Select its language, or enable the Language Detection plugin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Engine erkennt die Sprache nicht selbst. Sie verwendet die erste deiner bevorzugten macOS-Sprachen, die sie unterstützt. Wähle ihre Sprache aus oder aktiviere das Plugin „Language Detection“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este motor no detecta el idioma por sí mismo. Usa el primero de tus idiomas preferidos de macOS que admita. Selecciona su idioma o activa el plugin Language Detection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンは言語を自動で判別できません。macOS の優先する言語のうち、対応している最初の言語を使います。言語を選択するか、Language Detection プラグインを有効にしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此引擎无法自行识别语言。它会使用你的 macOS 偏好语言中第一个受支持的语言。请选择其语言，或启用 Language Detection 插件。"
          }
        }
      }
    },
    "This engine cannot detect the language itself. The Language Detection plugin picks it from the engine's languages. When the plugin is unsure, the engine uses the first of your preferred macOS languages it supports." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Engine erkennt die Sprache nicht selbst. Das Plugin „Language Detection“ wählt sie aus den Sprachen der Engine. Ist das Plugin unsicher, verwendet die Engine die erste deiner bevorzugten macOS-Sprachen, die sie unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este motor no detecta el idioma por sí mismo. El plugin Language Detection lo elige entre los idiomas del motor. Si el plugin no está seguro, el motor usa el primero de tus idiomas preferidos de macOS que admita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンは言語を自動で判別できません。Language Detection プラグインがエンジンの対応言語から選びます。プラグインが判断できない場合は、macOS の優先する言語のうち、エンジンが対応している最初の言語を使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
