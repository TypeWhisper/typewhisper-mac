    "The first language is the default. Drag to reorder; the voice bar uses this order.": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"第一个是默认目标语言。拖动可以调整顺序，语音条上按这个顺序显示。"}}}},
    "Translation failed. What you said was inserted.": {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译失败，已插入原话"}}}},
    "translation.failed.inserted": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation failed. What you said was inserted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译失败，已插入原话"}}}},
    "translation.retry.replaced": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation replaced what you said."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已用译文替换原话。"}}}},
    "translation.retry.copied": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Replacement could not be verified. Translation copied; check the target before pasting."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法确认替换位置，译文已复制；粘贴前请检查目标位置。"}}}},
